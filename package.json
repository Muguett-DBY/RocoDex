{
  "name": "custard-web-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local-production.ps1",
    "stop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-local-next.ps1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:architecture": "vitest run src/sites/site-boundaries.test.ts",
    "test:personal": "vitest run src/sites/personal-homepage src/sites/shared src/app/robots.txt src/app/sitemap.xml",
    "test:e2e:personal": "playwright test e2e/personal-homepage.spec.ts",
    "test:e2e:rocodex": "playwright test e2e/rocodex.spec.ts",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify:personal-bundle": "node scripts/verify-personal-bundle.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:personal-bundle",
    "verify:live-registration": "node --experimental-strip-types scripts/verify-live-registration.mts",
    "ci:local": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& './scripts/stop-local-next.ps1'; npm ci\""
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@upstash/redis": "^1.38.1",
    "animejs": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.182.0",
    "eslint": "10.8.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
