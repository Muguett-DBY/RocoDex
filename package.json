{
  "name": "custard-web-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "content:generate": "tsx scripts/generate-cstd-content.ts",
    "content:check": "tsx scripts/generate-cstd-content.ts --check",
    "cstd:new-case": "tsx scripts/cstd-content-cli.mts new-case",
    "cstd:new-note": "tsx scripts/cstd-content-cli.mts new-note",
    "cstd:verify-proof": "tsx scripts/cstd-content-cli.mts verify-proof",
    "cstd:content-health": "tsx scripts/cstd-content-cli.mts content-health",
    "cstd:snapshot": "tsx scripts/cstd-content-cli.mts snapshot",
    "cstd:release-brief": "tsx scripts/cstd-content-cli.mts release-brief",
    "cstd:release-candidate": "tsx scripts/cstd-content-cli.mts release-candidate",
    "predev": "npm run content:generate",
    "dev": "next dev",
    "prebuild": "npm run content:generate",
    "build": "next build",
    "postbuild": "npm run verify:cstd:performance-contract && npm run verify:personal-bundle",
    "start": "next start",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local-production.ps1",
    "stop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-local-next.ps1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:architecture": "vitest run src/sites/site-boundaries.test.ts",
    "test:host": "vitest run src/sites/site-boundaries.test.ts src/sites/personal-homepage/infrastructure/routing.test.ts src/app/robots.txt/route.test.ts src/app/sitemap.xml/route.test.ts",
    "test:personal": "vitest run src/sites/personal-homepage src/sites/shared src/app/robots.txt src/app/sitemap.xml",
    "test:e2e:personal": "playwright test personal-homepage personal-archive",
    "test:e2e:rocodex": "playwright test e2e/rocodex.spec.ts",
    "capture:cstd:themes": "node scripts/capture-cstd-theme-gallery.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify:personal-bundle": "node scripts/verify-personal-bundle.mjs",
    "verify:cstd:performance-contract": "node scripts/verify-cstd-performance-contract.mjs",
    "verify:cstd": "npm run content:check && npm run cstd:verify-proof && npm run test:personal && npm run lint && npm run typecheck && npm run build",
    "verify:cstd:release": "npm run verify:cstd && npm run test:e2e:personal",
    "verify": "npm run content:check && npm run cstd:verify-proof && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:personal-bundle",
    "verify:live-registration": "node --experimental-strip-types scripts/verify-live-registration.mts",
    "verify:live:cstd": "node scripts/verify-cstd-production.mjs",
    "ci:local": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& './scripts/stop-local-next.ps1'; npm ci\""
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@upstash/redis": "^1.38.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.2",
    "tailwind-merge": "^3.6.0",
    "three": "0.182.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.182.0",
    "eslint": "10.8.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
