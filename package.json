    "next-auth": "5.0.0-beta.32",
    "postprocessing": "^6.39.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.5.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
