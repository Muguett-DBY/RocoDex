24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-moon h-4 w-4\" aria-hidden=\"true\"><path d=\"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-site-navigation\" aria-label=\"打开主导航\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></div></header><nav aria-label=\"当前站点位置\" class=\"border-b border-slate-200/80 bg-white/70 dark:border-slate-800 dark:bg-slate-950/80\"><div class=\"mx-auto flex max-w-7xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between lg:px-8\"><div class=\"flex min-w-0 items-start gap-3\"><span class=\"mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100 dark:bg-emerald-950/50 dark:text-emerald-300 dark:ring-emerald-900\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-compass h-4 w-4\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z\"></path></svg></span><div class=\"min-w-0\"><p class=\"truncate text-sm font-semibold text-slate-950 dark:text-white\">关于</p><p class=\"text-xs leading-5 text-slate-600 dark:text-slate-400\">了解 RocoDex 的项目定位、数据边界和维护方式。</p></div></div><div class=\"flex min-w-0 flex-wrap items-center gap-2 sm:justify-end\"><a class=\"inline-flex min-h-11 items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-emerald-200 hover:text-slate-950 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-emerald-800 dark:hover:text-white\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-house h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"></path><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg>首页</a><a class=\"inline-flex min-h-11 items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-emerald-200 hover:text-slate-950 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-emerald-800 dark:hover:text-white\" href=\"/data-status\">数据状态<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex min-h-11 items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-emerald-200 hover:text-slate-950 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-emerald-800 dark:hover:text-white\" href=\"/creatures\">精灵列表<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></nav><main class=\"mx-auto max-w-5xl px-4 py-8 lg:px-8\"><span class=\"inline-flex items-center rounded-md border px-2 py-1 text-xs font-medium border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-950 dark:text-rose-300\">非官方声明</span><h1 class=\"mt-4 text-3xl font-bold tracking-tight text-slate-950\">关于洛克图鉴</h1><div class=\"mt-6 grid gap-5\"><div class=\"rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800\"><div class=\"p-5 pb-3\"><h3 class=\"text-lg font-semibold text-slate-950\">项目说明</h3></div><div class=\"p-5 pt-2 space-y-4 text-sm leading-7 text-slate-700\"><p>RocoDex / 洛克图鉴是一个用于学习、研究和个人资料整理的中文图鉴网站 MVP，目标是把《洛克王国世界》的精灵资料整理成易搜索、易筛选、可校对的数据结构。</p><p>第一版只使用本地 TypeScript seed data，不接入 Supabase，不提供登录、收藏或商业功能。</p></div></div><div class=\"rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800\"><div class=\"p-5 pb-3\"><h3 class=\"text-lg font-semibold text-slate-950\">版权与非官方说明</h3></div><div class=\"p-5 pt-2 space-y-4 text-sm leading-7 text-slate-700\"><p>本项目不是《洛克王国》或《洛克王国世界》的官方网站，也不隶属于腾讯、魔方工作室群、哔哩哔哩或任何官方运营方。</p><p>游戏名称、角色、精灵设定、图片与相关素材的权利归原权利方所有。本项目仅用于学习、研究和资料整理；如有侵权内容，后续应替换或移除。</p><p>当前 MVP 不下载、不热链公开网页图片，仅用统一占位图，并在数据中记录来源页面便于后续人工校对。</p></div></div><div class=\"rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800\"><div class=\"p-5 pb-3\"><h3 class=\"text-lg font-semibold text-slate-950\">数据来源</h3></div><div class=\"p-5 pt-2 space-y-4 text-sm leading-7 text-slate-700\"><a href=\"https://wiki.biligame.com/rocom/%E7%B2%BE%E7%81%B5%E5%9B%BE%E9%89%B4\" target=\"_blank\" rel=\"noreferrer\" class=\"inline-flex items-center gap-2 font-semibold text-emerald-700 hover:text-emerald-800\">洛克王国:手游WIKI_BWIKI 精灵图鉴 <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a><p>BWiki 页面标注文字与数据内容采用 CC BY-NC-SA 4.0。RocoDex 记录来源 URL，并对未完成核验的字段标记“待确认”。</p></div></div></div></main></div><!--$--><!--/$--></div><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n4:I[43412,[\\\"/_next/static/chunks/3-71nkw6apgvf.js\\\"],\\\"AuthProvider\\\"]\\n5:I[3020,[\\\"/_next/static/chunks/3-71nkw6apgvf.js\\\",\\\"/_next/static/chunks/3sk5h63r3-vvj.js\\\",\\\"/_next/static/chunks/3ruzslh5b0d3z.js\\\"],\\\"SiteHeader\\\"]\\n6:I[46695,[\\\"/_next/static/chunks/3-71nkw6apgvf.js\\\",\\\"/_next/static/chunks/3sk5h63r3-vvj.js\\\",\\\"/_next/static/chunks/3ruzslh5b0d3z.js\\\"],\\\"SiteContextBar\\\"]\\n7:I[22016,[\\\"/_next/static/chunks/3-71nkw6apgvf.js\\\",\\\"/_next/static/chunks/3sk5h63r3-vvj.js\\\",\\\"/_next/static/chunks/3ruzslh5b0d3z.js\\\"],\\\"\\\"]\\n8:I[5014,[\\\"/_next/static/chunks/3-71nkw6apgvf.js\\\",\\\"/_next/static/chunks/3sk5h63r3-vvj.js\\\",\\\"/_next/static/chunks/3ruzslh5b0d3z.js\\\"],\\\"default\\\"]\\n9:I[60528,[\\\"/_next/static/chunks/3-71nkw6apgvf.js\\\"],\\\"VercelObservability\\\"]\\n12:I[68027,[],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2_m