3b6] transition-colors hover:border-[#24e0ff] hover:text-[#24e0ff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#24e0ff]\",\"children\":[\"$\",\"$Ld\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$f:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]}]]}]]}]]}]\n3a:[\"$\",\"$L44\",null,{\"chains\":[{\"id\":\"rocodex\",\"title\":\"RocoDex 双站平台\",\"kicker\":\"领域边界 / 内容产品\",\"summary\":\"个人主站和 RocoDex 共用一个 Next.js 部署，但域名、认证、内容模块和回归测试各自负责，互不越界。\",\"caseHref\":\"/work/rocodex-platform\",\"liveHref\":\"https://rocodex.custard.top\",\"coverageScore\":100,\"artifactCount\":7,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"问题\",\"title\":\"同一个容器，两个产品\",\"detail\":\"个人主站与图鉴共享 Next.js，却拥有完全不同的用户、路由和运行时。\",\"signal\":\"边界不能只存在于目录名\"},{\"id\":\"decision\",\"label\":\"取舍\",\"title\":\"让测试成为墙\",\"detail\":\"导入扫描和双站 E2E 把口头约定变成不可绕过的回归门禁。\",\"signal\":\"失败必须在 CI 暴露\"},{\"id\":\"system\",\"label\":\"系统\",\"title\":\"三层隔离契约\",\"detail\":\"Proxy、route group 与最小 public API 共同表达所有权。\",\"signal\":\"路由、模块、认证同时隔离\"},{\"id\":\"verification\",\"label\":\"验证\",\"title\":\"两个域名同时验收\",\"detail\":\"每次发布同时核验 GitHub Actions、Vercel 与两个生产域名。\",\"signal\":\"共享部署，不共享风险\"}]},{\"id\":\"crm\",\"title\":\"CFZZS 招商 CRM\",\"kicker\":\"业务系统 / 权限与并发\",\"summary\":\"给产业园区招商团队用的一套线索工作台：从企业查重、阶段推进到空间资源和导出，关键状态都能追溯。\",\"caseHref\":\"/work/cfzzs-crm\",\"liveHref\":\"https://cfzzs.custard.top\",\"coverageScore\":80,\"artifactCount\":3,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"问题\",\"title\":\"业务真相散落在表格里\",\"detail\":\"线索、企业、空间与跟进记录彼此脱节，状态无法被团队共同相信。\",\"signal\":\"问题不是缺页面，而是缺一致状态\"},{\"id\":\"decision\",\"label\":\"取舍\",\"title\":\"冲突不再静默覆盖\",\"detail\":\"乐观锁在写入前比较版本，冲突回到用户而不是篡改事实。\",\"signal\":\"409 是保护，不是故障\"},{\"id\":\"system\",\"label\":\"系统\",\"title\":\"把流程写成状态机\",\"detail\":\"明确阶段转换、查重规则、空间占用与审计事件，让接口与界面共享同一契约。\",\"signal\":\"每次流转都可解释\"},{\"id\":\"verification\",\"label\":\"验证\",\"title\":\"按真实角色验收\",\"detail\":\"浏览器测试覆盖登录、创建、流转、查重、导出和权限边界。\",\"signal\":\"业务故事完整通过\"}]},{\"id\":\"alpha\",\"title\":\"CSTD Alpha 研究系统\",\"kicker\":\"证据管线 / 决策工作台\",\"summary\":\"把“问一句出一篇报告”拆成可回看的研究流程：来源、异步任务、估值版本和反证条件都跟着结果保存。\",\"caseHref\":\"/work/alpha-research-system\",\"liveHref\":\"https://alpha.custard.top\",\"coverageScore\":80,\"artifactCount\":5,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"问题\",\"title\":\"流畅回答不等于可靠研究\",\"detail\":\"没有来源寿命、任务状态和反证条件的文本，无法支撑长期决策。\",\"signal\":\"回答长度不是质量指标\"},{\"id\":\"decision\",\"label\":\"取舍\",\"title\":\"先指纹，再调用模型\",\"detail\":\"证据集先被规范化和指纹化；没有变化时复用结果，有变化时创建新版本。\",\"signal\":\"模型成本服从证据变化\"},{\"id\":\"system\",\"label\":\"系统\",\"title\":\"估值版本不可变\",\"detail\":\"确定性计算、AI 解释、来源与反证条件共同绑定到同一个研究快照。\",\"signal\":\"每个结论都能回到输入\"},{\"id\":\"verification\",\"label\":\"验证\",\"title\":\"研究链路可重放\",\"detail\":\"Agent Replay、测试与生产检查共同证明收集、排队、综合和发布行为。\",\"signal\":\"公开证据约束公开回答\"}]}],\"locale\":\"zh\"}]\n3b:[\"$\",\"div\",null,{\"data-cstd-proof-footer\":true,\"className\":\"mt-9 flex flex-wrap items-center justify-between gap-5 border-t pt-5 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"span\",null,{\"children\":[7,\" \",\"个已发布案例\",\" / \",31,\" \",\"项公开证据\"]}],[\"$\",\"div\",null,{\"className\":\"flex gap-6\",\"children\":[[\"$\",\"$L19\",null,{\"data-cstd-proof-footer-link\":\"primary\",\"href\":\"/work\",\"children\":\"全部案例\"}],[\"$\",\"$L19\",null,{\"data-cstd-proof-footer-link\":\"secondary\",\"href\":\"/proof.json\",\"children\":\"PROOF.JSON\"}]]}]]}]\n3c:[\"$\",\"section\",null,{\"data-cstd-chapter\":\"operator\",\"data-cstd-evidence-subchapter\":true,\"data-cstd-executable-evidence\":true,\"data-cstd-home-replay\":\"alpha-race\",\"aria-labelledby\":\"executable-evidence-heading\",\"className\":\"relative z-20 border-b border-white/10 bg-[#050709] px-5