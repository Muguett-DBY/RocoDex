\"aria-hidden\":\"true\"}]}]]}]]}]]}]\n3f:[\"$\",\"$L49\",null,{\"chains\":[{\"id\":\"rocodex\",\"title\":\"RocoDex 双站平台\",\"kicker\":\"领域边界 / 内容产品\",\"summary\":\"个人主站和 RocoDex 共用一个 Next.js 部署，但域名、认证、内容模块和回归测试各自负责，互不越界。\",\"caseHref\":\"/work/rocodex-platform\",\"liveHref\":\"https://rocodex.custard.top\",\"coverageScore\":100,\"artifactCount\":7,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"问题\",\"title\":\"同一个容器，两个产品\",\"detail\":\"个人主站与图鉴共享 Next.js，却拥有完全不同的用户、路由和运行时。\",\"signal\":\"边界不能只存在于目录名\"},{\"id\":\"decision\",\"label\":\"取舍\",\"title\":\"让测试成为墙\",\"detail\":\"导入扫描和双站 E2E 把口头约定变成不可绕过的回归门禁。\",\"signal\":\"失败必须在 CI 暴露\"},{\"id\":\"system\",\"label\":\"系统\",\"title\":\"三层隔离契约\",\"detail\":\"Proxy、route group 与最小 public API 共同表达所有权。\",\"signal\":\"路由、模块、认证同时隔离\"},{\"id\":\"verification\",\"label\":\"验证\",\"title\":\"两个域名同时验收\",\"detail\":\"每次发布同时核验 GitHub Actions、Vercel 与两个生产域名。\",\"signal\":\"共享部署，不共享风险\"}]},{\"id\":\"crm\",\"title\":\"CFZZS 招商 CRM\",\"kicker\":\"业务系统 / 权限与并发\",\"summary\":\"给产业园区招商团队用的一套线索工作台：从企业查重、阶段推进到空间资源和导出，关键状态都能追溯。\",\"caseHref\":\"/work/cfzzs-crm\",\"liveHref\":\"https://cfzzs.custard.top\",\"coverageScore\":80,\"artifactCount\":3,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"问题\",\"title\":\"业务真相散落在表格里\",\"detail\":\"线索、企业、空间与跟进记录彼此脱节，状态无法被团队共同相信。\",\"signal\":\"问题不是缺页面，而是缺一致状态\"},{\"id\":\"decision\",\"label\":\"取舍\",\"title\":\"冲突不再静默覆盖\",\"detail\":\"乐观锁在写入前比较版本，冲突回到用户而不是篡改事实。\",\"signal\":\"409 是保护，不是故障\"},{\"id\":\"system\",\"label\":\"系统\",\"title\":\"把流程写成状态机\",\"detail\":\"明确阶段转换、查重规则、空间占用与审计事件，让接口与界面共享同一契约。\",\"signal\":\"每次流转都可解释\"},{\"id\":\"verification\",\"label\":\"验证\",\"title\":\"按真实角色验收\",\"detail\":\"浏览器测试覆盖登录、创建、流转、查重、导出和权限边界。\",\"signal\":\"业务故事完整通过\"}]},{\"id\":\"alpha\",\"title\":\"CSTD Alpha 研究系统\",\"kicker\":\"证据管线 / 决策工作台\",\"summary\":\"把“问一句出一篇报告”拆成可回看的研究流程：来源、异步任务、估值版本和反证条件都跟着结果保存。\",\"caseHref\":\"/work/alpha-research-system\",\"liveHref\":\"https://alpha.custard.top\",\"coverageScore\":80,\"artifactCount\":5,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"问题\",\"title\":\"流畅回答不等于可靠研究\",\"detail\":\"没有来源寿命、任务状态和反证条件的文本，无法支撑长期决策。\",\"signal\":\"回答长度不是质量指标\"},{\"id\":\"decision\",\"label\":\"取舍\",\"title\":\"先指纹，再调用模型\",\"detail\":\"证据集先被规范化和指纹化；没有变化时复用结果，有变化时创建新版本。\",\"signal\":\"模型成本服从证据变化\"},{\"id\":\"system\",\"label\":\"系统\",\"title\":\"估值版本不可变\",\"detail\":\"确定性计算、AI 解释、来源与反证条件共同绑定到同一个研究快照。\",\"signal\":\"每个结论都能回到输入\"},{\"id\":\"verification\",\"label\":\"验证\",\"title\":\"研究链路可重放\",\"detail\":\"Agent Replay、测试与生产检查共同证明收集、排队、综合和发布行为。\",\"signal\":\"公开证据约束公开回答\"}]}],\"locale\":\"zh\"}]\n40:[\"$\",\"div\",null,{\"data-cstd-proof-footer\":true,\"className\":\"mt-9 flex flex-wrap items-center justify-between gap-5 border-t pt-5 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"span\",null,{\"children\":[7,\" \",\"个已发布案例\",\" / \",31,\" \",\"项公开证据\"]}],[\"$\",\"div\",null,{\"className\":\"flex gap-6\",\"children\":[[\"$\",\"$L4\",null,{\"data-cstd-proof-footer-link\":\"primary\",\"href\":\"/work\",\"children\":\"全部案例\"}],[\"$\",\"$L4\",null,{\"data-cstd-proof-footer-link\":\"secondary\",\"href\":\"/proof.json\",\"children\":\"PROOF.JSON\"}]]}]]}]\n41:[\"$\",\"section\",null,{\"data-cstd-chapter\":\"operator\",\"data-cstd-evidence-subchapter\":true,\"data-cstd-executable-evidence\":true,\"data-cstd-home-replay\":\"alpha-race\",\"aria-labelledby\":\"executable-evidence-heading\",\"className\":\"relative z-20 border-b border-white/10 bg-[#050709] px-5 py-20 text-[#f2efe7] md:px-10 lg:px-16 lg:py-28\",\"children\":[[\"$\",\"span\",null,{\"id\":\"operator\",\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 h-px w-px scroll-mt-20\"}],[\"$\",\"div\",null,{\"data-cstd-evidence-layout\":true,\"className\":\"mx-auto grid max-w-[1320px] gap-10 xl:grid-cols-[minmax(25rem,0.9fr)_minmax(0,1.1fr)] xl:items-start xl:gap-16\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[[\"$\",\"$L5\",null,{\"iconNode\":\"$c:props:children:props:children:0:props:children:props:children:0:props:children:0:props:iconNode\",\"className\":\"lucide-flask-conical h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":\"03B / EXECUTABLE EVIDENCE\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"03B / EXECUTABLE EVIDENCE\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"试炼场 / 可执行证据\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"命运判定 / 可执行证据\"}]]]}],[\"$\",\"h2\",null,{\"id\":\"executable-evidence-heading\",\"className\":\"mt-5 text-4xl font-semibold leading-[1] md:text-6xl xl:text-[3.75rem]\",\"children\":[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":[\"案例不只可读，\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"还可以运行。\"}]]}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"$41:props:children:1:props:children:0:props:children:1:props:children:0:props:children\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":[\"别把结果写成传说，\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"运行才算证词。\"}]]}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":[\"结果不能靠传闻，\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"掷下骰子，亲自过一次判定。\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-xl text-base leading-8 text-[#aeb7ba]\",\"children\":[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":\"不放一段录屏糊弄过去。这里把输入、计算和结果摊开，让你亲手触发一次边界。\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"不放一段录屏糊弄过去。这里把输入、计算和结果摊开，让你亲手触发一次边界。\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"每个系统都要进试炼场。改动条件、重新点火，看看哪条结论还能从熔炉里完整走出来。\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"每个结论都要接受一次判定。改动条件、重新运行，看看成功究竟来自运气，还是来自系统本身。\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap gap-6\",\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/work/alpha-research-system\",\"className\":\"inline-flex items-center gap-2 font-mono text-[11px] font-black text-[#24e0ff] hover:text-white\",\"children\":[\"查看完整技术案例\",\" \",[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]]}],[\"$\",\"$L4\",null,{\"href\":\"/lab/proof-museum\",\"className\":\"inline-flex items-center gap-2 font-mono text-[11px] font-black text-[#899499] hover:text-white\",\"children\":[\"证据博物馆\",\" \",[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]]}]]}]]}],[\"$\",\"$L4a\",\"alpha-race\",{\"replay\":{\"id\":\"alpha-race\",\"caseSlug\":\"alpha-research-system\",\"title\":{\"zh\":\"异步版本竞态\",\"en\":\"Async version race\"},\"thesis\":{\"zh\":\"旧任务可以完成，但不能覆盖新事实。\",\"en\":\"A stale task may finish, but it cannot overwrite newer truth.\"},\"inputLabel\":{\"zh\":\"并发研究任务\",\"en\":\"Concurrent research jobs\"},\"inputMin\":2,\"inputMax\":8,\"inputStep\":1,\"inputDefault\":4,\"unit\":{\"zh\":\"个\",\"en\":\" jobs\"},\"sourceHref\":{\"zh\":\"/work/alpha-research-system\",\"en\":\"/en/work/alpha-research-system\"}},\"locale\":\"zh\"}]]}]]}]\n42:[\"$\",\"$L4\",null,{\"href\":\"/work/rocodex-platform\",\"aria-label\":\"阅读来源\",\"title\":\"你的双站架构怎么隔离？ / 3 个关联节点\",\"className\":\"inline-flex h-10 w-10 items-center justify-center border border-white/15 text-[#24e0ff] transition-colors group-hover:border-[#24e0ff]/60 hover:bg-[#24e0ff] hover:text-[#050709]\",\"children\":[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]}]\n43:[\"$\",\"article\",\"AI 研究如何避免幻觉？\",{\"data-cstd-knowledge-card\":true,\"className\":\"group grid gap-4 border-b border-white/14 py-7 md:grid-cols-[3rem_minmax(14rem,0.8fr)_minmax(0,1.2fr)_auto] md:items-center md:gap-7 lg:py-8\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\"SOURCE LINKED\"}],[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":[\"0\",2]}],[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold leading-tight text-white md:text-2xl\",\"children\":\"AI 研究如何避免幻觉？\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-2 text-sm leading-7 text-[#9da8ab]\",\"children\":\"把“问一句出一篇报告”拆成可回看的研究流程：来源、异步任务、估值版本和反证条件都跟着结果保存。 公司研究最贵的往往不是 token，而是过期事实、重复任务和说不清来路的结论。 把对话、生成和资料沉淀设计为可以回看、可以继续的个人工作流。 私有 AI 工作台与 Alpha 研究工具均已独立部署。\"}],[\"$\",\"$L4\",null,{\"href\":\"/work/alpha-research-system\",\"aria-label\":\"阅读来源\",\"title\":\"AI 研究如何避免幻觉？ / 3 个关联节点\",\"className\":\"inline-flex h-10 w-10 items-center justify-center border border-white/15 text-[#24e0ff] transition-colors group-hover:border-[#24e0ff]/60 hover:bg-[#24e0ff] hover:text-[#050709]\",\"children\":[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]}]]}]\n44:[\"$\",\"article\",\"DCF 为什么不用模型计算？\",{\"data-cstd-knowledge-card\":true,\"className\":\"group grid gap-4 border-b border-white/14 py-7 md:grid-cols-[3rem_minmax(14rem,0.8fr)_minmax(0,1.2fr)_auto] md:items-center md:gap-7 lg:py-8\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\"SOURCE LINKED\"}],[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":[\"0\",3]}],[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold leading-tight text-white md:text-2xl\",\"children\":\"DCF 为什么不用模型计算？\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-2 text-sm leading-7 text-[#9da8ab]\",\"children\":\"一次 DCF 扫描的性能复盘：热点不在公式，而在缓存 JSON 被反复搬运。 在课程与独立研究中，用计算和可视化把假设、数据与判断拆开。 方法来自数据科学、交互分析与量化研究实践。\"}],[\"$\",\"$L4\",null,{\"href\":\"/notes/observable-dcf-pipeline\",\"aria-label\":\"阅读来源\",\"title\":\"DCF 为什么不用模型计算？ / 3 个关联节点\",\"className\":\"inline-flex h-10 w-10 items-center justify-center border border-white/15 text-[#24e0ff] transition-colors group-hover:border-[#24e0ff]/60 hover:bg-[#24e0ff] hover:text-[#050709]\",\"children\":[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]}]]}]\n45:[\"$\",\"article\",\"147 万行开放数据怎么变成可分析？\",{\"data-cstd-knowledge-card\":true,\"className\":\"group grid gap-4 border-b border-white/14 py-7 md:grid-cols-[3rem_minmax(14rem,0.8fr)_minmax(0,1.2fr)_auto] md:items-center md:gap-7 lg:py-8\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\"SOURCE LINKED\"}],[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":[\"0\",4]}],[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold leading-tight text-white md:text-2xl\",\"children\":\"147 万行开放数据怎么变成可分析？\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-2 text-sm leading-7 text-[#9da8ab]\",\"children\":\"FIT5147 数据探索项目：清洗、空间连接并建模墨尔本 CBD 的行人与微气候数据，产出可一键重跑的分析管线。 把墨尔本 CBD 三个官方开放数据源清洗、空间连接并建模成一条可复现的分析管线：147 万行行人记录，在 150 米匹配规则下遇见微气候。 数据清洗并不只是分析前的杂活：每个缺失值、日期和主体匹配规则，都会改变产品怎么说话。\"}],[\"$\",\"$L4\",null,{\"href\":\"/work/melbourne-pedestrian-microclimate\",\"aria-label\":\"阅读来源\",\"title\":\"147 万行开放数据怎么变成可分析？ / 2 个关联节点\",\"className\":\"inline-flex h-10 w-10 items-center justify-center border border-white/15 text-[#24e0ff] transition-colors group-hover:border-[#24e0ff]/60 hover:bg-[#24e0ff] hover:text-[#050709]\",\"children\":[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]}]]}]\n46:[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-wrap items-center justify-between gap-6\",\"data-cstd-content-health\":true,\"data-cstd-content-health-score\":100,\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-[#7f8b90]\",\"children\":[\"CONTENT HEALTH / \",[\"$\",\"span\",null,{\"className\":\"text-white\",\"children\":100}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-6 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/notes\",\"className\":\"text-[#f4d431] hover:text-white\",\"children\":\"全部札记\"}],[\"$\",\"$L4\",null,{\"href\":\"/map\",\"className\":\"text-[#aeb8bb] hover:text-white\",\"children\":\"知识图谱\"}],[\"$\",\"$L4\",null,{\"href\":\"/graph.json\",\"className\":\"text-[#24e0ff] hover:text-white\",\"children\":\"GRAPH.JSON\"}]]}]]}]\n47:[\"$\",\"p\",null,{\"className\":\"cstd-finale-meta mt-3 text-[11px] leading-5\",\"children\":[\"奶黄包个人技术工作室\",\" / SYDNEY\"]}]\n48:[\"$\",\"div\",null,{\"className\":\"mt-7 flex items-center gap-5\",\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/for/builder\",\"aria-label\":\"分享这条观看路径\",\"className\":\"inline-flex h-10 w-10 items-center justify-center border border-[#24e0ff]/35 text-[#24e0ff] hover:bg-[#24e0ff] hover:text-[#05