;\n    });\n  };\n\n  applyTheme();\n  const observer = new MutationObserver(applyTheme);\n  observer.observe(html, { childList: true, subtree: true });\n  window.addEventListener(\"DOMContentLoaded\", () => {\n    applyTheme();\n    window.requestAnimationFrame(() => observer.disconnect());\n  }, { once: true });\n})();5:X\n8:X\n8:C\n0:{\"buildId\":\"w_I4IDrtWHo5G2vDpm_Kr\",\"data\":[{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/30hmtu1t-yadr.css\",\"precedence\":\"next\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2_mcy66v8c8ko.css\",\"precedence\":\"next\"}],[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1vgxuk6_qw1an.css\",\"precedence\":\"next\"}],[\"$\",\"link\",\"3\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1t6mocic66c_9.css\",\"precedence\":\"next\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3bpg1zucvhmqd.js\",\"async\":true}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1i9zhf0udey6-.js\",\"async\":true}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/0o4mbv36vpg4h.js\",\"async\":true}]],[\"$\",\"html\",null,{\"lang\":\"zh-CN\",\"dir\":\"ltr\",\"className\":\"h-full antialiased\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"script\",null,{\"id\":\"cstd-theme-bootstrap\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}]}],\"$L3\"]}]]}],\"isPartial\":\"$@4\",\"staleTime\":\"$5\",\"varyParams\":null},{\"rsc\":\"$L6\",\"isPartial\":\"$@7\",\"staleTime\":\"$5\",\"varyParams\":\"$8\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@9\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@a\"}\nb:I[39756,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"default\"]\nc:I[37457,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"default\"]\nd:I[5014,[\"/_next/static/chunks/3bpg1zucvhmqd.js\",\"/_next/static/chunks/1i9zhf0u