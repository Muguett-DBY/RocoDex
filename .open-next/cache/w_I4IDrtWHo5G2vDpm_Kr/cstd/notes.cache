ght=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock3 lucide-clock-3 h-3.5 w-3.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6h4\"></path></svg> <!-- -->13<!-- --> <!-- -->分钟<span class=\"border-l border-white/15 pl-3\">Python</span><span class=\"border-l border-white/15 pl-3\">Profiling</span><span class=\"border-l border-white/15 pl-3\">Caching</span><span class=\"border-l border-white/15 pl-3\">Data lineage</span></div></div><figure class=\"relative aspect-[4/3] overflow-hidden border border-white/15 bg-black md:order-none\" style=\"view-transition-name:cstd-note-observable-dcf-pipeline\"><img alt=\"高速数据织机\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover opacity-75 transition-[transform,opacity] duration-500 group-hover:scale-105 group-hover:opacity-100\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/cstd-world/cstd-data-loom-v2.webp\"/><span class=\"absolute bottom-3 right-3 flex h-8 w-8 items-center justify-center bg-[#f4d431] text-black\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></figure></a></article><article class=\"group border-t border-white/15 first:border-t-0\"><a class=\"grid gap-7 py-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#24e0ff] md:grid-cols-[7rem_minmax(0,1fr)_15rem] md:items-center lg:py-14\" href=\"/notes/optimistic-locking-for-operations\"><div class=\"flex items-center gap-4 md:block\"><span class=\"font-mono text-[11px] font-black text-[#f4d431]\"