\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg></a></div></div><nav aria-label=\"移动导航\" class=\"flex h-11 items-center gap-1 overflow-x-auto overscroll-x-contain border-t border-white/8 px-3 [scrollbar-width:none] [&amp;::-webkit-scrollbar]:hidden lg:hidden\"><a class=\"shrink-0 px-3 py-2 font-mono text-[11px] font-black text-[#9aa4a8] hover:text-[#f4d431]\" href=\"/work\">作品</a><a class=\"shrink-0 px-3 py-2 font-mono text-[11px] font-black text-[#9aa4a8] hover:text-[#f4d431]\" href=\"/notes\">札记</a><a class=\"shrink-0 px-3 py-2 font-mono text-[11px] font-black text-[#9aa4a8] hover:text-[#f4d431]\" href=\"/lab\">实验</a><a class=\"shrink-0 px-3 py-2 font-mono text-[11px] font-black text-[#9aa4a8] hover:text-[#f4d431]\" href=\"/topics\">主题</a><a class=\"shrink-0 px-3 py-2 font-mono text-[11px] font-black text-[#9aa4a8] hover:text-[#f4d431]\" href=\"/map\">图谱</a><a class=\"shrink-0 px-3 py-2 font-mono text-[11px] font-black text-[#9aa4a8] hover:text-[#f4d431]\" href=\"/about\">关于</a><a class=\"shrink-0 px-3 py-2 font-mono text-[11px] font-black text-[#9aa4a8] hover:text-[#f4d431]\" href=\"/now\">现在</a></nav></header><div class=\"relative z-10\"><main id=\"cstd-main\"><header data-cstd-page-hero=\"true\" class=\"relative flex overflow-hidden border-b border-white/15 min-h-[68svh]\" style=\"view-transition-name:cstd-note-data-wrangling-as-product-design\"><img data-cstd-page-hero-image=\"true\" alt=\"记录数据血缘的胶片档案\" loading=\"eager\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent\" src=\"/cstd-archive/cstd-archive-data-film-v1.webp\"/><div data-cstd-page-hero-overlay=\"true\" aria-hidden=\"true\" class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(5,7,9,0.96)_0%,rgba(5,7,9,0.78)_46%,rgba(5,7,9,0.18)_100%)]\"></div><div data-cstd-page-hero-grid=\"true\" aria-hidden=\"true\" class=\"absolute inset-0 opacity-20 [background-image:linear-gradient(rgba(255,255,255,0.09)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.09)_1px,transparent_1px)] [background-size:64px_64px]\"></div><div data-cstd-page-hero-material=\"true\" aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\"></div><div data-cstd-page-hero-artifacts=\"true\" aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 overflow-hidden\"><div data-cstd-deep-artifact=\"neon\" class=\"cstd-deep-neon-rig\"><span class=\"cstd-deep-neon-index\">CSTD / 轨迹 09</span><span class=\"cstd-deep-neon-coordinate\">-33.8688 / 151.2093</span><span class=\"cstd-deep-neon-signal\"><i></i><i></i><i></i><i></i><i></i><i></i></span><span class=\"cstd-deep-neon-lock\">信号已锁定</span></div><div data-cstd-deep-artifact=\"underworld\" class=\"cstd-deep-underworld-stele\"><span class=\"cstd-deep-underworld-kicker\">冥府档案 / 工坊 017</span><span class=\"cstd-deep-underworld-seal\"><i></i><i></i><b>V</b></span><span class=\"cstd-deep-underworld-oath\">经试炼，方可归返</span><span class=\"cstd-deep-underworld-cuts\"><i></i><i></i><i></i><i></i><i></i></span></div><div data-cstd-deep-artifact=\"astral\" class=\"cstd-deep-astral-compass\"><span class=\"cstd-deep-astral-kicker\">星界旅记 / 判定 017</span><span class=\"cstd-deep-astral-die\"><i></i><b>20</b><i></i></span><span class=\"cstd-deep-astral-route\"><i></i><i></i><i></i><i></i><i></i></span><span class=\"cstd-deep-astral-oath\">选择落笔，旅程成章</span></div></div><div data-cstd-page-hero-content=\"true\" class=\"relative mx-auto flex w-full max-w-[1540px] flex-col justify-end px-5 pb-16 pt-28 md:px-10 lg:px-16 lg:pb-20\"><div class=\"max-w-5xl\"><p data-cstd-page-hero-eyebrow=\"true\" class=\"font-mono text-[11px] font-black text-[#f4d431]\">数据科学 / 从课程到系统</p><h1 data-cstd-page-hero-title=\"true\" class=\"mt-6 text-balance text-[2.375rem] font-semibold leading-[0.94] tracking-[0] text-white sm:text-5xl md:text-7xl md:leading-[0.9] lg:text-8xl xl:text-[7rem]\">数据清洗也是产品设计</h1><p data-cstd-page-hero-summary=\"true\" class=\"mt-7 max-w-3xl text-lg leading-8 text-[#c3c9cb] md:text-xl md:leading-9\">数据清洗并不只是分析前的杂活：每个缺失值、日期和主体匹配规则，都会改变产品怎么说话。</p></div><dl data-cstd-page-hero-metrics=\"true\" class=\"mt-10 grid max-w-4xl grid-cols-2 border-y border-white/20 md:grid-cols-3\"><div class=\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\"><dt class=\"font-mono text-[11px] font-black uppercase text-[#8a969b]\">阅读时间</dt><dd class=\"mt-2 whitespace-nowrap text-xl font-semibold text-[#24e0ff] sm:text-2xl\">12 分钟</dd></div><div class=\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\"><dt class=\"font-mono text-[11px] font-black uppercase text-[#8a969b]\">发布</dt><dd class=\"mt-2 whitespace-nowrap text-xl font-semibold text-[#24e0ff] sm:text-2xl\">2026年7月18日</dd></div><div class=\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\"><dt class=\"font-mono text-[11px] font-black uppercase text-[#8a969b]\">系列</dt><dd class=\"mt-2 whitespace-nowrap text-xl font-semibold text-[#24e0ff] sm:text-2xl\">从课程到系统</dd></div></dl><div data-cstd-page-hero-scroll=\"true\" aria-hidden=\"true\" class=\"mt-9 flex items-center gap-3 font-mono text-[11px] font-black text-[#748187]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-down h-3.5 w-3.5 animate-bounce text-[#f4d431]\" aria-hidden=\"true\"><path d=\"M12 5v14\"></path><path d=\"m19 12-7 7-7-7\"></path></svg> <!-- -->向下滚动 / 继续查看</div></div></header><article data-cstd-reading-document=\"true\" class=\"bg-[#f1eee5] text-[#111315]\"><div class=\"mx-auto grid max-w-[1320px] gap-12 px-5 py-16 md:px-10 lg:grid-cols-[13rem_minmax(0,46rem)] lg:justify-center lg:gap-20 lg:px-16 lg:py-24\"><aside class=\"lg:sticky lg:top-28 lg:h-fit\"><a class=\"inline-flex items-center gap-2 font-mono text-[11px] font-black text-[#0b6473] hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black\" href=\"/notes\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg> <!-- -->全部札记</a><nav aria-label=\"文章目录\" class=\"mt-8 hidden border-l border-black/20 pl-4 lg:block\"><a href=\"#contract\" class=\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\"><span class=\"mr-2 text-[#0b6473]\">0<!-- -->1</span>脏数据通常是未写下的产品决策</a><a href=\"#layers\" class=\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\"><span class=\"mr-2 text-[#0b6473]\">0<!-- -->2</span>保留原始层、规范层和派生层</a><a href=\"#quality\" class=\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\"><span class=\"mr-2 text-[#0b6473]\">0<!-- -->3</span>数据质量要成为界面状态</a></nav><p class=\"mt-7 font-mono text-[11px] font-black leading-5 text-black/75\">修订<!-- --> <!-- -->2<br/>UPDATED <!-- -->2026-08-27</p><button type=\"button\" class=\"mt-6 inline-flex items-center gap-2 border-b border-black/35 pb-1 font-mono text-[11px] font-black text-black/75 hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-quote h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path><path d=\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path></svg>复制引用</button></aside><div><section id=\"contract\" class=\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\"><p class=\"font-mono text-[11px] font-black text-[#0b6473]\">CONTRACT</p><h2 class=\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\">脏数据通常是未写下的产品决策</h2><div class=\"cstd-mdx-prose cstd-mdx-prose-light\"><p>缺失值是未知、未适用还是抓取失败？日期属于交易所还是用户时区？同名公司是否同一上市主体？每个清洗规则都在替产品回答问题。</p><p>同一个字段在不同页面上被解释成不同意思时，问题已经不在脚本，而在产品没有决定什么叫“有效”。一旦规则写进数据契约，前端就可以明确地显示未知、缺失、代理值和已确认，而不是把它们都压成一个空白或零。</p><p>这件事还会改变团队的协作方式。研究者可以质疑口径，开发者可以定位转换，使用者可以知道一个数字能不能拿来做决定。数据清洗不是把脏东西藏起来，而是给每一次改变留下一条解释。</p></div></section><section id=\"layers\" class=\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\"><p class=\"font-mono text-[11px] font-black text-[#0b6473]\">LAYERS</p><h2 class=\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\">保留原始层、规范层和派生层</h2><div class=\"cstd-mdx-prose cstd-mdx-prose-light\"><p>原始响应用于追溯，规范记录用于跨来源比较，派生指标用于产品决策。覆盖原始值会让未来无法解释变化来自数据源、清洗规则还是业务公式。</p><p>研究管线可以保留三种视图：原始响应尽量不动，规范层只做可说明的格式统一，派生层才计算评分、估值或排序。这样做会多占一点存储，却能把“源数据变了”和“我们的规则变了”分开。对于会定期刷新、还要给别人复核的产品，这个取舍很划算。</p></div></section><section id=\"quality\" class=\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\"><p class=\"font-mono text-[11px] font-black text-[#0b6473]\">QUALITY</p><h2 class=\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\">数据质量要成为界面状态</h2><div class=\"cstd-mdx-prose cstd-mdx-prose-light\"><p>与其给不完整数据一个看似精确的数字，不如把来源、缺口、更新时间与确认级别展示给用户。好的产品不隐藏不确定性，而是让它可操作。</p><p>界面不需要把所有内部细节都倾倒给使用者，但应该给出足够的下一步：补充哪个字段、换一个数据源、等待下一次刷新，还是暂时不要使用这条结论。把质量当作状态设计，产品就不会在数据不完整时假装自己很确定。</p></div></section>\n<nav aria-label=\"所属主题路径\" class=\"mt-14 border-t border-black/20 pt-7\" data-cstd-note-paths=\"true\"><p class=\"font-mono text-[11px] font-black text-black/55\">所属主题路径</p><div class=\"mt-4 grid gap-3 sm:grid-cols-2\"><a class=\"group border-l-2 border-[#0b6473] py-1 pl-4 text-sm font-semibold leading-6 text-black/70 transition-colors hover:border-black hover:text-black\" href=\"/topics/quantitative-systems\">03<!-- --> / <!-- -->定量研究系统</a><a class=\"group border-l-2 border-[#0b6473] py-1 pl-4 text-sm font-semibold leading-6 text-black/70 transition-colors hover:border-black hover:text-black\" href=\"/topics/interdisciplinary-engineering\">05<!-- --> / <!-- -->跨学科工程路径</a></div></nav></div></div></article><section class=\"border-b border-white/12 bg-[#080a0c] px-5 py-20 md:px-10 lg:px-16\"><div class=\"mx-auto max-w-[1320px]\"><div class=\"flex items-center gap-3 font-mono text-[11px] font-black text-[#24e0ff]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-link2 lucide-link-2 h-4 w-4\" aria-hidden=\"true\"><path d=\"M9 17H7A5 5 0 0 1 7 7h2\"></path><path d=\"M15 7h2a5 5 0 1 1 0 10h-2\"></path><line x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"></line></svg> <!-- -->相关真实系统</div><p class=\"mt-5 max-w-2xl text-2xl font-semibold text-white md:text-3xl\">这篇文章来自以下项目中的实际设计与交付工作。</p><div class=\"mt-10 border-t border-white/15\"><a class=\"group flex items-center justify-between gap-6 border-b border-white/15 py-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\" href=\"/work/alpha-research-system\"><div><p class=\"font-mono text-[11px] font-black text-[#68757b]\">证据管线 / 决策工作台</p><p class=\"mt-2 text-xl font-semibold text-white md:text-2xl\">CSTD Alpha 研究系统</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=