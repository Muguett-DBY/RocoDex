] sm:text-2xl\",\"children\":\"2026年7月18日\"}]]}]\n1b:[\"$\",\"div\",\"从课程到系统-系列\",{\"className\":\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black uppercase text-[#8a969b]\",\"children\":\"系列\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 whitespace-nowrap text-xl font-semibold text-[#24e0ff] sm:text-2xl\",\"children\":\"从课程到系统\"}]]}]\n1c:[\"$\",\"div\",null,{\"data-cstd-page-hero-scroll\":true,\"aria-hidden\":\"true\",\"className\":\"mt-9 flex items-center gap-3 font-mono text-[11px] font-black text-[#748187]\",\"children\":[[\"$\",\"$Ld\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M12 5v14\",\"key\":\"s699le\"}],[\"path\",{\"d\":\"m19 12-7 7-7-7\",\"key\":\"1idqje\"}]],\"className\":\"lucide-arrow-down h-3.5 w-3.5 animate-bounce text-[#f4d431]\"}],\" \",\"向下滚动 / 继续查看\"]}]\n1d:[\"$\",\"article\",null,{\"data-cstd-reading-document\":true,\"className\":\"bg-[#f1eee5] text-[#111315]\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-12 px-5 py-16 md:px-10 lg:grid-cols-[13rem_minmax(0,46rem)] lg:justify-center lg:gap-20 lg:px-16 lg:py-24\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"lg:sticky lg:top-28 lg:h-fit\",\"children\":[[\"$\",\"$L21\",null,{\"href\":\"/notes\",\"className\":\"inline-flex items-center gap-2 font-mono text-[11px] font-black text-[#0b6473] hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black\",\"children\":[[\"$\",\"$Ld\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$5:props:children:0:props:notFound:0:props:children:props:children:5:props:children:0:props:iconNode\",\"className\":\"lucide-arrow-left h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"全部札记\"]}],[\"$\",\"nav\",null,{\"aria-label\":\"文章目录\",\"className\":\"mt-8 hidden border-l border-black/20 pl-4 lg:block\",\"children\":[[\"$\",\"a\",\"contract\",{\"href\":\"#contract\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",1]}],\"脏数据通常是未写下的产品决策\"]}],[\"$\",\"a\",\"layers\",{\"href\":\"#layers\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",2]}],\"保留原始层、规范层和派生层\"]}],[\"$\",\"a\",\"quality\",{\"href\":\"#quality\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",3]}],\"数据质量要成为界面状态\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-7 font-mono text-[11px] font-black leading-5 text-black/75\",\"children\":[\"修订\",\" \",2,[\"$\",\"br\",null,{}],\"UPDATED \",\"2026-08-27\"]}],[\"$\",\"$L22\",null,{\"value\":\"数据清洗也是产品设计 — 奶黄包, https://custard.top/notes/data-wrangling-as-product-design (2026-08-27)\",\"label\":\"复制引用\"}]]}],[\"$\",\"div\",null,{\"children\":[[[[\"$\",\"section\",null,{\"id\":\"contract\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"CONTRACT\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"脏数据通常是未写下的产品决策\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"缺失值是未知、未适用还是抓取失败？日期属于交易所还是用户时区？同名公司是否同一上市主体？每个清洗规则都在替产品回答问题。\"}],[\"$\",\"p\",null,{\"children\":\"同一个字段在不同页面上被解释成不同意思时，问题已经不在脚本，而在产品没有决定什么叫“有效”。一旦规则写进数据契约，前端就可以明确地显示未知、缺失、代理值和已确认，而不是把它们都压成一个空白或零。\"}],[\"$\",\"p\",null,{\"children\":\"这件事还会改变团队的协作方式。研究者可以质疑口径，开发者可以定位转换，使用者可以知道一个数字能不能拿来做决定。数据清洗不是把脏东西藏起来，而是给每一次改变留下一条解释。\"}]]}]]}],[\"$\",\"section\",null,{\"id\":\"layers\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"LAYERS\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"保留原始层、规范层和派生层\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"原始响应用于追溯，规范记录用于跨来源比较，派生指标用于产品决策。覆盖原始值会让未来无法解释变化来自数据源、清洗规则还是业务公式。\"}],[\"$\",\"p\",null,{\"children\":\"研究管线可以保留三种视图：原始响应尽量不动，规范层只做可说明的格式统一，派生层才计算评分、估值或排序。这样做会多占一点存储，却能把“源数据变了”和“我们的规则变了”分开。对于会定期刷新、还要给别人复核的产品，这个取舍很划算。\"}]]}]]}],[\"$\",\"section\",null,{\"id\":\"quality\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"QUALITY\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"数据质量要成为界面状态\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"与其给不完整数据一个看似精确的数字，不如把来源、缺口、更新时间与确认级别展示给用户。好的产品不隐藏不确定性，而是让它可操作。\"}],[\"$\",\"p\",null,{\"children\":\"界面不需要把所有内部细节都倾倒给使用者，但应该给出足够的下一步：补充哪个字段、换一个数据源、等待下一次刷新，还是暂时不要使用这条结论。把质量当作状态设计，产品就不会在数据不完整时假装自己很确定。\"}]]}]]}]],\"\\n\",null],[\"$\",\"nav\",null,{\"aria-label\":\"所属主题路径\",\"className\":\"mt-14 border-t border-black/20 pt-7\",\"data-cstd-note-paths\":true,\"children\":[\"$L23\",\"$L24\"]}]]}]]}]}]\n1e:[\"$\",\"section\",null,{\"className\":\"border-b border-white/12 bg-[#080a0c] px-5 py-20 md:px-10 lg:px-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[[\"$\",\"$Ld\",null,{\"ref\