[\\\"REV \\\",1,\\\" / \\\",\\\"核验\\\",\\\" \\\",\\\"2026-09-06\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"hidden items-center justify-center border-x border-white/10 text-[#f4d431] lg:flex\\\",\\\"children\\\":[\\\"$\\\",\\\"$Ld\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$20:props:children:props:children:2:props:children:1:props:children:props:iconNode\\\",\\\"className\\\":\\\"lucide-arrow-right h-5 w-5\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-t border-white/15 py-7 lg:border-t-0 lg:pl-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono text-[11px] font-black text-[#78858a]\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Ld\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M9 17H7A5 5 0 0 1 7 7h2\\\",\\\"key\\\":\\\"8i5ue5\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"M15 7h2a5 5 0 1 1 0 10h-2\\\",\\\"key\\\":\\\"1b9ql8\\\"}],[\\\"line\\\",{\\\"x1\\\":\\\"8\\\",\\\"x2\\\":\\\"16\\\",\\\"y1\\\":\\\"12\\\",\\\"y2\\\":\\\"12\\\",\\\"key\\\":\\\"1jonct\\\"}]],\\\"className\\\":\\\"lucide-link2 lucide-link-2 h-4 w-4\\\",\\\"aria-hidden\\\":\\\"true\\\"}],\\\" \\\",\\\"证据与复现\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-5 border-t border-white/10\\\",\\\"children\\\":[[[\\\"$\\\",\\\"$L25\\\",\\\"note-/notes/data-wrangling-as-product-design\\\",{\\\"href\\\":\\\"/notes/data-wrangling-as-product-design\\\",\\\"className\\\":\\\"flex items-start justify-between gap-5 border-b border-white/10 py-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\\\",\\\"children\\\":\\\"$L27\\\"}],\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\"],[\\\"$L2c\\\"],[\\\"$L2d\\\"]]}]]}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"21:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"bg-[#080a0c]\\\",\\\"children\\\":[[[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"questions\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"01 / 问题\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"三个问题，一条开放数据链。\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"这个项目问三件事：墨尔本 CBD 的行人活动随时间怎么变化？温度、风和颗粒物条件与活动之间有什么关联？哪些地段对高温和差空气质量更脆弱，工作日和周末又是否不同？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"原料全部来自墨尔本市政府的官方开放数据：147 万行行人计数、145 行传感器位置、59 万行微气候观测。三个数据源各有各的发布频率和坐标习惯——这个项目真正的起点不是建模，而是把口径对齐。\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"pipeline\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"02 / 管线\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"先可复现，再可解释。\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"四段式 R 管线（下载 → 清洗 → 成图 → 报告）覆盖全部处理过程：\\\",[\\\"$\\\",\\\"code\\\",null,{\\\"children\\\":\\\"data.table\\\"}],\\\" 做过滤与连接，\\\",[\\\"$\\\",\\\"code\\\",null,{\\\"children\\\":\\\"lubridate\\\"}],\\\" 处理时区并聚合到小时，自写的半正矢距离计算完成\\\\\\\"每个行人传感器匹配最近微气候设备\\\\\\\"的空间连接。150 米的严格阈值保留了 14 个传感器，中位匹配距离 99.7 米。\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"原始数据收敛为 170,243 行联表小时数据，其中 130,918 行具备完整的温度、PM2.5 与风速。缺失值不插补——这是探索性分析，不是预测比赛，把\\\\\\\"哪里有洞\\\\\\\"留在明处比把洞填上更重要。\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"findings\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"03 / 发现\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"环境信号存在，但长在城市节奏之上。\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"三个问题都有可核验的答案。活动按月、按星期、按小时的结构性差异显著，且不同位置的性格完全不同——通勤型地段和休闲型地段的高峰形状不一样。控制这些节奏之后，温度、PM2.5 与风仍与活动存在可测的关联。\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"分传感器的高温与 PM2.5 敏感度地图显示：脆弱性不是单维度的，同一地段对高温和 对污染的响应可以不一致，工作日与周末的形态也会分开。这项分析是观察性的，它给出的是条件关联和空间格局，不是因果效应——限制写在报告里，也写在每一次重跑里。\\\"}]]}]]}]]}]}]],\\\"\\\\n\\\",null]}]\\n\"])</script><script>self.__next_f.push([1,\"22:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"border-b border-[#f4d431]/40 bg-[#f4d431] px-5 py-20 text-[#050709] md:px-10 lg:px-16 lg:py-24\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-[1320px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-8 lg:grid-cols-[0.75fr_1.25fr]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono text-[11px] font-black\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Ld\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\\\",\\\"key\\\":\\\"oel41y\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"m9 12 2 2 4-4\\\",\\\"key\\\":\\\"dzmm74\\\"}]],\\\"className\\\":\\\"lucide-shield-check h-5 w-5\\\",\\\"aria-hidden\\\":\\\"true\\\"}],\\\" \\\",\\\"PROOF LEDGER / 交付证据\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"mt-5 max-w-xl text-4xl font-semibold leading-tight md:text-5xl\\\",\\\"children\\\":\\\"不是自述式能力列表，而是可以从实现、测试与线上运行中追溯的事实。\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-t border-black/30\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"口径\\\",{\\\"className\\\":\\\"grid gap-3 border-b border-black/30 py-5 sm:grid-cols-[3rem_10rem_1fr] sm:items-start\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-black/75\\\",\\\"children\\\":[\\\"0\\\",1]}],[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"font-mono text-xs\\\",\\\"children\\\":\\\"口径\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm leading-7 text-black/70\\\",\\\"children\\\":\\\"三个官方数据源在同一段时间窗口内对齐：2024-05