\"}],[\"path\",{\"d\":\"m17 16.5-5-3\",\"key\":\"8arw3v\"}],[\"path\",{\"d\":\"m17 16.5 4.74-2.85\",\"key\":\"8rfmw\"}],[\"path\",{\"d\":\"M17 16.5v5.17\",\"key\":\"k6z78m\"}],[\"path\",{\"d\":\"M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z\",\"key\":\"1xygjf\"}],[\"path\",{\"d\":\"M12 8 7.26 5.15\",\"key\":\"1vbdud\"}],[\"path\",{\"d\":\"m12 8 4.74-2.85\",\"key\":\"3rx089\"}],[\"path\",{\"d\":\"M12 13.5V8\",\"key\":\"1io7kd\"}]],\"className\":\"lucide-boxes h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"能力区域\"]}],[\"$\",\"div\",null,{\"className\":\"mt-5 border-t border-white/10\",\"children\":[[\"$\",\"div\",\"ai-creation\",{\"className\":\"border-b border-white/10 py-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"AGENT-03\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm font-semibold text-white\",\"children\":\"AI 创作与研究工具\"}]]}],[\"$\",\"div\",\"product-surfaces\",{\"className\":\"border-b border-white/10 py-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"SURFACE-01\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm font-semibold text-white\",\"children\":\"产品界面与使用路径\"}]]}]]}]]}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"hidden items-center justify-center border-x border-white/10 text-[#24e0ff] lg:flex\",\"children\":[\"$\",\"$L1f\",null,{\"iconNode\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]],\"className\":\"lucide-arrow-right h-5 w-5\"}]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 py-7 lg:border-t-0 lg:px-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#78858a]\",\"children\":\"真实系统\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 text-2xl font-semibold text-white\",\"children\":\"CSTD Design 创作工作台\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm leading-7 text-[#9ca7aa]\",\"children\":\"一个给自己使用的中文创作工作台：对话可以分支，图片和视频任务可以恢复，素材始终找得到来源。\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[11px] font-black text-[#3dff8f]\",\"children\":[\"REV \",2,\" / \",\"核验\",\" \",\"2026-08-27\"]}]]}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"hidden items-center justify-center border-x border-white/10 text-[#f4d431] lg:flex\",\"children\":[\"$\",\"$L1f\",null,{\"iconNode\":\"$a:props:children:props:children:2:props:children:1:props:children:props:iconNode\",\"className\":\"lucide-arrow-right h-5 w-5\"}]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 py-7 lg:border-t-0 lg:pl-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#78858a]\",\"children\":[[\"$\",\"$L1f\",null,{\"iconNode\":[[\"path\",{\"d\":\"M9 17H7A5 5 0 0 1 7 7h2\",\"key\":\"8i5ue5\"}],[\"path\",{\"d\":\"M15 7h2a5 5 0 1 1 0 10h-2\",\"key\":\"1b9ql8\"}],[\"line\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"12\",\"y2\":\"12\",\"key\":\"1jonct\"}]],\"className\":\"lucide-link2 lucide-link-2 h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"证据与复现\"]}],[\"$\",\"div\",null,{\"className\":\"mt-5 border-t border-white/10\",\"children\":[[[\"$\",\"$L20\",\"lab-/lab/agent-replay\",{\"href\":\"/lab/agent-replay\",\"className\":\"flex items-start justify-between gap-5 border-b border-white/10 py-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\",\"children\":\"$L22\"}],\"$L23\",\"$L24\"],[],[\"$L25\",\"$L26\"]]}]]}]]}]]}]}]\nb:[\"$\",\"article\",null,{\"className\":\"bg-[#080a0c]\",\"children\":[[[\"$\",\"section\",null,{\"id\":\"model\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"01 / 模型\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"创作不是一个输入框。\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"对话会分支，生成会排队，素材会回溯到提示词。系统因此围绕可恢复的会话、任务与资产实体设计，而不是围绕一个聊天组件。\"}],[\"$\",\"p\",null,{\"children\":\"我不希望创作过程被压扁成“输入一次，等一个答案”。一个想法往往要经过几次改写、参考图和方向分叉，最后才知道哪一条值得留下。会话保存上下文，分支保存试错，资产保存结果和来源，这三个对象分开之后，用户才有机会回到某个决定之前重新走一遍。\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"id\":\"media\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"02 / 媒体\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"元数据走 D1，大对象走 R2。\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"图片和视频任务保留状态、尺寸、种子和错误；素材上传检查 Magic Bytes；界面轮询有失败上限，避免永远旋转的任务。\"}],[\"$\",\"p\",null,{\"children\":\"这些细节看似偏后台，却会直接影响创作体验。生成失败时，用户需要看到失败发生在哪一步，而不是把一个加载圈留到第二天；刷新页面后，已经完成的素材也应该能被找回来。D1 和 R2 的分工，最终要在这种日常操作里体现出来。\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"id\":\"safety\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"03 / 安全\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"私人系统也需要明确的滥用边界。\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"登录指数退避、API 分级限流、Secure Cookie、401 自动退出和内容类型校验共同缩小攻击面。\"}],[\"$\",\"p\",null,{\"children\":\"私人并不等于可以省略边界。上传、生成和导出都会消耗资源，失败重试也可能放大成本。把身份、额度、文件类型和任务状态分别写清楚，既保护系统，也让使用者知道为什么某个动作需要等待或确认。\"}]]}]]}]]}]}]],\"\\n\",null]}]\nc:[\"$\",\"section\",null,{\"className\":\"border-b border-[#f4d431]/40 bg-[#f4d431] px-5 py-20 text-[#050709] md:px-10 lg:px-16 lg:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-8 lg:grid-cols-[0.75fr_1.25fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"$L1f\",null,{\"iconNode\":[[\"path\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\",\"key\":\"oel41y\"}],[\"path\",{\"d\":\"m9 12 2 2 4-4\",\"key\":\"dzmm74\"}]],\"className\":\"lucide-shield-check h-5 w-5\",\"aria-hidden\":\"true\"}],\" \",\"PROOF LEDGER / 交付证据\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-5 max-w-xl text-4xl font-semibold leading-tight md:text-5xl\",\"children\":\"不是自述式能力列表，而是可以从实现、测试与线上运行中追溯的事实。\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-black/30\",\"children\":[[\"$\",\"div\",\"可恢复\",{\"classNam