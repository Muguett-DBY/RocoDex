w-right h-5 w-5\"}]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 py-7 lg:border-t-0 lg:pl-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#78858a]\",\"children\":[[\"$\",\"$Ld\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M9 17H7A5 5 0 0 1 7 7h2\",\"key\":\"8i5ue5\"}],[\"path\",{\"d\":\"M15 7h2a5 5 0 1 1 0 10h-2\",\"key\":\"1b9ql8\"}],[\"line\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"12\",\"y2\":\"12\",\"key\":\"1jonct\"}]],\"className\":\"lucide-link2 lucide-link-2 h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"证据与复现\"]}],[\"$\",\"div\",null,{\"className\":\"mt-5 border-t border-white/10\",\"children\":[[[\"$\",\"$L25\",\"lab-/lab/agent-replay\",{\"href\":\"/lab/agent-replay\",\"className\":\"flex items-start justify-between gap-5 border-b border-white/10 py-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\",\"children\":\"$L27\"}],\"$L28\",\"$L29\"],[],[\"$L2a\",\"$L2b\"]]}]]}]]}]]}]}]\n21:[\"$\",\"article\",null,{\"className\":\"bg-[#080a0c]\",\"children\":[[[\"$\",\"section\",null,{\"id\":\"model\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"01 / 模型\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"创作不是一个输入框。\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"对话会分支，生成会排队，素材会回溯到提示词。系统因此围绕可恢复的会话、任务与资产实体设计，而不是围绕一个聊天组件。\"}],[\"$\",\"p\",null,{\"children\":\"我不希望创作过程被压扁成“输入一次，等一个答案”。一个想法往往要经过几次改写、参考图和方向分叉，最后才知道哪一条值得留下。会话保存上下文，分支保存试错，资产保存结果和来源，这三个对象分开之后，用户才有机会回到某个决定之前重新走一遍。\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"id\":\"media\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"02 / 媒体\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"元数据走 D1，大对象走 R2。\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"图片和视频任务保留状态、尺寸、种子和错误；素材上传检查 Magic Bytes；界面轮询有失败上限，避免永远旋转的任务。\"}],[\"$\",\"p\",null,{\"children\":\"这些细节看似偏后台，却会直接影响创作体验。生成失败时，用户需要看到失败发生在哪一步，而不是把一个加载圈留到第二天；刷新页面后，已经完成的素材也应该能被找回来。D1 和 R2 的分工，最终要在这种日常操作里体现出来。\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"id\":\"safety\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"03 / 安全\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"私人系统也需要明确的滥用边界。\"}],[\"$\",\"div\",null,{\"className\