\":\"grid gap-6 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"承担角色\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"产品、交互、全栈与安全\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"运行状态\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"私有生产系统\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"技术系统\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"React 19 · Vite · Cloudflare Functions · D1 · R2 · Zod\"}]]}]]}]]}]}]\n8:[\"$\",\"$L21\",null,{\"caseStudy\":{\"publicationStatus\":\"published\",\"revision\":2,\"publishedAt\":\"2026-01-01\",\"updatedAt\":\"2026-08-27\",\"slug\":\"creative-workbench\",\"projectId\":\"design\",\"year\":\"2026\",\"title\":{\"zh\":\"CSTD Design 创作工作台\",\"en\":\"CSTD Design creative workbench\"},\"kicker\":{\"zh\":\"生成式媒体 / 私有工作流\",\"en\":\"Generative media / private workflow\"},\"summary\":{\"zh\":\"一个给自己使用的中文创作工作台：对话可以分支，图片和视频任务可以恢复，素材始终找得到来源。\",\"en\":\"A private Chinese workbench where conversations branch, image and video jobs can recover, and every asset keeps its source.\"},\"film\":{\"durationSeconds\":100,\"logline\":{\"zh\":\"把生成式创作从一个输入框扩展成可分支、可追溯的私人工作台。\",\"en\":\"Expanding generative creation from one prompt box into a private, traceable branching workbench.\"},\"beats\":[{\"id\":\"prompt-box\",\"phase\":\"problem\",\"title\":{\"zh\":\"创作不是一次请求\",\"en\":\"Creation is not one request\"},\"detail\":{\"zh\":\"文字、图片、视频、版本和回退无法被压进单一对话流而不丢失上下文。\",\"en\":\"Text, images, video, versions, and retries cannot fit into one chat stream without losing context.\"},\"signal\":{\"zh\":\"素材必须成为一等对象\",\"en\":\"Artifacts must be first-class objects\"}},{\"id\":\"private-boundaries\",\"phase\":\"constraint\",\"title\":{\"zh\":\"私人系统也有滥用边界\",\"en\":\"Private tools still need abuse boundaries\"},\"detail\":{\"zh\":\"流式任务、媒体上传、存储成本与错误重试都需要明确额度和状态。\",\"en\":\"Streaming jobs, media uploads, storage cost, and retries need explicit limits and state.\"},\"signal\":{\"zh\":\"自由创作需要清晰约束\",\"en\":\"Creative freedom needs clear constraints\"}},{\"id\":\"unified-model\",\"phase\":\"architecture\",\"title\":{\"zh\":\"消息、分支与素材统一建模\",\"en\":\"Model messages, branches, and artifacts together\"},\"detail\":{\"zh\":\"会话保存意图，分支保存探索，素材记录生成来源和持久地址。\",\"en\":\"Conversations retain intent, branches preserve exploration, and artifacts retain provenance and durable addresses.\"},\"signal\":{\"zh\":\"每次生成都可寻址\",\"en\":\"Every generation is addressable\"}},{\"id\":\"storage-split\",\"phase\":\"decision\",\"title\":{\"zh\":\"元数据与大对象分层\",\"en\":\"Separate metadata from large objects\"},\"detail\":{\"zh\":\"D1 负责关系和状态，R2 负责图片与视频，队列负责耗时工作。\",\"en\":\"D1 owns relations and state, R2 owns images and video, and queues own long-running work.\"},\"signal\":{\"zh\":\"存储结构跟随访问模式\",\"en\":\"Storage follows access patterns\"}},{\"id\":\"creative-proof\",\"phase\":\"outcome\",\"title\":{\"zh\":\"创作过程可以被恢复\",\"en\":\"The creative process can be resumed\"},\"detail\":{\"zh\":\"刷新、分支切换与失败重试都回到同一份持久状态，不依赖浏览器偶然记忆。\",\"en\":\"Refreshes, branch switches, and retries return to one durable state rather than accidental browser memory.\"},\"signal\":{\"zh\":\"工作台记得每次选择\",\"en\":\"The workbench remembers every choice\"}}]},\"role\":{\"zh\":\"产品、交互、全栈与安全\",\"en\":\"Product, interaction, full stack, and security\"},\"image\":{\"src\":\"/cstd-projects/design.png\",\"alt\":{\"zh\":\"CSTD Design 创作工作台\",\"en\":\"CSTD Design creative workbench\"},\"position\":\"50% 20%\"},\"technologies\":[\"React 19\",\"Vite\",\"Cloudflare Functions\",\"D1\",\"R2\",\"Zod\"],\"metrics\":[{\"value\":\"4\",\"label\":{\"zh\":\"参考图上限\",\"en\":\"reference images\"}},{\"value\":\"3\",\"label\":{\"zh\":\"媒体工作流\",\"en\":\"media workflows\"}},{\"value\":\"D1/R2\",\"label\":{\"zh\":\"元数据与媒体分层\",\"en\":\"metadata and media split\"}}],\"evidence\":[{\"label\":{\"zh\":\"可恢复\",\"en\":\"Recoverable\"},\"detail\":{\"zh\":\"消息线程、分支和任务状态跨刷新持久化。\",\"en\":\"Threads, branches, and job state survive refreshes.\"}},{\"label\":{\"zh\":\"可访问\",\"en\":\"Accessible\"},\"detail\":{\"zh\":\"键盘搜索、明确状态和自定义确认流程覆盖高频操作。\",\"en\":\"Keyboard search, explicit states, and confirmation flows cover repeated actions.\"}},{\"label\":{\"zh\":\"可验证\",\"en\":\"Verifiable\"},\"detail\":{\"zh\":\"Vitest、Testing Library 与 CI/CD 持续检查。\",\"en\":\"Vitest, Testing Library, and CI/CD provide continuous checks.\"}}],\"capabilityIds\":[\"ai-creation\",\"product-surfaces\"],\"relatedNoteSlugs\":[],\"relatedLabSlugs\":[\"agent-replay\",\"render-lab\"],\"artifacts\":[{\"kind\":\"lab\",\"label\":{\"zh\":\"可复现实验 / agent-replay\",\"en\":\"Reproducible lab / agent-replay\"},\"detail\":{\"zh\":\"在浏览器中重放核心机制。\",\"en\":\"Replay the core mechanism in the browser.\"},\"href\":{\"zh\":\"/lab/agent-replay\",\"en\":\"/en/lab/agent-replay\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"lab\",\"label\":{\"zh\":\"可复现实验 / render-lab\",\"en\":\"Reproducible lab / render-lab\"},\"detail\":{\"zh\":\"在浏览器中重放核心机制。\",\"en\":\"Replay the core mechanism in the browser.\"},\"href\":{\"zh\":\"/lab/render-lab\",\"en\":\"/en/lab/render-lab\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"release\",\"label\":{\"zh\":\"CSTD Design 发布提交\",\"en\":\"CSTD Design release commit\"},\"detail\":{\"zh\":\"提交 1ed2554 记录私人 API 缓存证据与发布状态。\",\"en\":\"Commit 1ed2554 records private API cache evidence and release state.\"},\"href\":{\"zh\":\"https://github.com/Muguett-DBY/cstd-design/commit/1ed2554e7556feda0819e64f20f61bd740f9b588\",\"en\":\"https://github.com/Muguett-DBY/cstd-design/commit/1ed2554e7556feda0819e64f20f61bd740f9b588\"},\"verifiedAt\":\"2026-08-06\"}],\"toc\":[{\"id\":\"model\",\"eyebrow\":{\"zh\":\"01 / 模型\",\"en\":\"01 / Model\"},\"title\":{\"zh\":\"创作不是一个输入框。\",\"en\":\"Creation is more than one prompt box.\"}},{\"id\":\"media\",\"eyebrow\":{\"zh\":\"02 / 媒体\",\"en\":\"02 / Media\"},\"title\":{\"zh\":\"元数据走 D1，大对象走 R2。\",\"en\":\"Metadata goes to D1; large objects go to R2.\"}},{\"id\":\"safety\",\"eyebrow\":{\"zh\":\"03 / 安全\",\"en\":\"03 / Security\"},\"title\":{\"zh\":\"私人系统也需要明确的滥用边界。\",\"en\":\"Private tools still need abuse boundaries.\"}}],\"status\":{\"zh\":\"私有生产系统\",\"en\":\"Private production system\"}},\"locale\":\"zh\"}]\n9:[\"$\",\"section\",null,{\"data-cstd-proof-mesh\":true,\"data-cstd-proof-mesh-size\":\"case\",\"aria-labelledby\":\"proof-mesh-creative-workbench\",\"className\":\"border-y border-white/12 bg-[#050709]/92 px-5 py-10 text-[#f2efe7] backdrop-blur-xl md:px-10 lg:px-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1540px]\",\"children\":[[\"$\",\"header\",null,{\"className\":\"flex flex-wrap items-end justify-between gap-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"flex items-center gap-2 font-mono text-[11px] font-black text-[#3dff8f]\",\"children\":[[\"$\",\"$L1f\",null,{\"iconNode\":[[\"path\",{\"d\":\"M4.9 16.1C1 12.2 1 5.8 4.9 1.9\",\"key\":\"s0qx1y\"}],[\"path\",{\"d\":\"M7.8 4.7a6.14 6.14 0 0 0-.8 7.5\",\"key\":\"1idnkw\"}],[\"circle\",{\"cx\":\"12\",\"cy\":\"9\",\"r\":\"2\",\"key\":\"1092wv\"}],[\"path\",{\"d\":\"M16.2 4.8c2 2 2.26 5.11.8 7.47\",\"key\":\"ojru2q\"}],[\"path\",{\"d\":\"M19.1 1.9a9.96 9.96 0 0 1 0 14.1\",\"key\":\"rhi7fg\"}],[\"path\",{\"d\":\"M9.5 18h5\",\"key\":\"mfy3pd\"}],[\"path\",{\"d\":\"m8 22 4-11 4 11\",\"key\":\"25yftu\"}]],\"className\":\"lucide-radio-tower h-4 w-4\",\"aria-hidden\":\"true\"}],\" LIVE PROOF MESH / BUILD-TIME\"]}],[\"$\",\"h2\",null,{\"id\":\"proof-mesh-creative-workbench\",\"className\":\"mt-3 text-2xl font-semibold md:text-3xl\",\"children\":\"不是项目声明，而是可追踪的证据网络。\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-5 font-mono text-[11px] font-black text-[#7783