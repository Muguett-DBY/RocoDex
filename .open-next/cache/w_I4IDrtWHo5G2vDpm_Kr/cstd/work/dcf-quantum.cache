ll,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Windows x64 安装包包含本地浏览器 GUI、独立工作进程、安全取消和离线体验；服务只监听本机回环地址。\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"桌面交付的难点不只是把 Python 打成一个 exe。启动、取消、缓存目录、错误提示和没有网络时的行为都要在最终机器上试过。把服务限制在回环地址，是因为这个工具的目标是本机研究，不需要把数据接口暴露到局域网。\\\"}]]}]]}]]}]}]],\\\"\\\\n\\\",null]}]\\n\"])</script><script>self.__next_f.push([1,\"23:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"border-b border-[#f4d431]/40 bg-[#f4d431] px-5 py-20 text-[#050709] md:px-10 lg:px-16 lg:py-24\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-[1320px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-8 lg:grid-cols-[0.75fr_1.25fr]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono text-[11px] font-black\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Ld\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\\\",\\\"key\\\":\\\"oel41y\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"m9 12 2 2 4-4\\\",\\\"key\\\":\\\"dzmm74\\\"}]],\\\"className\\\":\\\"lucide-shield-check h-5 w-5\\\",\\\"aria-hidden\\\":\\\"true\\\"}],\\\" \\\",\\\"PROOF LEDGER / 交付证据\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"mt-5 max-w-xl text-4xl font-semibold leading-tight md:text-5xl\\\",\\\"children\\\":\\\"不是自述式能力列表，而是可以从实现、测试与线上运行中追溯的事实。\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-t border-black/30\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"口径\\\",{\\\"className\\\":\\\"grid gap-3 border-b border-black/30 py-5 sm:grid-cols-[3rem_10rem_1fr] sm:items-start\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"