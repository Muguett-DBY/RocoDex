ink-0 px-3 py-2 font-mono text-[11px] font-black text-[#9aa4a8] hover:text-[#f4d431]\" href=\"/en/now\">Now</a></nav></header><div class=\"relative z-10\"><main id=\"cstd-main\"><header data-cstd-page-hero=\"true\" class=\"relative flex overflow-hidden border-b border-white/15 min-h-[68svh]\" style=\"view-transition-name:cstd-note-evidence-first-ai-research\"><img data-cstd-page-hero-image=\"true\" alt=\"A source-constrained data vault\" loading=\"eager\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent\" src=\"/cstd-universe/cstd-data-vault-v1.webp\"/><div data-cstd-page-hero-overlay=\"true\" aria-hidden=\"true\" class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(5,7,9,0.96)_0%,rgba(5,7,9,0.78)_46%,rgba(5,7,9,0.18)_100%)]\"></div><div data-cstd-page-hero-grid=\"true\" aria-hidden=\"true\" class=\"absolute inset-0 opacity-20 [background-image:linear-gradient(rgba(255,255,255,0.09)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.09)_1px,transparent_1px)] [background-size:64px_64px]\"></div><div data-cstd-page-hero-material=\"true\" aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\"></div><div data-cstd-page-hero-artifacts=\"true\" aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 overflow-hidden\"><div data-cstd-deep-artifact=\"neon\" class=\"cstd-deep-neon-rig\"><span class=\"cstd-deep-neon-index\">CSTD / TRACE 09</span><span class=\"cstd-deep-neon-coordinate\">-33.8688 / 151.2093</span><span class=\"cstd-deep-neon-signal\"><i></i><i></i><i></i><i></i><i></i><i></i></span><span class=\"cstd-deep-neon-lock\">SIGNAL LOCKED</span></div><div data-cstd-deep-artifact=\"underworld\" class=\"cstd-deep-underworld-stele\"><span class=\"cstd-deep-underworld-kicker\">UNDERWORLD ARCHIVE / FORGE 017</span><span class=\"cstd-deep-underworld-seal\"><i></i><i></i><b>V</b></span><span class=\"cstd-deep-underworld-oath\">TRIED BELOW · RETURNED WHOLE</span><span class=\"cstd-deep-underworld-cuts\"><i></i><i></i><i></i><i></i><i></i></span></div><div data-cstd-deep-artifact=\"astral\" class=\"cstd-deep-astral-compass\"><span class=\"cstd-deep-astral-kicker\">ASTRAL JOURNAL / ROLL 017</span><span class=\"cstd-deep-astral-die\"><i></i><b>20</b><i></i></span><span class=\"cstd-deep-astral-route\"><i></i><i></i><i></i><i></i><i></i></span><span class=\"cstd-deep-astral-oath\">CHOICE INKED · LEGACY CARRIED</span></div></div><div data-cstd-page-hero-content=\"true\" class=\"relative mx-auto flex w-full max-w-[1540px] flex-col justify-end px-5 pb-16 pt-28 md:px-10 lg:px-16 lg:pb-20\"><div class=\"max-w-5xl\"><p data-cstd-page-hero-eyebrow=\"true\" class=\"font-mono text-[11px] font-black text-[#f4d431]\">AI SYSTEMS / EVIDENCE-FIRST INTELLIGENCE</p><h1 data-cstd-page-hero-title=\"true\" class=\"mt-6 text-balance text-[2.375rem] font-semibold leading-[0.94] tracking-[0] text-white sm:text-5xl md:text-7xl md:leading-[0.9] lg:text-8xl xl:text-[7rem]\">Refresh evidence before asking the model to speak</h1><p data-cstd-page-hero-summary=\"true\" class=\"mt-7 max-w-3xl text-lg leading-8 text-[#c3c9cb] md:text-xl md:leading-9\">In company research, stale facts, duplicate jobs, and conclusions without a clear source usually cost more than tokens.</p></div><dl data-cstd-page-hero-metrics=\"true\" class=\"mt-10 grid max-w-4xl grid-cols-2 border-y border-white/20 md:grid-cols-3\"><div class=\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\"><dt class=\"font-mono text-[11px] font-black uppercase text-[#8a969b]\">Reading time</dt><dd class=\"mt-2 whitespace-nowrap text-xl font-semibold text-[#24e0ff] sm:text-2xl\">13 min</dd></div><div class=\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\"><dt class=\"font-mono text-[11px] font-black uppercase text-[#8a969b]\">Published</dt><dd class=\"mt-2 whitespace-nowrap text-xl font-semibold text-[#24e0ff] sm:text-2xl\">6 Aug 2026</dd></div><div class=\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\"><dt class=\"font-mono text-[11px] font-black uppercase text-[#8a969b]\">Series</dt><dd class=\"mt-2 whitespace-nowrap text-xl font-semibold text-[#24e0ff] sm:text-2xl\">Evidence-first intelligence</dd></div></dl><div data-cstd-page-hero-scroll=\"true\" aria-hidden=\"true\" class=\"mt-9 flex items-center gap-3 font-mono text-[11px] font-black text-[#748187]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-down h-3.5 w-3.5 animate-bounce text-[#f4d431]\" aria-hidden=\"true\"><path d=\"M12 5v14\"></path><path d=\"m19 12-7 7-7-7\"></path></svg> <!-- -->SCROLL / CONTINUE TRACE</div></div></header><article data-cstd-reading-document=\"true\" class=\"bg-[#f1eee5] text-[#111315]\"><div class=\"mx-auto grid max-w-[1320px] gap-12 px-5 py-16 md:px-10 lg:grid-cols-[13rem_minmax(0,46rem)] lg:justify-center lg:gap-20 lg:px-16 lg:py-24\"><aside class=\"lg:sticky lg:top-28 lg:h-fit\"><a class=\"inline-flex items-center gap-2 font-mono text-[11px] font-black text-[#0b6473] hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black\" href=\"/en/notes\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg> <!-- -->All notes</a><nav aria-label=\"Article contents\" class=\"mt-8 hidden border-l border-black/20 pl-4 lg:block\"><a href=\"#separate\" class=\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\"><span class=\"mr-2 text-[#0b6473]\">0<!-- -->1</span>Collection, synthesis, and publishing are different workloads</a><a href=\"#fingerprint\" class=\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\"><span class=\"mr-2 text-[#0b6473]\">0<!-- -->2</span>Cache keys should describe evidence, not time</a><a href=\"#stale\" class=\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\"><span class=\"mr-2 text-[#0b6473]\">0<!-- -->3</span>Stale callbacks must lose write authority</a></nav><p class=\"mt-7 font-mono text-[11px] font-black leading-5 text-black/75\">REVISION<!-- --> <!-- -->2<br/>UPDATED <!-- -->2026-08-27</p><button type=\"button\" class=\"mt-6 inline-flex items-center gap-2 border-b border-black/35 pb-1 font-mono text-[11px] font-black text-black/75 hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-quote h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path><path d=\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path></svg>COPY CITATION</button></aside><div>\n<section id=\"separate\" class=\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\"><p class=\"font-mono text-[11px] font-black text-[#0b6473]\">SEPARATE</p><h2 class=\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\">Collection, synthesis, and publishing are different workloads</h2><div class=\"cstd-mdx-prose cstd-mdx-prose-light\"><p>Public data collection belongs in scheduled batches, model synthesis in retryable background jobs, and page requests in reading published state. Binding them to one HTTP request turns the slowest stage into everybody&#x27;s timeout.</p><p>I split a research request into three stages that can fail independently. If collection fails, the system can keep the last dated evidence instead of returning a new report without sources. If synthesis fails, it can retry without collecting everything again. If publication fails, the generated version should still be inspectable. The separation makes errors more specific and costs easier to explain.</p></div></section><section id=\"fingerprint\" class=\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\"><p class=\"font-mono text-[11px] font-black text-[#0b6473]\">FINGERPRINT</p><h2 class=\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\">Cache keys should describe evidence, not time</h2><div class=\"cstd-mdx-prose cstd-mdx-prose-light\"><p>Template version plus company evidence fingerprint forms the reusable unit. A scheduled run does not justify a new model call when normalized evidence has not changed.</p><p>The fingerprint is not only about saving tokens. It turns “the input did not change, so reuse is allowed” into a checkable rule. A template update, source change, or newly filled gap changes the fingerprint and creates a new version; a routine schedule does not invent a new conclusion.</p><div data-cstd-code-sample=\"true\" data-cstd-code-tone=\"light\" class=\"mt-8 overflow-hidden bg-[#0a0c0e] text-[#d9f9ff] shadow-[12px_12px_0_#e3b800]\"><div class=\"flex items-center justify-between gap-4 border-b border-white/10 px-5 py-3 font-mono text-[11px] font-black text-[#24e0ff]\"><span>REUSE KEY<!-- --> / <!-- -->text</span><button type=\"button\" aria-label=\"Copy code\" title=\"Copy code\" class=\"flex h-9 w-9 items-center justify-center border border-white/15 text-[#91a0a5] transition-colors hover:border-[#24e0ff] hover:text-[#24e0ff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-copy h-4 w-4\" aria-hidden=\"true\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg></button></div><figure data-rehype-pretty-code-figure=\"\"><pre tabindex=\"0\" data-language=\"text\" data-theme=\"github-dark-dimmed\"><code data-language=\"text\" data-theme=\"github-dark-dimmed\" style=\"display:grid\"><span data-line=\"\"><span>result_key = template_version + evidence_fingerprint</span></span></code></pre></figure></div></div></section><section id=\"stale\" class=\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\"><p class=\"font-mono text-[11px] font-black text-[#0b6473]\">STALE</p><h2 class=\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\">Stale callbacks must lose write authority</h2><div class=\"cstd-mdx-prose cstd-mdx-prose-light\"><p>A run token is created with each job and atomically claimed before publication. Once a newer run supersedes it, an old callback may be logged but cannot overwrite the latest report.</p><p>This also fixes an easy-to-miss interface problem: completed is not the same as current. An old job may finish after it has stopped being the report a user is looking at. Showing the run token, version, and publication time together makes that difference visible.</p></div></section><nav aria-label=\"Curated paths\" class=\"mt-14 border-t border-black/20 pt-7\" data-cstd-note-paths=\"true\"><p class=\"font-mono text-[11px] font-black text-black/55\">CURATED PATHS</p><div class=\"mt-4 grid gap-3 sm:grid-cols-2\"><a class=\"group border-l-2 border-[#0b6473] py-1 pl-4 text-sm font-semibold leading-6 text-black/70 transition-colors hover:border-black hover:text-black\" href=\"/en/topics/evidence-first-ai\">02<!-- --> / <!-- -->Evidence-first AI</a></div></nav></div></div></article><section class=\"border-b border-white/12 bg-[#080a0c] px-5 py-20 md:px-10 lg:px-16\"><div class=\"mx-auto max-w-[1320px]\"><div class=\"flex items-center gap-3 font-mono text-[11px] font-black text-[#24e0ff]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-link2 lucide-link-2 h-4 w-4\" aria-hidden=\"true\"><path d=\"M9 17H7A5 5 0 0 1 7 7h2\"></path><path d=\"M15 7h2a5 5 0 1 1 0 10h-2\"></path><line x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"></line></svg> <!-- -->RELATED SHIPPED SYSTEMS</div><p class=\"mt-5 max-w-2xl text-2xl font-semibold text-white md:text-3xl\">This note comes from design and delivery work in the following systems.</p><div class=\"mt-10 border-t border-white/15\"><a class=\"group flex items-center justify-between gap-6 border-b border-white/15 py-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\" href=\"/en/work/alpha-research-system\"><div><p class=\"font-mono text-[11px] font-black text-[#68757b]\">EVIDENCE PIPELINE / DECISION WORKSPACE</p><p class=\"mt-2 text-xl font-semibold text-white md:text-2xl\">CSTD Alpha research system</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right h-5 w-5 shrink-0 text-[#f4d431] transition-transform group-hover:-translate-y-1 group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div></div></section><a class=\"group 