12H5\",\"key\":\"x3x0zl\"}]],\"className\":\"lucide-arrow-left h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"All notes\"]}],[\"$\",\"nav\",null,{\"aria-label\":\"Article contents\",\"className\":\"mt-8 hidden border-l border-black/20 pl-4 lg:block\",\"children\":[[\"$\",\"a\",\"separate\",{\"href\":\"#separate\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",1]}],\"Collection, synthesis, and publishing are different workloads\"]}],[\"$\",\"a\",\"fingerprint\",{\"href\":\"#fingerprint\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",2]}],\"Cache keys should describe evidence, not time\"]}],[\"$\",\"a\",\"stale\",{\"href\":\"#stale\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",3]}],\"Stale callbacks must lose write authority\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-7 font-mono text-[11px] font-black leading-5 text-black/75\",\"children\":[\"REVISION\",\" \",2,[\"$\",\"br\",null,{}],\"UPDATED \",\"2026-08-27\"]}],[\"$\",\"$L21\",null,{\"value\":\"Refresh evidence before asking the model to speak — Custard, https://custard.top/en/notes/evidence-first-ai-research (2026-08-27)\",\"label\":\"COPY CITATION\"}]]}],[\"$\",\"div\",null,{\"children\":[[null,\"\\n\",[[\"$\",\"section\",null,{\"id\":\"separate\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"SEPARATE\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"Collection, synthesis, and publishing are different workloads\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Public data collection belongs in scheduled batches, model synthesis in retryable background jobs, and page requests in reading published state. Binding them to one HTTP request turns the slowest stage into everybody's timeout.\"}],[\"$\",\"p\",null,{\"children\":\"I split a research request into three stages that can fail independently. If collection fails, the system can keep the last dated evidence instead of returning a new report without sources. If synthesis fails, it can retry without collecting everything again. If publication fails, the generated version should still be inspectable. The separation makes errors more specific and costs easier to explain.\"}]]}]]}],[\"$\",\"section\",null,{\"id\":\"fingerprint\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"FINGERPRINT\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"Cache keys should describe evidence, not time\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Template version plus company evidence fingerprint forms the reusable unit. A scheduled run does not justify a new model call when normalized evidence has not changed.\"}],\"$L22\",\"$L23\"]}]]}],\"$L24\"]],\"$L25\"]}]]}]}]\na:[\"$\",\"section\",null,{\"className\":\"border-b border-white/12 bg-[#080a0c] px-5 py-20 md:px-10 lg:px-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[[\"$\",\"$L1f\",null,{\"iconNode\