ops:children:props:children:5:props:children:0:props:iconNode\",\"className\":\"lucide-arrow-left h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"All notes\"]}],[\"$\",\"nav\",null,{\"aria-label\":\"Article contents\",\"className\":\"mt-8 hidden border-l border-black/20 pl-4 lg:block\",\"children\":[[\"$\",\"a\",\"separate\",{\"href\":\"#separate\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",1]}],\"Collection, synthesis, and publishing are different workloads\"]}],[\"$\",\"a\",\"fingerprint\",{\"href\":\"#fingerprint\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",2]}],\"Cache keys should describe evidence, not time\"]}],[\"$\",\"a\",\"stale\",{\"href\":\"#stale\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",3]}],\"Stale callbacks must lose write authority\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-7 font-mono text-[11px] font-black leading-5 text-black/75\",\"children\":[\"REVISION\",\" \",2,[\"$\",\"br\",null,{}],\"UPDATED \",\"2026-08-27\"]}],[\"$\",\"$L25\",null,{\"value\":\"Refresh evidence before asking the model to speak — Custard, https://custard.top/en/notes/evidence-first-ai-research (2026-08-27)\",\"label\":\"COPY CITATION\"}]]}],[\"$\",\"div\",null,{\"children\":[[null,\"\\n\",[[\"$\",\"section\",null,{\"id\":\"separate\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"SEPARATE\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"Collection, synthesis, and publishing are different workloads\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Public data collection belongs in scheduled batches, model synthesis in retryable background jobs, and page requests in reading published state. Binding them to one HTTP request turns the slowest stage into everybody's timeout.\"}],[\"$\",\"p\",null,{\"children\":\"I split a research request into three stages that can fail independently. If collection fails, the system can keep the last dated evidence instead of returning a new report without sources. If synthesis fails, it can retry without collecting everything again. If publication fails, the generated version should still be inspectable. The separation makes errors more specific and costs easier to explain.\"}]]}]]}],[\"$\",\"section\",null,{\"id\":\"fingerprint\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"FINGERPRINT\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"Cache keys should describe evidence, not time\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Template version plus company evidence fingerprint forms the reusable unit. A scheduled run does not justify a new model call when normalized evidence has not changed.\"}],\"$L26\",\"$L27\"]}]]}],\"$L28\"]],\"$L29\"]}]]}]}]\n21:[\"$\",\"section\",null,{\"className\":\"border-b border-white/12 bg-[#080a0c] px-5 py-20 md:px-10 lg:px-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M9 17H7A5 5 0 0 1 7 7h2\",\"key\":\"8i5ue5\"}],[\"path\",{\"d\":\"M15 7h2a5 5 0 1 1 0 10h-2\",\"key\":\"1b9ql8\"}],[\"line\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"12\",\"y2\":\"12\",\"key\":\"1jonct\"}]],\"className\":\"lucide-link2 lucide-link-2 h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"RELATED SHIPPED SYSTEMS\"]}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-2xl text-2xl font-semibold text-white md:text-3xl\",\"children\":\"This note comes from design and delivery work in the following systems.\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 border-t border-white/15\",\"children\":[[\"$\",\"$L24\",\"alpha-research-system\",{\"href\":\"/en/work/alpha-research-system\",\"className\":\"group flex items-center justify-between gap-6 border-b border-white/15 py-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#68757b]\",\"children\":\"EVIDENCE PIPELINE / DECISION WORKSPACE\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xl font-semibold text-white md:text-2xl\",\"children\":\"CSTD Alpha research system\"}]]}],[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M7 7h10v10\",\"key\":\"1tivn9\"}],[\"path\",{\"d\":\"M7 17 17 7\",\"key\":\"1vkiza\"}]],\"className\":\"lucide-arrow-up-right h-5 w-5 shrink-0 text-[#f4d431] transition-transform group-hover:-translate-y-1 group-hover:translate-x-1\",\"aria-hidden\":\"true\"}]]}]]}]]}]}]\n22:[\"$\",\"$L24\",null,{\"href\":\"/en/notes/host-boundaries-in-one-next-deployment\",\"className\":\"group block bg-[#f4d431] px-5 py-16 text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-black md:px-10 lg:px-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto flex max-w-[1320px] items-end justify-between gap-8\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black\",\"children\":\"CONTINUE READING\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-5xl\",\"children\":\"One Next.js deployment, two genuinely separate websites\"}]]}],[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$21:props:children:props:children:2:props:children:0:props:children:1:props:iconNode\",\"className\":\"lucide-arrow-up-right h-8 w-8 shrink-0 transition-transform group-hover:-translate-y-2 group-hover:translate-x-2\",\"aria-hidden\":\"true\"}]]}]}]\n23:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"TechArticle\\\",\\\"headline\\\":\\\"Refresh evidence before asking the model to speak\\\",\\\"description\\\":\\\"In company research, stale facts, duplicate jobs, and conclusions without a clear source usually cost more than tokens.\\\",\\\"datePublished\\\":\\\"2026-08-06\\\",\\\"inLanguage\\\":\\\"en-AU\\\",\\\"image\\\":\\\"https://custard.top/cstd-universe/cstd-data-vault-v1.webp\\\",\\\"url\\\":\\\"https://custard.top/en/notes/evidence-first-ai-research\\\",\\\"author\\\":{\\\"@type\\\":\\\"Person\\\",\\\"name\\\":\\\"Custard\\\",\\\"url\\\":\\\"https://custard.top/en/about\\\"}}\"}}]\n2a:I[89,[\"/_next/static/chunks/3bpg1zucvhmqd.js\",\"/_next/static/chunks/1i9zhf0udey6-.js\",\"/_next/static/chunks/0o4mbv36vpg4h.js\",\"/_next/static/chunks/0-dtv20hsjo64.js\",\"/_next/static/chunks/17tp06dc0ta4c.js\"],\"CopyCodeButton\"]\n26:[\"$\",\"p\",null,{\"children\":\"The fingerprint is not only about saving tokens. It turns “the input did not change, so reuse is allowed” into a checkable rule. A template update, source change, or newly filled gap changes the fingerprint and creates a new version; a routine schedule does not invent a new conclusion.\"}]\n27:[\"$\",\"div\",null,{\"data-cstd-code-sample\":true,\"data-cstd-code-tone\":\"light\",\"className\":\"mt-8 overflow-hidden bg-[#0a0c0e] text-[#d9f9ff] shadow-[12px_12px_0_#e3b800]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between gap-4 border-b border-white/10 px-5 py-3 font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"REUSE KEY\",\" / \",\"text\"]}],[\"$\",\"$L2a\",null,{\"value\":\"result_key = template_version + evidence_fingerprint\",\"label\":\"Copy code\"}]]}],[\"$\",\"figure\",null,{\"data-rehype-pretty-code-figure\":\"\",\"children\":[\"$\",\"pre\",null,{\"tabIndex\":\"0\",\"data-language\":\"text\",\"data-theme\":\"github-dark-dimmed\",\"children\":[\"$\",\"code\",null,{\"data-language\":\"text\",\"data-theme\":\"github-dark-dimmed\",\"style\":{\"display\":\"grid\"},\"children\":[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"children\":\"result_key = template_version + evidence_fingerprint\"}]}]}]}]}]]}]\n28:[\"$\",\"section\",null,{\"id\":\"stale\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"STALE\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"Stale callbacks must lose write authority\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"A run token is created with each job and atomically claimed before publication. Once a newer run supersedes it, an old callback may be logged but cannot overwrite the latest report.\"}],[\"$\",\"p\",null,{\"children\":\"This also fixes an easy-to-miss interface problem: completed is not the same as current. An old job may finish after it has stopped being the report a user is looking at. Showing the run token, versio