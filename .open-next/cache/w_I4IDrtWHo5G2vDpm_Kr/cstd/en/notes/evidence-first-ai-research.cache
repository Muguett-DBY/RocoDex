l,{\\\"tabIndex\\\":\\\"0\\\",\\\"data-language\\\":\\\"text\\\",\\\"data-theme\\\":\\\"github-dark-dimmed\\\",\\\"children\\\":[\\\"$\\\",\\\"code\\\",null,{\\\"data-language\\\":\\\"text\\\",\\\"data-theme\\\":\\\"github-dark-dimmed\\\",\\\"style\\\":{\\\"display\\\":\\\"grid\\\"},\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"data-line\\\":\\\"\\\",\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"result_key = template_version + evidence_fingerprint\\\"}]}]}]}]}]]}]\\n28:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"stale\\\",\\\"className\\\":\\\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#0b6473]\\\",\\\"children\\\":\\\"STALE\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\\\",\\\"children\\\":\\\"Stale callbacks must lose write authority\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-light\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"A run token is created with each job and atomically claimed before publication. Once a newer run supersedes it, an old callback may be logged but cannot overwrite the latest report.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"This also fixes an easy-to-miss interface problem: completed is not the same as current. An old job may finish after it has stopped being the report a user is looking at. Showing the run token, version, and publication time together makes that difference visible.\\\"}]]}]]}]\\n29:[\\\"$\\\",\\\"nav\\\",null,{\\\"aria-label\\\":\\\"Curated paths\\\",\\\"className\\\":\\\"mt-14 border-t border-black/20 pt-7\\\",\\\"data-cstd-note-paths\\\":true,\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-black/55\\\",\\\"children\\\":\\\"CURATED PATHS\\\"}],[\\\"$\\\",\\\"