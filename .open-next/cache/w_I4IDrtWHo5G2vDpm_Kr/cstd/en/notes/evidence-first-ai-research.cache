],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\\\",\\\"children\\\":\\\"Collection, synthesis, and publishing are different workloads\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-light\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Public data collection belongs in scheduled batches, model synthesis in retryable background jobs, and page requests in reading published state. Binding them to one HTTP request turns the slowest stage into everybody's timeout.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"I split a research request into three stages that can fail independently. If collection fails, the system can keep the last dated evidence instead of returning a new report without sources. If synthesis fails, it can retry without collecting everything again. If publication fails, the generated version should still be inspectable. The separation makes errors more specific and costs easier to explain.\\\"}]]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"fingerprint\\\",\\\"className\\\":\\\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#0b6473]\\\",\\\"children\\\":\\\"FINGERPRINT\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\\\",\\\"children\\\":\\\"Cache keys should describe evidence, not time\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-light\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Template version plus company evidence fingerprint forms the reusable unit. A scheduled run does not justify a new model call when normalized evidence has not changed.\\\"}],\\\"$L26\\\",\\\"$L27\\\"]}]]}],\\\"$L28\\\"]],\\\"$L29\\\"]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\