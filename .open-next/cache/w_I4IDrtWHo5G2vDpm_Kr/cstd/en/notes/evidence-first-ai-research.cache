\"a\",\"fingerprint\",{\"href\":\"#fingerprint\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",2]}],\"Cache keys should describe evidence, not time\"]}],[\"$\",\"a\",\"stale\",{\"href\":\"#stale\",\"className\":\"mt-4 block font-mono text-[11px] font-black leading-5 text-black/75 hover:text-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 text-[#0b6473]\",\"children\":[\"0\",3]}],\"Stale callbacks must lose write authority\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-7 font-mono text-[11px] font-black leading-5 text-black/75\",\"children\":[\"REVISION\",\" \",2,[\"$\",\"br\",null,{}],\"UPDATED \",\"2026-08-27\"]}],[\"$\",\"$L25\",null,{\"value\":\"Refresh evidence before asking the model to speak — Custard, https://custard.top/en/notes/evidence-first-ai-research (2026-08-27)\",\"label\":\"COPY CITATION\"}]]}],[\"$\",\"div\",null,{\"children\":[[null,\"\\n\",[[\"$\",\"section\",null,{\"id\":\"separate\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"SEPARATE\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"Collection, synthesis, and publishing are different workloads\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Public data collection belongs in scheduled batches, model synthesis in retryable background jobs, and page requests in reading published state. Binding them to one HTTP request turns the slowest stage into everybody's timeout.\"}],[\"$\",\"p\",null,{\"children\":\"I split a research request into three stages that can fail independently. If collection fails, the system can keep the last dated evidence instead of returning a new report without sources. If synthesis fails, it can retry without collecting everything again. If publication fails, the generated version should still be inspectable. The separation makes errors more specific and costs easier to explain.\"}]]}]]}],[\"$\",\"section\",null,{\"id\":\"fingerprint\",\"className\":\"scroll-mt-28 border-t border-black/15 py-12 first:border-t-0 first:pt-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#0b6473]\",\"children\":\"FINGERPRINT\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-semibold leading-tight md:text-4xl\",\"children\":\"Cache keys should describe evidence, not time\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-light\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Template version plus company evidence fingerprint forms the reusable unit. A scheduled run does not justify a new model call when normalized evidence has not changed.\"}],\"$L26\",\"$L27\"]}]]}],\"$L28\"]],\"$L29\"]}]]}]}]\n21:[\"$\",\"section\",null,{\"className\":\"border-b border-white/12 bg-[#080a0c] px-5 py-20 md:px-10 lg:px-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M9 17H7A5 5 0 0 1 7 7h2\",\"key\":\"8i5ue5\"}],[\"path\",{\"d\":\"M15 7h2a5 5 0 1 1 0 10h-2\",\"key\":\"1b9ql8\"}],[\"line\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"12\",\"y2\":\"12\",\"key\":\"1jonct\"}]],\"className\":\"lucide-link2 lucide-link-2 h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"RELATED SHIPPED SYSTEMS\"]}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-2xl text-2xl font-semibold text-white md:text-3xl\",\"children\":\"This note comes from design and delivery work in the following systems.\"}],[\"$\",\"div\",null,{\"className\":\"