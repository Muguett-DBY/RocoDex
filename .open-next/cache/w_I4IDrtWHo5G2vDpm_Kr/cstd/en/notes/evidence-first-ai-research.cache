ck text-[#f4d431]\",\"children\":\"AI SYSTEMS / EVIDENCE-FIRST INTELLIGENCE\"}],[\"$\",\"h1\",null,{\"data-cstd-page-hero-title\":true,\"className\":\"mt-6 text-balance text-[2.375rem] font-semibold leading-[0.94] tracking-[0] text-white sm:text-5xl md:text-7xl md:leading-[0.9] lg:text-8xl xl:text-[7rem]\",\"children\":\"Refresh evidence before asking the model to speak\"}],[\"$\",\"p\",null,{\"data-cstd-page-hero-summary\":true,\"className\":\"mt-7 max-w-3xl text-lg leading-8 text-[#c3c9cb] md:text-xl md:leading-9\",\"children\":\"In company research, stale facts, duplicate jobs, and conclusions without a clear source usually cost more than tokens.\"}]]}],[\"$\",\"dl\",null,{\"data-cstd-page-hero-metrics\":true,\"className\":\"mt-10 grid max-w-4xl grid-cols-2 border-y border-white/20 md:grid-cols-3\",\"children\":[[\"$\",\"div\",\"13 min-Reading time\",{\"className\":\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\",\"children\":[\"$L1b\",\"$L1c\"]}],\"$L1d\",\"$L1e\"]}],\"$L1f\"]}]]}],\"$L20\",\"$L21\",\"$L22\"]}],\"$L23\"]}]\n24:I[98272,[\"/_next/static/chunks/3bpg1zucvhmqd.js\",\"/_next/static/chunks/1i9zhf0udey6-.js\",\"/_next/static/chunks/0o4mbv36vpg4h.js\",\"/_next/static/chunks/0-dtv20hsjo64.js\",\"/_next/static/chunks/17tp06dc0ta4c.js\"],\"CstdLink\"]\n25:I[66033,[\"/_next/static/chunks/3bpg1zucvhmqd.js\",\"/_next/static/chunks/1i9zhf0udey6-.js\",\"/_next/static/chunks/0o4mbv36vpg4h.js\",\"/_next/static/chunks/0-dtv20hsjo64.js\",\"/_next/static/chunks/17tp06dc0ta4c.js\"],\"CitationButton\"]\n1b:[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black uppercase text-[#8a969b]\",\"children\":\"Reading time\"}]\n1c:[\"$\",\"dd\",null,{\"className\":\"mt-2 whitespace-nowrap text-xl font-semibold text-[#24e0ff] sm:text-2xl\",\"children\":\"13 min\"}]\n1d:[\"$\",\"div\",\"6 Aug 2026-Published\",{\"className\":\"border-white/15 py-4 pr-5 odd:border-r md:border-r md:last:border-r-0 md:px-5 md:first:pl-0\",\