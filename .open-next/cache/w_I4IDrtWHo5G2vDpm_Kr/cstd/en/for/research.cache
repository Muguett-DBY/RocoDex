f4d431]\",\"children\":\"Only decisions tested in practice.\"}]]}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"$34:props:children:props:children:2:props:children:0:props:children:0:props:children:1:props:children:0:props:children\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":[\"An oracle does not decide for you.\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"It leaves a trail you can follow.\"}]]}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":[\"A map will not choose for you.\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"It records every road already taken.\"}]]}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-7 text-[#aeb8bb] md:text-base md:leading-8\",\"children\":[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":\"Start with the question. The answer, its evidence, and the next step stay in view instead of making readers guess the context.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"Start with the question. The answer, its evidence, and the next step stay in view instead of making readers guess the context.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"These notes predict nothing. They record how a problem was opened, where the evidence came from, and where the next fire should be aimed.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"These notes are maps opened on the road. They mark the fork, the cost, and the route left untaken so the next journey does not begin lost.\"}]]}]]}],\"$L43\",\"$L44\"]}]]}]}]\n35:[\"$\",\"footer\",null,{\"id\":\"cstd-footer\",\"data-cstd-finale\":true,\"data-cstd-scene\":\"finale\",\"data-cstd-generated-visual\":\"departure-city-v1\",\"className\":\"relative z-20 min-h-[76svh] border-t border-[#f4d431]/30 text-[#f2efe7]\",\"children\":[\"$\",\"div\",null,{\"cla