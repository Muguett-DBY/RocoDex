l,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"Nothing leaves this forge untested. Each work keeps its outcome, decisive trade-off, and an inspectable record of how it was made.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"These are not tales of inevitable victory. Each journey keeps the situation, the choice that was actually made, and the outcome you can still verify.\"}]]}]]}],[\"$\",\"div\",null,{\"data-cstd-proof-grid\":true,\"className\":\"mt-12 grid gap-4 lg:grid-cols-12 lg:auto-rows-[15.5rem]\",\"children\":[[\"$\",\"article\",\"alpha-research-system\",{\"data-cstd-proof\":\"alpha\",\"className\":\"group relative min-h-[26rem] overflow-hidden border border-black/15 bg-[#050709] shadow-[0_18px_46px_rgba(5,7,9,0.1)] transition-transform duration-500 ease-out hover:-translate-y-1 lg:col-span-7 lg:row-span-2 lg:min-h-0\",\"children\":[[\"$\",\"$L27\",null,{\"src\":\"/cstd-projects/alpha.png\",\"alt\":\"CSTD Alpha research interface\",\"fill\":true,\"sizes\":\"(min-width: 1024px) 58vw, 100vw\",\"className\":\"object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]\",\"style\":{\"objectPosition\":\"50% 24%\"}}],\"$L3c\",\"$L3d\"]}],\"$L3e\",\"$L3f\"]}],\"$L40\",\"$L41\"]}]}],\"$L42\"]}]\n34:[\"$\",\"div\",null,{\"id\":\"path\",\"tabIndex\":-1,\"data-cstd-scene-shell\":\"path\",\"className\":\"relative scroll-mt-16 focus:outline-none\",\"children\":[\"$\",\"section\",null,{\"data-cstd-chapter\":\"path\",\"data-cstd-scene\":\"path\",\"data-cstd-knowledge-lens\":true,\"aria-labelledby\":\"knowledge-lens-heading\",\"className\":\"relative z-20 overflow-hidden border-b border-white/10 bg-[#07090b] px-5 py-20 text-[#f2efe7] md:px-10 lg:px-16 lg:py-28\",\"children\":[[\"$\",\"$L27\",null,{\"src\":\"/cstd-universe/cstd-knowledge-loom-v3.webp\",\"alt\":\"Engineering notes connected into a knowledge network through citations\",\"fill\":true,\"sizes\":\"100vw\",\"className\":\"object-cover object-[62%_50%] o