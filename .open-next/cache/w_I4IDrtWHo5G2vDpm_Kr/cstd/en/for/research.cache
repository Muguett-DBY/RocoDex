p-5 md:p-7 lg:right-auto lg:max-w-[75%]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between gap-4 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[#f4d431]\",\"children\":[\"0\",3,\" / \",\"OPERATIONS / PERMISSIONS AND CONCURRENCY\"]}],[\"$\",\"span\",null,{\"className\":\"items-center gap-1.5 text-[#24e0ff] hidden lg:flex\",\"children\":[[\"$\",\"$L5\",null,{\"iconNode\":\"$42:props:children:0:props:children:1:props:children:0:props:iconNode\",\"className\":\"lucide-shield-check h-3.5 w-3.5\",\"aria-hidden\":\"true\"}],\" \",80,\"%\"]}]]}],[\"$\",\"h3\",null,{\"className\":\"mt-4 font-semibold leading-tight text-white text-2xl md:text-3xl\",\"children\":\"CFZZS industrial CRM\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 line-clamp-2 text-sm leading-6 text-[#b5bdc0] lg:hidden\",\"children\":\"A lead workbench for an industrial-park team, keeping deduplication, stage changes, spatial inventory, and exports tied to traceable state.\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between gap-5 border-t border-white/15 pt-4 mt-4\",\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/en/work/cfzzs-crm\",\"className\":\"inline-flex items-center gap-2 font-mono text-xs font-black text-[#f4d431] transition-[gap,color] hover:gap-4 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#f4d431]\",\"children\":[\"Open case\",\" \",[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:0:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-right h-4 w-4\",\"aria-hidden\":\"true\"}]]}],[\"$\",\"a\",null,{\"href\":\"https://cfzzs.custard.top\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"aria-label\":\"Open CFZZS industrial CRM\",\"title\":\"Open CFZZS industrial CRM\",\"className\":\"flex h-10 w-10 items-center justify-center border border-white/20 text-[#aab3b6] transition-colors hover:border-[#24e0ff] hover:text-[#24e0ff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#24e0ff]\",\"children\":[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]}]]}]]}]]}]\n45:[\"$\",\"$L4e\",null,{\"chains\":[{\"id\":\"alpha\",\"title\":\"CSTD Alpha research system\",\"kicker\":\"Evidence pipeline / decision workspace\",\"summary\":\"A research workflow instead of a one-shot report: sources, background jobs, valuation versions, and disconfirming conditions stay with each result.\",\"caseHref\":\"/en/work/alpha-research-system\",\"liveHref\":\"https://alpha.custard.top\",\"coverageScore\":80,\"artifactCount\":5,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"Problem\",\"title\":\"Fluent answers are not reliable research\",\"detail\":\"Text without source age, job state, or disconfirming conditions cannot support durable decisions.\",\"signal\":\"Answer length is not a quality metric\"},{\"id\":\"decision\",\"label\":\"Decision\",\"title\":\"Fingerprint before model invocation\",\"detail\":\"Evidence is normalized and fingerprinted first; unchanged inputs reuse work, changed inputs create a new version.\",\"signal\":\"Model cost follows evidence change\"},{\"id\":\"system\",\"label\":\"System\",\"title\":\"Valuation versions are immutable\",\"detail\":\"Deterministic calculations, AI explanation, sources, and disconfirming conditions bind to one research snapshot.\",\"signal\":\"Every conclusion returns to its inputs\"},{\"id\":\"verification\",\"label\":\"Verification\",\"title\":\"The research chain can be replayed\",\"detail\":\"Agent Replay, tests, and production checks prove collection, queueing, synthesis, and publication behavior.\",\"signal\":\"Published evidence constrains published answers\"}]},{\"id\":\"rocodex\",\"title\":\"RocoDex dual-site platform\",\"kicker\":\"Domain boundaries / content product\",\"summary\":\"The portfolio and RocoDex share one Next.js deployment while hosts, auth, content modules, and regression suites remain separately owned.\",\"caseHref\":\"/en/work/rocodex-platform\",\"liveHref\":\"https://rocodex.custard.top\",\"coverageScore\":100,\"artifactCount\":7,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"Problem\",\"title\":\"One container, two products\",\"detail\":\"The portfolio and encyclopedia share Next.js but serve different users, routes, and runtimes.\",\"signal\":\"A folder name is not a boundary\"},{\"id\":\"decision\",\"label\":\"Decision\",\"title\":\"Turn tests into walls\",\"detail\":\"Import scans and isolated E2E suites turn convention into an enforceable gate.\",\"signal\":\"Boundary failures surface in CI\"},{\"id\":\"system\",\"label\":\"System\",\"title\":\"A three-layer isolation contract\",\"detail\":\"Proxy decisions, route groups, and narrow public APIs express ownership together.\",\"signal\":\"Routes, modules, and auth stay isolated\"},{\"id\":\"verification\",\"label\":\"Verification\",\"title\":\"Accept both live surfaces\",\"detail\":\"Every release verifies Actions, Vercel, and both production hosts.\",\"signal\":\"Shared deployment, isolated risk\"}]},{\"id\":\"crm\",\"title\":\"CFZZS industrial CRM\",\"kicker\":\"Operations / permissions and concurrency\",\"summary\":\"A lead workbench for an industrial-park team, keeping deduplication, stage changes, spatial inventory, and exports tied to traceable state.\",\"caseHref\":\"/en/work/cfzzs-crm\",\"liveHref\":\"https://cfzzs.custard.top\",\"coverageScore\":80,\"artifactCount\":3,\"verifiedAt\":\"2026-08-09\",\"phases\":[{\"id\":\"problem\",\"label\":\"Problem\",\"title\":\"Business truth was scattered\",\"detail\":\"Leads, companies, spaces, and follow-ups were disconnected, so the team could not trust shared state.\",\"signal\":\"The gap was consistent state, not more screens\"},{\"id\":\"decision\",\"label\":\"Decision\",\"title\":\"Conflicts stop overwriting silently\",\"detail\":\"Optimistic locking compares versions before writes and returns conflicts instead of corrupting truth.\",\"signal\":\"A 409 is protection, not failure\"},{\"id\":\"system\",\"label\":\"System\",\"title\":\"Encode the workflow as state\",\"detail\":\"Explicit transitions, deduplication, occupancy, and audit events give APIs and UI one contract.\",\"signal\":\"Every transition is explainable\"},{\"id\":\"verification\",\"label\":\"Verification\",\"title\":\"Acceptance follows real roles\",\"detail\":\"Browser tests cover sign-in, creation, transitions, deduplication, exports, and permission boundaries.\",\"signal\":\"The complete operating story passes\"}]}],\"locale\":\"en\"}]\n46:[\"$\",\"div\",null,{\"data-cstd-proof-footer\":true,\"className\":\"mt-9 flex flex-wrap items-center justify-between gap-5 border-t pt-5 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"span\",null,{\"children\":[7,\" \",\"PUBLISHED CASES\",\" / \",31,\" \",\"PUBLIC ARTIFACTS\"]}],[\"$\",\"div\",null,{\"className\":\"flex gap-6\",\"children\":[[\"$\",\"$L4\",null,{\"data-cstd-proof-footer-link\":\"primary\",\"href\":\"/en/work\",\"children\":\"ALL CASES\"}],[\"$\",\"$L4\",null,{\"data-cstd-proof-footer-link\":\"secondary\",\"href\":\"/en/proof.json\",\"children\":\"PROOF.JSON\"}]]}]]}]\n47:[\"$\",\"section\",null,{\"data-cstd-chapter\":\"operator\",\"data-cstd-evidence-subchapter\":true,\"data-cstd-executable-evidence\":true,\"data-cstd-home-replay\":\"alpha-race\",\"aria-labelledby\":\"executable-evidence-heading\",\"className\":\"relative z-20 border-b border-white/10 bg-[#050709] px-5 py-20 text-[#f2efe7] md:px-10 lg:px-16 lg:py-28\",\"children\":[[\"$\",\"span\",null,{\"id\":\"operator\",\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 h-px w-px scroll-mt-20\"}],[\"$\",\"div\",null,{\"data-cstd-evidence-layout\":true,\"className\":\"mx-auto grid max-w-[1320px] gap-10 xl:grid-cols-[minmax(25rem,0.9fr)_minmax(0,1.1fr)] xl:items-start xl:gap-16\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[[\"$\",\"$L5\",null,{\"iconNode\":\"$d:props:children:props:children:0:props:children:props:children:0:props:children:0:props:iconNode\",\"className\":\"lucide-flask-conical h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":\"03B / EXECUTABLE EVIDENCE\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"03B / EXECUTABLE EVIDENCE\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"TRIAL CHAMBER / EXECUTABLE PROOF\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"FATE CHECK / EXECUTABLE PROOF\"}]]]}],[\"$\",\"h2\",null,{\"id\":\"executable-evidence-heading\",\"className\":\"mt-5 text-4xl font-semibold leading-[1] md:text-6xl xl:text-[3.75rem]\",\"children\":[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":[\"A case is not only readable.\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"It can be executed.\"}]]}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"$47:props:children:1:props:children:0:props:children:1:props:children:0:props:children\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":[\"Do not turn the result into legend.\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"The run is the testimony.\"}]]}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":[\"A result cannot live on hearsay.\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"Make the roll and test it yourself.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-xl text-base leading-8 text-[#aeb7ba]\",\"children\":[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":\"No screen recording standing in for the work. Inputs, computation, and outcome are exposed so you can trigger the boundary yourself.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"No screen recording standing in for the work. Inputs, computation, and outcome are exposed so you can trigger the boundary yourself.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"Every system enters the trial chamber. Change a condition, light the forge again, and see which conclusion emerges intact.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"Every conclusion has to face a check. Change the conditions, run it again, and see whether success came from luck or from the system itself.\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap gap-6\",\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/en/work/alpha-research-system\",\"className\":\"inline-flex items-center gap-2 font-mono text-[11px] font-black text-[#24e0ff] hover:text-white\",\"children\":[\"Read the complete technical case\",\" \",[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]]}],[\"$\",\"$L4\",null,{\"href\":\"/en/lab/proof-museum\",\"className\":\"inline-flex items-center gap-2 font-mono text-[11px] font-black text-[#899499] hover:text-white\",\"children\":[\"Proof museum\",\" \",[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]]}]]}]]}],[\"$\",\"$L4f\",\"alpha-race\",{\"replay\":{\"id\":\"alpha-race\",\"caseSlug\":\"alpha-research-system\",\"title\":{\"zh\":\"异步版本竞态\",\"en\":\"Async version race\"},\"thesis\":{\"zh\":\"旧任务可以完成，但不能覆盖新事实。\",\"en\":\"A stale task may finish, but it cannot overwrite newer truth.\"},\"inputLabel\":{\"zh\":\"并发研究任务\",\"en\":\"Concurrent research jobs\"},\"inputMin\":2,\"inputMax\":8,\"inputStep\":1,\"inputDefault\":4,\"unit\":{\"zh\":\"个\",\"en\":\" jobs\"},\"sourceHref\":{\"zh\":\"/work/alpha-research-system\",\"en\":\"/en/work/alpha-research-system\"}},\"locale\":\"en\"}]]}]]}]\n48:[\"$\",\"div\",null,{\"data-cstd-knowledge-list\":true,\"className\":\"mt-12 border-t border-white/14\",\"children\":[[\"$\",\"article\",\"How do you isolate two sites in one deployment?\",{\"data-cstd-knowledge-card\":true,\"className\":\"group grid gap-4 border-b border-white/14 py-7 md:grid-cols-[3rem_minmax(14rem,0.8fr)_minmax(0,1.2fr)_auto] md:items-center md:gap-7 lg:py-8\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\"SOURCE LINKED\"}],[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":[\"0\",1]}],[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold leading-tight text-white md:text-2xl\",\"children\":\"How do you isolate two sites in one deployment?\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-2 text-sm leading-7 text-[#9da8ab]\",\"children\":\"How one repository and one deployment can still keep custard.top and RocoDex as genuinely separate products. Reliable architecture first answers who owns the request, state, and failure. Trace how boundaries ship through dual-host routing, API contracts, and operational optimistic locks. The portfolio and RocoDex share one Next.js deployment while hosts, auth, content modules, and regression suites remain separately owned.\"}],[\"$\",\"$L4\",null,{\"href\":\"/en/notes/host-boundaries-in-one-next-deployment\",\"aria-label\":\"Read source\",\"title\":\"How do you isolate two sites in one deployment? / 3 linked nodes\",\"className\":\"inline-flex h-10 w-10 items-center justify-center border border-white/15 text-[#24e0ff] transition-colors group-hover:border-[#24e0ff]/60 hover:bg-[#24e0ff] hover:text-[#050709]\",\"children\":[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]}]]}],[\"$\",\"article\",\"How does AI research avoid hallucinated evidence?\",{\"data-cstd-knowledge-card\":true,\"className\":\"group grid gap-4 border-b border-white/14 py-7 md:grid-cols-[3rem_minmax(14rem,0.8fr)_minmax(0,1.2fr)_auto] md:items-center md:gap-7 lg:py-8\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\"SOURCE LINKED\"}],[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":[\"0\",2]}],[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold leading-tight text-white md:text-2xl\",\"children\":\"How does AI research avoid hallucinated evidence?\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-2 text-sm leading-7 text-[#9da8ab]\",\"children\":\"Let AI organize and explain while testable code keeps authority over valuation formulas, cash flow, discounting, and versions. Models synthesize; evidence, versions, and deterministic cores constrain. Connect research agents, asynchronous jobs, citations, and stale-write protection into one auditable path. Replay an evidence-first research job across collection, fingerprinting, queueing, synthesis, and publication. A stale job may finish, but it cannot overwrite current truth.\"}],[\"$\",\"$L4\",null,{\"href\":\"/en/notes/deterministic-core-ai-edge\",\"aria-label\":\"Read source\",\"title\":\"How does AI research avoid hallucinated evidence? / 3 linked nodes\",\"className\":\"inline-flex h-10 w-10 items-center justify-center border border-white/15 text-[#24e0ff] transition-colors group-hover:border-[#24e0ff]/60 hover:bg-[#24e0ff] hover:text-[#050709]\",\"children\":[\"$\",\"$L5\",null,{\"iconNode\":\"$0:data:0:rsc:props:children:0:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\",\"className\":\"lucide-arrow-up-right h-4 w-4\",\"aria-hidden\":\"true\"}]}]]}],[\"$\",\"article\",\"Why does the DCF engine avoid model-generated calculations?\",{\"data-cstd-knowledge-card\":true,\"className\":\"group grid gap-4 border-b border-white/14 py-7 md:grid-cols-[3rem_minmax(14rem,0.8fr)_minmax(0,1.2fr)_auto] md:items-center md:gap-7 lg:py-8\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\"SOURCE LINKED\"}],\"$L50\",\"$L51\",\"$L52\",\"$L53\"]}],\"$L54\"]}]\n49:[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-wrap items-center justify-between gap-6\",\"data-cstd-content-health\":true,\"data-cstd-content-health-score\":100,\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-[#7f8b90]\",\"children\":[\"CONTENT HEALTH / \",[\"$\",\"span\",null,{\"className\":\"text-white\",\"children\":100}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-6 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/en/notes\",\"className\":\"text-[#f4d431] hover:text-white\",\"children\":\"ALL NOTES\"}],[\"$\",\"$L4\",null,{\"href\":\"/en/map\",\"className\":\"text-[#aeb8bb] hover:text-white\",\"children\":\"KNOWLEDGE MAP\"}],[\"$\",\"$L4\",null,{\"href\":\"/en/graph.json\",\"className\":\"text-[#24e0ff] hover:text-white\",\"children\":\"GRAPH.JSON\"}]]}]]}]\n4a:[\"$\",\"a\",null,{\"href\":\"mailto:cstd@custard.top?subject=CSTD%20%2F%20RESEARCH%20SYSTEM\",\"className\":\"cstd-finale-address mt-5 block 