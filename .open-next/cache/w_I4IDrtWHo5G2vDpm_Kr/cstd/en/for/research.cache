"true\\\"}]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"40:[\\\"$\\\",\\\"$L49\\\",null,{\\\"chains\\\":[{\\\"id\\\":\\\"alpha\\\",\\\"title\\\":\\\"CSTD Alpha research system\\\",\\\"kicker\\\":\\\"Evidence pipeline / decision workspace\\\",\\\"summary\\\":\\\"A research workflow instead of a one-shot report: sources, background jobs, valuation versions, and disconfirming conditions stay with each result.\\\",\\\"caseHref\\\":\\\"/en/work/alpha-research-system\\\",\\\"liveHref\\\":\\\"https://alpha.custard.top\\\",\\\"coverageScore\\\":80,\\\"artifactCount\\\":5,\\\"verifiedAt\\\":\\\"2026-08-09\\\",\\\"phases\\\":[{\\\"id\\\":\\\"problem\\\",\\\"label\\\":\\\"Problem\\\",\\\"title\\\":\\\"Fluent answers are not reliable research\\\",\\\"detail\\\":\\\"Text without source age, job state, or disconfirming conditions cannot support durable decisions.\\\",\\\"signal\\\":\\\"Answer length is not a quality metric\\\"},{\\\"id\\\":\\\"decision\\\",\\\"label\\\":\\\"Decision\\\",\\\"title\\\":\\\"Fingerprint before model invocation\\\",\\\"detail\\\":\\\"Evidence is normalized and fingerprinted first; unchanged inputs reuse work, changed inputs create a new version.\\\",\\\"signal\\\":\\\"Model cost follows evidence change\\\"},{\\\"id\\\":\\\"system\\\",\\\"label\\\":\\\"System\\\",\\\"title\\\":\\\"Valuation versions are immutable\\\",\\\"detail\\\":\\\"Deterministic calculations, AI explanation, sources, and disconfirming conditions bind to one research snapshot.\\\",\\\"signal\\\":\\\"Every conclusion returns to its inputs\\\"},{\\\"id\\\":\\\"verification\\\",\\\"label\\\":\\\"Verification\\\",\\\"title\\\":\\\"The research chain can be replayed\\\",\\\"detail\\\":\\\"Agent Replay, tests, and production checks prove collection, queueing, synthesis, and publication behavior.\\\",\\\"signal\\\":\\\"Published evidence constrains published answers\\\"}]},{\\\"id\\\":\\\"rocodex\\\",\\\"title\\\":\\\"RocoDex dual-site platform\\\",\\\"kicker\\\":\\\"Domain boundaries / content product\\\",\\\"summary\\\":\\\"The portfolio and RocoDex share one Next.js deployment while hosts, auth, content modules, and regression suites remain separately owned.\\\",\\\"caseHref\\\":\\\"/en/work/rocodex-platform\\\",\\\"liveHref\\\":\\\"https://rocodex.custard.top\\\",\\\"coverageScore\\\":100,\\\"artifactCount\\\":7,\\\"verifiedAt\\\":\\\"2026-08-09\\\",\\\"phases\\\":[{\\\"id\\\":\\\"problem\\\",\\\"label\\\":\\\"Problem\\\",\\\"title\\\":\\\"One container, two products\\\",\\\"detail\\\":\\\"The portfolio and encyclopedia share Next.js but serve different users, routes, and runtimes.\\\",\\\"signal\\\":\\\"A folder name is not a boundary\\\"},{\\\"id\\\":\\\"decision\\\",\\\"label\\\":\\\"Decision\\\",\\\"title\\\":\\\"Turn tests into walls\\\",\\\"detail\\\":\\\"Import scans and isolated E2E suites turn convention into an enforceable gate.\\\",\\\"signal\\\":\\\"Boundary failures surface in CI\\\"},{\\\"id\\\":\\\"system\\\",\\\"label\\\":\\\"System\\\",\\\"title\\\":\\\"A three-layer isolation contract\\\",\\\"detail\\\":\\\"Proxy decisions, route groups, and narrow public APIs express ownership together.\\\",\\\"signal\\\":\\\"Routes, modules, and auth stay isolated\\\"},{\\\"id\\\":\\\"verification\\\",\\\"label\\\":\\\"Verification\\\",\\\"title\\\":\\\"Accept both live surfaces\\\",\\\"detail\\\":\\\"Every release verifies Actions, Vercel, and both production hosts.\\\",\\\"signal\\\":\\\"Shared deployment, isolated risk\\\"}]},{\\\"id\\\":\\\"crm\\\",\\\"title\\\":\\\"CFZZS industrial CRM\\\",\\\"kicker\\\":\\\"Operations / permissions and concurrency\\\",\\\"summary\\\":\\\"A lead workbench for an industrial-park team, keeping deduplication, stage changes, spatial inventory, and exports tied to traceable state.\\\",\\\"caseHref\\\":\\\"/en/work/cfzzs-crm\\\",\\\"liveHref\\\":\\\"https://cfzzs.custard.top\\\",\\\"coverageScore\\\":80,\\\"artifactCount\\\":3,\\\"verifiedAt\\\":\\\"2026-08-09\\\",\\\"phases\\\":[{\\\"id\\\":\\\"problem\\\",\\\"label\\\":\\\"Problem\\\",\\\"title\\\":\\\"Business truth was scattered\\\",\\\"detail\\\":\\\"Leads, companies, spaces, and follow-ups were disconnected, so the team could not trust shared state.\\\",\\\"signal\\\":\\\"The gap was consistent state, not more screens\\\"},{\\\"id\\\":\\\"decision\\\",\\\"label\\\":\\\"Decision\\\",\\\"title\\\":\\\"Conflicts stop overwriting silently\\\",\\\"detail\\\":\\\"Optimistic locking compares versions before writes and returns conflicts instead of corrupting truth.\\\",\\\"signal\\\":\\\"A 409 is protection, not failure\\\"},{\\\"id\\\":\\\"system\\\",\\\"label\\\":\\\"System\\\",\\\"title\\\":\\\"Encode the workflow as state\\\",\\\"detail\\\":\\\"Explicit transitions, deduplication, occupancy, and audit events give APIs and UI one contract.\\\",\\\"signal\\\":\\\"Every transition is explainable\\\"},{\\\"id\\\":\\\"verification\\\",\\\"label\\\":\\\"Verification\\\",\\\"title\\\":\\\"Acceptance follows real roles\\\",\\\"detail\\\":\\\"Browser tests cover sign-in, creation, transitions, deduplication, exports, and permission boundaries.\\\",\\\"signal\\\":\\\"The complete operating story passes\\\"}]}],\\\"locale\\\":\\\"en\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"41:[\\\"$\\\",\\\"div\\\",null,{\\\"data-cstd-proof-footer\\\":true,\\\"className\\\":\\\"mt-9 flex flex-wrap items-center justify-between gap-5 border-t pt-5 font-mono text-[11px] font-black\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":[7,\\\" \\\",\\\"PUBLISHED CASES\\\",\\\" / \\\",31,\\\" \\\",\\\"PUBLIC ARTIFACTS\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex gap-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1a\\\",null,{\\\"data-cstd-proof-footer-link\\\":\\\"primary\\\",\\\"href\\\":\\\"/en/work\\\",\\\"children\\\":\\\"ALL CASES\\\"}],[\\\"$\\\",\\\"$L1a\\\",null,{\\\"data-cstd-proof-footer-link\\\":\\\"secondary\\\",\\\"href\\\":\\\"/en/proof.json\\\",\\\"children\\\":\\\"PROOF.JSON\\\"}]]}]]}