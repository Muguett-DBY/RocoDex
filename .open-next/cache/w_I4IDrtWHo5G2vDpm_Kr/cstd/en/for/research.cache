:\"M12 18h6a2 2 0 0 1 2 2v1\",\"key\":\"105ag5\"}],[\"path\",{\"d\":\"M12 8h8\",\"key\":\"1lhi5i\"}],[\"path\",{\"d\":\"M16 8V5a2 2 0 0 1 2-2\",\"key\":\"u6izg6\"}],[\"circle\",{\"cx\":\"16\",\"cy\":\"13\",\"r\":\".5\",\"key\":\"ry7gng\"}],[\"circle\",{\"cx\":\"18\",\"cy\":\"3\",\"r\":\".5\",\"key\":\"1aiba7\"}],[\"circle\",{\"cx\":\"20\",\"cy\":\"21\",\"r\":\".5\",\"key\":\"yhc1fs\"}],[\"circle\",{\"cx\":\"20\",\"cy\":\"8\",\"r\":\".5\",\"key\":\"1e43v0\"}]],\"className\":\"lucide-brain-circuit h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":\"04 / TECH NOTES\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"04 / TECH NOTES\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"ORACLE HALL / TECH NOTES\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"CHAPTER IV / TRAVEL CHRONICLE\"}]]]}],[\"$\",\"h2\",null,{\"id\":\"knowledge-lens-heading\",\"className\":\"mt-5 max-w-4xl text-4xl font-semibold leading-[1] md:text-6xl lg:text-[4rem]\",\"children\":[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":[\"Technical writing without a jargon wall.\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"Only decisions tested in practice.\"}]]}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"$31:props:children:props:children:2:props:children:0:props:children:0:props:children:1:props:children:0:props:children\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":[\"An oracle does not decide for you.\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"It leaves a trail you can follow.\"}]]}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":[\"A map will not choose for you.\",[\"$\",\"span\",null,{\"className\":\"block text-[#f4d431]\",\"children\":\"It records every road already taken.\"}]]}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-7 text-[#aeb8bb] md:text-base md:leading-8\",\"children\":[[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"atelier\",\"children\":\"Start with the question. The answer, its evidence, and the next step stay in view instead of making readers guess the context.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"Start with the question. The answer, its evidence, and the next step stay in view instead of making readers guess the context.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"These notes predict nothing. They record how a problem was opened, where the evidence came from, and where the next fire should be aimed.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"These notes are maps opened on the road. They mark the fork, the cost, and the route left untaken so the next journey does not begin lost.\"}]]}]]}],\"$L48\",\"$L49\"]}]]}]}]\n32:[\"$\",\"footer\",null,{\"id\":\"cstd-footer\",\"data-cstd-finale\":true,\"data-cstd-scene\":\"finale\",\"data-cstd-generated-visual\":\"departure-city-v1\",\"className\":\"relative z-20 min-h-[76svh] border-t border-[#f4d431]/30 text-[#f2efe7]\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative flex min-h-[76svh] items-end overflow-hidden px-5 pb-12 pt-28 md:px-10 md:pb-16 lg:px-16\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute inset-0 bg-[linear-gradient(90deg,rgba(5,7,9,0.98)_0%,rgba(5,7,9,0.8)_48%,rgba(5,7,9,0.22)_88%)]\"}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute inset-0 bg-[linear-gradient(0deg,#050709_0%,rgba(5,7,9,0.28)_38%,transparent_76%)]\"}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute inset-x-0 top-0 h-px bg-[#f4d431]/60\"}],[\"$\",\"div\",null,{\"data-cstd-finale-layout\":true,\"className\":\"relative mx-auto grid w-full max-w-[1320px] gap-12 lg:grid-cols-[minmax(0,1fr)_21rem