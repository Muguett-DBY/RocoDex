"$\",\"span\",null,{\"data-cstd-theme-copy\":\"neon\",\"children\":\"Product, AI, data, and release are different sides of the same job. Open a district to see what it carried in a real project.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"underworld\",\"children\":\"Five capability chains, five sets of tools. Open one to see how it shapes a system, survives trial, and leaves a mark on real work.\"}],[\"$\",\"span\",null,{\"data-cstd-theme-copy\":\"astral\",\"children\":\"Five capability chains form one party. Each has a specialty, but they still have to carry the same adventure. Open one to see where it changed a real project's route.\"}]]}]]}],[\"$\",\"a\",null,{\"data-cstd-observatory-deployment\":true,\"href\":\"https://github.com/Muguett-DBY/RocoDex/tree/main\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"group flex min-w-56 items-center gap-4 border-y border-white/12 py-4 font-mono transition-colors hover:border-[#24e0ff]/50\",\"children\":[[\"$\",\"$L5\",null,{\"iconNode\":[[\"circle\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"3\",\"key\":\"1v7zrd\"}],[\"line\",{\"x1\":\"3\",\"x2\":\"9\",\"y1\":\"12\",\"y2\":\"12\",\"key\":\"1dyftd\"}],[\"line\",{\"x1\":\"15\",\"x2\":\"21\",\"y1\":\"12\",\"y2\":\"12\",\"key\":\"oup4p8\"}]],\"className\":\"lucide-git-commit-horizontal h-4 w-4 text-[#24e0ff]\",\"aria-hidden\":\"true\"}],\"$L3e\",\"$L3f\"]}]]}],\"$L40\"]}]]}]}]\n30:[\"$\",\"div\",null,{\"id\":\"proof\",\"tabIndex\":-1,\"data-cstd-scene-shell\":\"proof\",\"className\":\"relative scroll-mt-16 focus:outline-none\",\"children\":[[\"$\",\"section\",null,{\"data-cstd-chapter\":\"proof\",\"data-cstd-scene\":\"proof\",\"data-cstd-proof-reel\":true,\"data-cstd-light-chapter\":true,\"aria-labelledby\":\"proof-heading\",\"className\":\"relative z-20 border-b border-black/15 bg-[#f0efe9] px-5 py-20 text-[#090b0d] md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[[\"$\",\"header\",null,{\"