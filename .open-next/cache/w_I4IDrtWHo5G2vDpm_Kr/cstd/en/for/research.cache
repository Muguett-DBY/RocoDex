0709]\\\",\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$10:0:props:children:0:props:children:0:props:children:1:props:children:props:children:4:props:children:1:props:children:2:props:iconNode\\\",\\\"className\\\":\\\"lucide-arrow-up-right h-4 w-4\\\",\\\"aria-hidden\\\":\\\"true\\\"}]}]]}],[\\\"$\\\",\\\"article\\\",\\\"How does AI research avoid hallucinated evidence?\\\",{\\\"data-cstd-knowledge-card\\\":true,\\\"className\\\":\\\"group grid gap-4 border-b border-white/14 py-7 md:grid-cols-[3rem_minmax(14rem,0.8fr)_minmax(0,1.2fr)_auto] md:items-center md:gap-7 lg:py-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sr-only\\\",\\\"children\\\":\\\"SOURCE LINKED\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":[\\\"0\\\",2]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-xl font-semibold leading-tight text-white md:text-2xl\\\",\\\"children\\\":\\\"How does AI research avoid hallucinated evidence?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"line-clamp-2 text-sm leading-7 text-[#9da8ab]\\\",\\\"children\\\":\\\"Let AI organize and explain while testable code keeps authority over valuation formulas, cash flow, discounting, and versions. Models synthesize; evidence, versions, and deterministic cores constrain. Connect research agents, asynchronous jobs, citations, and stale-write protection into one auditable path. Replay an evidence-first research job across collection, fingerprinting, queueing, synthesis, and publication. A stale job may finish, but it cannot overwrite current truth.\\\"}],[\\\"$\\\",\\\"$L1a\\\",null,{\\\"href\\\":\\\"/en/notes/deterministic-core-ai-edge\\\",\\\"aria-label\\\":\\\"Read source\\\",\\\"title\\\":\\\"How does AI research avoid hallucinated evidence? / 3 linked nodes\\\",\\\"className\\\":\\\"inline-flex h-10 w-10 items-center justify-center border border-whi