ll,{\"ref\":\"$undefined\",\"iconNode\":\"$5:props:children:0:props:notFound:0:props:children:props:children:5:props:children:0:props:iconNode\",\"className\":\"lucide-arrow-left h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"All work\"]}]}],[\"$\",\"dl\",null,{\"className\":\"grid gap-6 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"ROLE\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"Experience design, full stack, and immersive visual direction\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"STATUS\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"Live\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"TECHNICAL SYSTEM\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"React 19 · React Router · Three.js · PWA · D1 · R2\"}]]}]]}]]}]}]\n21:[\"$\",\"$L29\",null,{\"caseStudy\":{\"publicationStatus\":\"published\",\"revision\":2,\"publishedAt\":\"2026-01-01\",\"updatedAt\":\"2026-08-27\",\"slug\":\"portrait-booking\",\"projectId\":\"photography\",\"year\":\"2026\",\"title\":{\"zh\":\"奶黄包摄影体验\",\"en\":\"Custard portrait experience\"},\"kicker\":{\"zh\":\"服务设计 / 预约与视觉\",\"en\":\"Service design / booking and visual system\"},\"summary\":{\"zh\":\"让访客从看照片、选服务一路走到预约；客户账户、活动、浏览器修图和后台管理共享同一份服务状态。\",\"en\":\"A portrait site that takes a visitor from photographs to a booking, with accounts, events, browser editing, and admin sharing one service state.\"},\"film\":{\"durationSeconds\":94,\"logline\":{\"zh\":\"让一段电影化摄影展示自然抵达一个真实、可靠的预约。\",\"en\":\"Letting a cinematic portrait showcase arrive naturally at a real, reliable booking.\"},\"beats\":[{\"id\":\"beautiful-dead-end\",\"phase\":\"problem\",\"title\":{\"zh\":\"好看不能成为旅程终点\",\"en\":\"Beauty cannot be a dead end\"},\"detail\":{\"zh\":\"作品、档期、客户账户与交付分散时，访客欣赏完仍然不知道下一步。\",\"en\":\"When work, availability, accounts, and delivery are separate, visitors admire the page but cannot continue.\"},\"signal\":{\"zh\":\"展示必须连接服务\",\"en\":\"Presentation must connect to service\"}},{\"id\":\"media-first\",\"phase\":\"constraint\",\"title\":{\"zh\":\"真实照片必须先到\",\"en\":\"Real photographs arrive first\"},\"detail\":{\"zh\":\"三维氛围、视频和编辑器不能阻塞 LCP，也不能掩盖真正作品。\",\"en\":\"3D atmosphere, video, and editing cannot block LCP or obscure the actual work.\"},\"signal\":{\"zh\":\"素材是主角，特效是调度\",\"en\":\"The work is primary; effects are orchestration\"}},{\"id\":\"journey-model\",\"phase\":\"architecture\",\"title\":{\"zh\":\"一条完整服务链\",\"en\":\"One complete service journey\"},\"detail\":{\"zh\":\"作品、日历、预约、账户、活动、修图与后台共享清晰的状态边界。\",\"en\":\"Work, calendar, booking, accounts, events, editing, and administration share explicit state boundaries.\"},\"signal\":{\"zh\":\"每个页面都有下一步\",\"en\":\"Every surface has a next step\"}},{\"id\":\"capacity-safe\",\"phase\":\"decision\",\"title\":{\"zh\":\"容量安全优先于乐观界面\",\"en\":\"Capacity safety before optimistic UI\"},\"detail\":{\"zh\":\"预约与改期必须重新确认服务容量，避免漂亮界面制造超售。\",\"en\":\"Booking and rescheduling revalidate service capacity so a polished interface cannot create overbooking.\"},\"signal\":{\"zh\":\"可用性是后端事实\",\"en\":\"Availability is a backend fact\"}},{\"id\":\"whole-story\",\"phase\":\"evidence\",\"title\":{\"zh\":\"浏览器验收完整故事\",\"en\":\"The browser verifies the whole story\"},\"detail\":{\"zh\":\"响应式首映、预约、自助改期和后台状态在同一发布流程中通过。\",\"en\":\"The responsive premiere, booking, self-service rescheduling, and administrative state pass one release flow.\"},\"signal\":{\"zh\":\"从第一帧到履约都可验证\",\"en\":\"From first frame to fulfillment, every step is verifiable\"}}]},\"role\":{\"zh\":\"体验设计、前后端与沉浸式视觉\",\"en\":\"Experience design, full stack, and immersive visual direction\"},\"image\":{\"src\":\"/cstd-projects/photography.png\",\"alt\":{\"zh\":\"奶黄包摄影主页\",\"en\":\"Custard portrait website\"},\"position\":\"50% 28%\"},\"technologies\":[\"React 19\",\"React Router\",\"Three.js\",\"PWA\",\"D1\",\"R2\"],\"metrics\":[{\"value\":\"1\",\"label\":{\"zh\":\"连续服务旅程\",\"en\":\"continuous service journey\"}},{\"value\":\"PWA\",\"label\":{\"zh\":\"离线预约恢复\",\"en\":\"offline booking recovery\"}},{\"value\":\"3D\",\"label\":{\"zh\":\"单画布视觉层\",\"en\":\"single-canvas visual layer\"}}],\"evidence\":[{\"label\":{\"zh\":\"架构\",\"en\":\"Architecture\"},\"detail\":{\"zh\":\"routing、features、experience 与 functions 有明确依赖方向。\",\"en\":\"Routing, features, experience, and functions have explicit dependency direction.\"}},{\"label\":{\"zh\":\"恢复\",\"en\":\"Recovery\"},\"detail\":{\"zh\":\"PWA 与本地状态让中断预约可继续。\",\"en\":\"PWA and local state let interrupted bookings continue.\"}},{\"label\":{\"zh\":\"验收\",\"en\":\"Acceptance\"},\"detail\":{\"zh\":\"生产域名、核心页面与 Service Worker 在推送后复核。\",\"en\":\"Production host, critical pages, and service worker are rechecked after release.\"}}],\"capabilityIds\":[\"product-surfaces\",\"edge-operations\"],\"relatedNoteSlugs\":[\"single-canvas-immersive-web\"],\"relatedLabSlugs\":[\"render-lab\",\"system-trace\"],\"artifacts\":[{\"kind\":\"production\",\"label\":{\"zh\":\"生产系统\",\"en\":\"Production system\"},\"detail\":{\"zh\":\"公开可访问的实际运行界面。\",\"en\":\"The publicly reachable running product.\"},\"href\":{\"zh\":\"https://shoot.custard.top\",\"en\":\"https://shoot.custard.top\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"note\",\"label\":{\"zh\":\"沉浸式网站只需要一个三维运行时\",\"en\":\"An immersive website needs only one 3D runtime\"},\"detail\":{\"zh\":\"从该系统实现中沉淀的技术决策记录。\",\"en\":\"An engineering decision record derived from this system.\"},\"href\":{\"zh\":\"/notes/single-canvas-immersive-web\",\"en\":\"/en/notes/single-canvas-immersive-web\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"lab\",\"label\":{\"zh\":\"可复现实验 / render-lab\",\"en\":\"Reproducible lab / render-lab\"},\"detail\":{\"z