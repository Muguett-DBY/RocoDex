dff8f]\\\",\\\"children\\\":[\\\"REV \\\",2,\\\" / \\\",\\\"VERIFIED\\\",\\\" \\\",\\\"2026-08-27\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"hidden items-center justify-center border-x border-white/10 text-[#f4d431] lg:flex\\\",\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$23:props:children:props:children:2:props:children:1:props:children:props:iconNode\\\",\\\"className\\\":\\\"lucide-arrow-right h-5 w-5\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-t border-white/15 py-7 lg:border-t-0 lg:pl-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono text-[11px] font-black text-[#78858a]\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Le\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M9 17H7A5 5 0 0 1 7 7h2\\\",\\\"key\\\":\\\"8i5ue5\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"M15 7h2a5 5 0 1 1 0 10h-2\\\",\\\"key\\\":\\\"1b9ql8\\\"}],[\\\"line\\\",{\\\"x1\\\":\\\"8\\\",\\\"x2\\\":\\\"16\\\",\\\"y1\\\":\\\"12\\\",\\\"y2\\\":\\\"12\\\",\\\"key\\\":\\\"1jonct\\\"}]],\\\"className\\\":\\\"lucide-link2 lucide-link-2 h-4 w-4\\\",\\\"aria-hidden\\\":\\\"true\\\"}],\\\" \\\",\\\"EVIDENCE AND REPRODUCTION\\\"]}],\\\"$L2a\\\"]}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"24:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"bg-[#080a0c]\\\",\\\"children\\\":[null,\\\"\\\\n\\\",[[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"journey\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"01 / Journey\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"Presentation should naturally become booking.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The homepage is not a pile of images. It guides visitors from style and service understanding into availability, booking, and recovery, while admin and customer accounts share one booking truth.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Photography sites have an easy trap: build a beautiful gallery and leave visitors without a natural next step. I treated service explanation, visual style, availability, and booking state as four points in one journey. Someone can begin with a photograph or with a date; both routes return to the same service truth.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"That means the copy and interaction need fewer invitations to “explore” and more direct answers: what the session is, who it suits, what to prepare, and what happens after submission. The first frame earns attention; a clear path earns the booking.\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"experience\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"02 / Experience\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"ari