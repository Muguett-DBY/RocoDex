,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"Three questions, one open-data chain.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The project asks three things: how does pedestrian activity across the Melbourne CBD vary over time? How are temperature, wind, and particulate conditions associated with it? And which locations look more vulnerable to heat and poor air quality — and do weekdays and weekends disagree?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The raw material comes entirely from the City of Melbourne's official open data: 1.47 million pedestrian count records, 145 sensor-location rows, and 591 thousand microclimate observations. Each source ships with its own cadence and coordinate habits — the real starting point of this project was not modelling but aligning definitions.\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"pipeline\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"02 / Pipeline\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"Reproducible first, interpretable second.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"A four-stage R pipeline (download → clean → figures → report) carries the whole process: \\\",[\\\"$\\\",\\\"code\\\",null,{\\\"children\\\":\\\"data.table\\\"}],\\\" for filtering and joins, \\\",[\\\"$\\\",\\\"code\\\",null,{\\\"children\\\":\\\"lubridate\\\"}],\\\" for time zones and hourly aggregation, and a hand-written haversine calculation for the spatial join that matches each pedestrian sensor to its nearest microclimate device. The strict 150-metre threshold keeps 14 sensors at a median match distance of 99.7 metres.\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The raw data converge into 170,243 joined hourly rows, 130,918 of them with complete temperature, PM2.5, and wind. Missing readings are not imputed — this is exploratory analysis, not a competition, and leaving the holes visible matters more than filling them.\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"findings\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"03 / Findings\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"The environmental signal exists, but it grows on top of the urban rhythm.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[\\\"$L2a\\\",\\\"$L2b\\\"]}]]}]]}]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"24:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"border-b border-[#f4d431]/40 bg-[#f4d431] px-5 py-20 text-[#050709] md:px-10 lg:px-16 lg:py-24\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-[1320px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-8 lg:grid-cols-[0.75fr_1.25fr]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono text-[11px] font-black\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Le\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\\\",\\\"key\\\":\\\"oel41y\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"m9 12 2 2 4-4\\\",\\\"key\\\":\\\"dzmm74\\\"}]],\\\"className\\\":\\\"lucide-shield-check h-5 w-5\\\",\\\"aria-hidden\\\":\\\"true\\\"}],\\\" \\\",\\\"PROOF LEDGER / DELIVERY EVIDENCE\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"mt-5 max-w-xl text-4xl font-semibold leading-tight md:text-5xl\\\",\\\"children\\\":\\\"Not a self-reported skills list, but facts traceable through implementation, tests, and production behavior.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-t border-black/30\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"Basis\\\",{\\\"className\\\":\\\"grid gap-3 border-b border-black/30 py-5 sm:grid-cols-[3rem_10rem_1fr] sm:items-start\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-black/75\\\",\\\"children\\\":[\\\"0\\\",1]}],[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"font-mono text-xs\\\",\\\"children\\\":\\\"Basis\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm 