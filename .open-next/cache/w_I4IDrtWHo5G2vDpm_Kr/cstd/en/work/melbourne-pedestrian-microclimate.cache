t justify-between gap-5 border-b border-white/10 py-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\",\"children\":[[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"block font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[\"PRODUCTION\",\" / \",\"2026-09-06\"]}],[\"$\",\"span\",null,{\"className\":\"mt-2 block text-sm font-semibold text-white\",\"children\":\"Figure 04 / environmental regression coefficients\"}]]}],[\"$\",\"$L20\",null,{\"iconNode\":\"$23:props:children:0:0:props:children:1:props:iconNode\",\"className\":\"lucide-external-link h-4 w-4 shrink-0 text-[#f4d431]\",\"aria-hidden\":\"true\"}]]}],[\"$\",\"$L21\",\"production-/cstd-archive/cstd-archive-melbourne-heat-sensitivity-v1.webp\",{\"href\":\"/cstd-archive/cstd-archive-melbourne-heat-sensitivity-v1.webp\",\"className\":\"flex items-start justify-between gap-5 border-b border-white/10 py-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\",\"children\":[[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"block font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[\"PRODUCTION\",\" / \",\"2026-09-06\"]}],[\"$\",\"span\",null,{\"className\":\"mt-2 block text-sm font-semibold text-white\",\"children\":\"Figure 06 / heat sensitivity map\"}]]}],[\"$\",\"$L20\",null,{\"iconNode\":\"$23:props:children:0:0:props:children:1:props:iconNode\",\"className\":\"lucide-external-link h-4 w-4 shrink-0 text-[#f4d431]\",\"aria-hidden\":\"true\"}]]}],[\"$\",\"$L21\",\"production-/cstd-archive/cstd-archive-melbourne-pm25-sensitivity-v1.webp\",{\"href\":\"/cstd-archive/cstd-archive-melbourne-pm25-sensitivity-v1.webp\",\"className\":\"flex items-start justify-between gap-5 border-b border-white/10 py-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\",\"children\":[[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"block font-mono text-[11px] font-black text-[#24e0ff]\",\"children\":[\"PRODUCTION\",\" / \",\"2026-09-06\"]}],[\"$\",\"span\",null,{\"className\":\"mt-2 block text-sm font-semibold text-white\",\"children\":\"Figure 07 / PM2.5 sensitivity map\"}]]}],\"$L2f\"]}]],[\"$L30\"],[\"$L31\"]]}]\n24:[\"$\",\"p\",null,{\"children\":\"All three questions get checkable answers. Activity varies strongly by month, weekday, and hour, and locations have distinct personalities — commuter districts and leisure districts peak in different shapes. Once those rhythms are controlled, temperature, PM2.5, and wind still show measurable associations with activity.\"}]\n25:[\"$\",\"p\",null,{\"children\":\"Per-sensor heat and PM2.5 sensitivity maps show that vulnerability is not one-dimensional: the same location can respond differently to heat than to pollution, and weekday patterns split from weekend ones. The analysis is observational — it offers conditional associations and spatial patterns, not causal effects. The limits live in the report, and in every rerun.\"}]\n29:null\n12:300\n2f:[\"$\",\"$L20\",null,{\"iconNode\":\"$23:props:children:0:0:props:children:1:props:iconNode\",\"className\":\"lucide-external-link h-4 w-4 shrink-0 text-[#f4d431]\",\"aria-hidden\":\"true\"}]\n30:[\"$\",\"$L21\",\"data-wrangling-as-product-design\",{\"href\":\"/en/notes/data-wrangling-as-product-design\",\"className\":\"flex items-center justify-between gap-5 border-b border-white/10 py-4 text-sm font-semibold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24e0ff]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex items-center gap-3\",\"children\":[[\"$\",\"$L20\",null,{\"iconNode\":\"$9:props:children:props:children:2:props:children:4:props:children:0:props:children:0:props:iconNode\",\"className\":\"lucide-link2 lucide-link-2 h-4 w-4 text-[#24e0ff]\",\"aria-hidden\":