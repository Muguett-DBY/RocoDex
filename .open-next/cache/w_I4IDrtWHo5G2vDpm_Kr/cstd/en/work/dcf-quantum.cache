roll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"01 / Principle\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"A valuation must be reproducible.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The software calls no language model and makes no trades. Bear, base, and bull ranges come from public deterministic Python formulas with the applied discount-rate basis retained.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The motivation was simple: the same company should not produce different mathematics just because the page was rearranged or the program ran on another machine. Users can change assumptions, but each input needs a clear meaning and each output should lead back to a formula and its data. The tool does not decide an investment; it makes the research process inspectable.\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"audit\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"02 / Audit\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"Every scan carries data lineage.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Run manifests retain model version, config hash, data fingerprint, cache parameters, dependencies, and output hashes. Proxy estimates remain explicitly separate from FCFF-bridged confirmations.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"“Proxy” is not a vague disclaimer here; it is a real product state. When enough financial evidence is missing, the system can say how far it got without presenting an estimate as a confirmed FCFF result. Keeping the distinction in the manifest also shows what deserves recalculation when new data arrives.\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"desktop\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"03 / Delivery\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"Ship the research core to machines without Python.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The Windows x64 package includes a browser GUI, isolated worker process, safe cancellation, and offline demo, bound only to loopback.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Desktop delivery is more than turning Python into an executable. Startup, cancellation, cache directories, error messages, and offline behavior all need to be tried on the machine that receives the package. Binding to loopback is deliberate: this is a local research tool, not a data service for the whole network.\\\"}]]}]]}]]}]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"26:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"border-b border-[#f4d431]/40 bg-[#f4d431] px-5 py-20 text-[#050709] md:px-10 lg:px-16 lg:py-24\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-[1320px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-8 lg:grid-cols-[0.75fr_1.25fr]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono text-[11px] font-black\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Le\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\\\",\\\"key\\\":\\\"oel41y\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"m9 12 2 2 4-4\\\",\\\"key\\\":\\\"dzmm74\\\"}]],\\\"className\\\":\\\"lucide-shield-check h-5 w-5\\\",\\\"aria-hidden\\\":\\\"true\\\"}],\\\" \\\",\\\"PROOF LEDGER / DELIVERY EVIDENCE\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"mt-5 max-w-xl text-4xl font-semibold leading-tight md:text-5x