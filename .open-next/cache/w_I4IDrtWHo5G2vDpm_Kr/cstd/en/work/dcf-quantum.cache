dren\":\"STREAM-05\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm font-semibold text-white\",\"children\":\"Data flows and computational research\"}]]}]]}]]}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"hidden items-center justify-center border-x border-white/10 text-[#24e0ff] lg:flex\",\"children\":[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]],\"className\":\"lucide-arrow-right h-5 w-5\"}]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 py-7 lg:border-t-0 lg:px-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#78858a]\",\"children\":\"SHIPPED SYSTEM\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 text-2xl font-semibold text-white\",\"children\":\"DCF Quantum\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm leading-7 text-[#9ca7aa]\",\"children\":\"A local three-scenario DCF screener that keeps data definitions, caching, run manifests, and Windows delivery in one research flow.\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[11px] font-black text-[#3dff8f]\",\"children\":[\"REV \",2,\" / \",\"VERIFIED\",\" \",\"2026-08-27\"]}]]}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"hidden items-center justify-center border-x border-white/10 text-[#f4d431] lg:flex\",\"children\":[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$24:props:children:props:children:2:props:children:1:props:children:props:iconNode\",\"className\":\"lucide-arrow-right h-5 w-5\"}]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 py-7 lg:border-t-0 lg:pl-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#78858a]\",\"children\":[[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M9 17H7A5 5 0 0 1 7 7h2\",\"key\":\"8i5ue5\"}],[\"path\",{\"d\":\"M15 7h2a5 5 0 1 1 0 10h-2\",\"key\":\"1b9ql8\"}],[\"line\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"12\",\"y2\":\"12\",\"key\":\"1jonct\"}]],\"className\":\"lucide-link2 lucide-link-2 h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"EVIDENCE AND REPRODUCTION\"]}],\"$L2c\"]}]]}]]}]}]\n25:[\"$\",\"article\",null,{\"className\":\"bg-[#080a0c]\",\"children\":[null,\"\\n\",[[\"$\",\"section\",null,{\"id\":\"principle\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"01 / Principle\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"A valuation must be reproducible.\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"The software calls no language model and makes no trades. Bear, base, and bull ranges come from public deterministic Python formulas with the applied discount-rate basis retained.\"}],[\"$\",\"p\",null,{\"children\":\"The motivation was simple: the same company should not produce different mathematics just because the page was rearranged or the program ran on another machine. Users can change assumptions, but each input needs a clear meaning and each output should lead back to a formula and its data. The tool does not decide an investment; it makes the research process inspectable.\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"id\":\"audit\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"02 / Audit\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"Every scan carries data lineage.\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Run manifests retain model version, config hash, data fingerprint, cache parameters, dependencies, and output hashes. Proxy estimates remain explicitly separate from FCFF-bridged confirmations.\"}],[\"$\",\"p\",null,{\"children\":\"“Proxy” is not a vague disclaimer here; it is a real product state. When enough financial evidence is missing, the system can say how far it got without presenting an estimate as a confirmed FCFF result. Keeping the distinction in the manifest also shows what deserves recalculation when new data arrives.\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"id\":\"desktop\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"03 / Delivery\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"Ship the research core to machines without Python.\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"The Windows x64 package includes a browser GUI, isolated worker process, safe cancellation, and offline demo, bound only to loopback.\"}],[\"$\",\"p\",null,{\"children\":\"Desktop delivery is more than turning Python into an executable. Startup, cancellation, cache directories, error messages, and offline behavior all need to be tried on the machine that receives the package. Binding to loopback is deliberate: this is a local research tool, not a data service for the whole network.\"}]]}]]}]]}]}]]]}]\n26:[\"$\",\"section\",null,{\"className\":\"border-b border-[#f4d431]/40 bg-[#f4d431] px-5 py-20 text-[#050709] md:px-10 lg:px-16 lg:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-8 lg:grid-cols-[0.75fr_1.25fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\",\"key\":\"oel41y\"}],[\"path\",{\"d\":\"m9 12 2 2 4-4\",\"key\":\"dzmm74\"}]],\"className\":\"lucide-shield-check h-5 w-5\",\"aria-hidden\":\"true\"}],\" \",\"PROOF LEDGER / DELIVERY EVIDENCE\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-5 max-w-xl text-4xl font-semibold leading-tight md:text-5xl\",\"children\":\"Not a self-reported skills list, but facts traceable through implementation, tests, and production behavior.\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-black/30\",\"children\":[[\"$\",\"div\",\"Basis\",{\"className\":\"grid gap-3 border-b border-black/30 py-5 sm:grid-cols-[3rem_10rem_1fr] sm:items-start\",\"children\":[[\"$\",\"span\",null,{\"classNam