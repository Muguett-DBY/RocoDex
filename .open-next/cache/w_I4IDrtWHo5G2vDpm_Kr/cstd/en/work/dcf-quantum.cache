assName\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"ROLE\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"Product, Python core, performance, and desktop delivery\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"STATUS\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"Local release\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"TECHNICAL SYSTEM\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"Python · FCFF DCF · Local web UI · PyInstaller · CSV · Hash manifests\"}]]}]]}]]}]}]\na:[\"$\",\"$L26\",null,{\"caseStudy\":{\"publicationStatus\":\"published\",\"revision\":2,\"publishedAt\":\"2026-01-01\",\"updatedAt\":\"2026-08-27\",\"slug\":\"dcf-quantum\",\"projectId\":\"dcf\",\"year\":\"2026\",\"title\":{\"zh\":\"DCF Quantum\",\"en\":\"DCF Quantum\"},\"kicker\":{\"zh\":\"确定性金融计算 / 本地软件\",\"en\":\"Deterministic finance / local software\"},\"summary\":{\"zh\":\"一套能在本机运行的三情景 DCF 筛选器：把数据口径、缓存、运行清单和 Windows 交付放在同一条研究流程里。\",\"en\":\"A local three-scenario DCF screener that keeps data definitions, caching, run manifests, and Windows delivery in one research flow.\"},\"film\":{\"durationSeconds\":108,\"logline\":{\"zh\":\"让全市场估值从黑盒答案变成可复算、可追踪、可交付的研究工具。\",\"en\":\"Turning full-market valuation from a black box into a reproducible, traceable research tool.\"},\"beats\":[{\"id\":\"black-box\",\"phase\":\"problem\",\"title\":{\"zh\":\"估值结论无法复算\",\"en\":\"Valuations could not be reproduced\"},\"detail\":{\"zh\":\"数据版本、假设和运行路径不透明时，再漂亮的价格目标也无法审计。\",\"en\":\"Without visible data versions, assumptions, and run paths, even polished targets cannot be audited.\"},\"signal\":{\"zh\":\"结论必须携带来路\",\"en\":\"Every conclusion needs lineage\"}},{\"id\":\"market-scale\",\"phase\":\"constraint\",\"title\":{\"zh\":\"全市场规模与离线交付\",\"en\":\"Market scale and offline delivery\"},\"detail\":{\"zh\":\"扫描要覆盖大量证券，并在没有 Python 环境的 Windows 电脑上稳定运行。\",\"en\":\"The scan covers a broad security universe and must run on Windows machines without Python.\"},\"signal\":{\"zh\":\"研究内核不能依赖开发环境\",\"en\":\"The research core cannot depend on a dev environment\"}},{\"id\":\"deterministic-core\",\"phase\":\"architecture\",\"title\":{\"zh\":\"确定性公式拥有最终权威\",\"en\":\"Deterministic formulas retain authority\"},\"detail\":{\"zh\":\"三情景 DCF、数据指纹、运行清单和缓存层被拆成可独立验证的阶段。\",\"en\":\"Three-scenario DCF, data fingerprints, run manifests, and caches become independently verifiable stages.\"},\"signal\":{\"zh\":\"AI 解释，不替代计算\",\"en\":\"AI explains; it does not replace calculation\"}},{\"id\":\"real-bottleneck\",\"phase\":\"failure\",\"title\":{\"zh\":\"瓶颈并不在 DCF 数学\",\"en\":\"The bottleneck was not DCF math\"},\"detail\":{\"zh\":\"真实可执行文件剖析把热点定位到重复缓存 JSON 解析与序列化。\",\"en\":\"Profiling the real executable located the hot path in repeated cache JSON parsing and serialization.\"},\"signal\":{\"zh\":\"先测量，再优化\",\"en\":\"Measure before optimizing\"}},{\"id\":\"windows-release\",\"phase\":\"outcome\",\"title\":{\"zh\":\"研究成为可安装产品\",\"en\":\"Research becomes an installable product\"},\"detail\":{\"zh\":\"Windows 安装包、离线缓存和验证脚本把模型交到最终使用环境。\",\"en\":\"A Windows installer, offline cache, and release verifier carry the model into its actual environment.\"},\"signal\":{\"zh\":\"公式、数据与交付同链验收\",\"en\":\"Formula, data, and delivery pass one gate\"}}]},\"role\":{\"zh\":\"产品、Python 内核、性能与桌面交付\",\"en\":\"Product, Python core, performance, and desktop delivery\"},\"image\":{\"src\":\"/cstd-universe/cstd-data-vault-v1.webp\",\"alt\":{\"zh\":\"确定性金融数据计算舱\",\"en\":\"Deterministic finance data chamber\"},\"position\":\"50% 50%\"},\"technologies\":[\"Python\",\"FCFF DCF\",\"Local web UI\",\"PyInstaller\",\"CSV\",\"Hash manifests\"],\"metrics\":[{\"value\":\"3\",\"label\":{\"zh\":\"估值情景\",\"en\":\"valuation scenarios\"}},{\"value\":\"5Y\",\"label\":{\"zh\":\"显性预测期\",\"en\":\"forecast period\"}},{\"value\":\"127.0.0.1\",\"label\":{\"zh\":\"仅本机监听\",\"en\":\"local-only bind\"}}],\"evidence\":[{\"label\":{\"zh\":\"口径\",\"en\":\"Basis\"},\"detail\":{\"zh\":\"PROXY 与 FCFF_BRIDGED_CONFIRMED 从不混称。\",\"en\":\"PROXY and FCFF_BRIDGED_CONFIRMED are never conflated.\"}},{\"label\":{\"zh\":\"输出\",\"en\":\"Outputs\"},\"detail\":{\"zh\":\"候选、拒绝、财务、确认状态与运行清单分文件保存。\",\"en\":\"Candidates, rejections, financials, confirmation status, and manifests are separate artifacts.\"}},{\"label\":{\"zh\":\"安全\",\"en\":\"Safety\"},\"detail\":{\"zh\":\"CSV 外部文本转义，避免电子表格公式注入。\",\"en\":\"External CSV text is escaped to prevent spreadsheet formula injection.\"}}],\"capabilityIds\":[\"research-models\",\"data-systems\"],\"relatedNoteSlugs\":[\"deterministic-core-ai-edge\",\"observable-dcf-pipeline\",\"data-wrangling-as-product-design\",\"chemical-engineering-to-software-systems\"],\"relatedLabSlugs\":[\"data-lens\"],\"artifacts\":[{\"kind\":\"note\",\"label\":{\"zh\":\"AI 放在解释层，公式留在决策层\",\"en\":\"Put AI at the explanation edge, not the decision core\"},\"detail\":{\"zh\":\"从该系统实现中沉淀的技术决策记录。\",\"en\":\"An engineering decision record derived from this system.\"},\"href\":{\"zh\":\"/notes/deterministic-core-ai-edge\",\"en\":\"/en/notes/deterministic-core-ai-edge\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"note\",\"label\":{\"zh\":\"全市场 DCF 扫描为什么先优化缓存 JSON\",\"en\":\"Why a market-wide DCF scan optimized cache JSON first\"},\"detail\":{\"zh\":\"从该系统实现中沉淀的技术决策记录。\",\"en\":\"An engineering decision record derived from this system.\"},\"href\":{\"zh\":\"/notes/observable-dcf-pipeline\",\"en\":\"/en/notes/observable-dcf-pipeline\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"lab\",\"label\":{\"zh\":\"可复现实验 / data-lens\",\"en\":\"Reproducible lab / data-lens\"},\"detail\":{\"zh\":\"在浏览器中重放核心机制。\",\"en\":\"Replay the core mechanism in the browser.\"},\"href\":{\"zh\":\"/lab/data-lens\",\"en\":\"/en/lab/data-lens\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"test\",\"label\":{\"zh\":\"Windows 发布验证器\",\"en\":\"Windows release verifier\"},\"detail\":{\"zh\":\"verify_windows_release.py 校验桌面入口、资源、配置与可执行运行链路。\",\"en\":\"verify_windows_release.py checks the desktop entry point, resources, configuration, and executable path.\"},\"href\":{\"zh\":\"/notes/observable-dcf-pipeline\",\"en\":\"/en/notes/observable-dcf-pipeline\"},\"verifiedAt\":\"2026-07-15\"}],\"toc\":[{\"id\":\"principle\",\"eyebrow\":{\"zh\":\"01 / 原则\",\"en\":\"01 / Principle\"},\"title\":{\"zh\":\"估值必须能被复算。\",\"en\":\"A valuation must be reproducible.\"}},{\"id\":\"audit\",\"eyebrow\":{\"zh\":\"02 / 审计\",\"en\":\"02 / Audit\"},\"title\":{\"zh\":\"每次扫描都有数据血缘。\",\"en\":\"Every scan carries data lineage.\"}},{\"id\":\"desktop\",\"eyebrow\":{\"zh\":\"03 / 交付\",\"en\":\"03 / Delivery\"},\"title\":{\"zh\":\"把研究内核交付给没有 Python 的电脑。\",\"en\":\"Ship the research core to machines without Python.\"}}],\"status\":{\"zh\":\"本地发布\",\"en\":\"Local release\"}},\"locale\":\"en\"}]\nb:[\"$\",\"section\",null,{\"className\":\"border-b border-[#24e0ff]/25 bg-[#06080a] px-5 py-16 md:px-10 lg:px-16 lg:py-24\",\"aria-label\":\"Executable technical replay\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[\"$\",\"$L27\",null,{\"replay\":{\"id\":\"dcf-cache\",\"caseSlug\":\"dcf-quantum\",\"title\":{\"zh\":\"缓存序列化热点\",\"en\":\"Cache serialization hot path\"},\"thesis\":{\"zh\":\"优化重复解析和序列化，而不是改写确定性估值数学。\",\"en\":\"Remove repeated parse and serialization work without rewriting deterministic valuation math.\"},\"inputLabel\":{\"zh\":\"扫描记录\",\"en\":\"Scan records\"},\"inputMin\":100,\"inputMax\":1200,\"inputStep\":100,\"inputDefault\":600,\"unit\":{\"zh\":\"条\",\"en\":\" records\"},\"sourceHref\":{\"zh\":\"/work/dcf-quantum\",\"en\":\"/en/work/dcf-quantum\"}},\"locale\":\"en\",\"compact\":true}]}]}]\nc:[\"$\",\"section\",null,{\"data-cstd-proof-mesh\":true,\"data-cstd-proof-mesh-size\":\"case\",\"aria-labelledby\":\"proof-mesh-dcf-