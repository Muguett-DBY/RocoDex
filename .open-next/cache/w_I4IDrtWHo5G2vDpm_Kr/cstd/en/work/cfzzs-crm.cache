":[\\\"$\\\",\\\"$Le\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$25:props:children:props:children:2:props:children:1:props:children:props:iconNode\\\",\\\"className\\\":\\\"lucide-arrow-right h-5 w-5\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-t border-white/15 py-7 lg:border-t-0 lg:pl-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono text-[11px] font-black text-[#78858a]\\\",\\\"children\\\":[\\\"$L2e\\\",\\\" \\\",\\\"EVIDENCE AND REPRODUCTION\\\"]}],\\\"$L2f\\\"]}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"26:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"bg-[#080a0c]\\\",\\\"children\\\":[null,\\\"\\\\n\\\",[[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"workflow\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"01 / Workflow\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"A CRM is only as good as its trustworthy state.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Leads, contacts, companies, follow-ups, and spatial inventory must cooperate under one permission model. The dashboard is an output; server-side scope is the product skeleton.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"At first the project looked like a large table with room for more fields. The team did not really need more inputs; they needed to know who owned a lead, what came next, and whether a change affected somebody else. I mapped the entities and stage transitions first, then decided what deserved to share a screen.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Deduplication and spatial inventory are the same problem in another form. A matching company name is not proof of identity, and a space cannot be trusted because a front-end color says it is free. Keeping those decisions on the server prevents different cached pages from telling different stories.\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"concurrency\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"02 / Concurrency\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"Optimistic locking protects stage transitions.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"When multiple operators edit the same lead, stale updates are rejected and refreshed instead of silently overwriting field intelligence.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The conflict message has to use business language, not only “save failed”. An operator needs to know what changed and whether a fresh confirmation is enough or an owner needs to be involved. The version belongs in the API; the reason belongs in the interface.\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"delivery\\\",\\\"className\\\":\\\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-mono text-[11px] font-black text-[#f4d431]\\\",\\\"children\\\":\\\"03 / Delivery\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"className\\\":\\\"mt-5 block h-px w-16 bg-[#24e0ff]\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\\\",\\\"children\\\":\\\"Production acceptance follows real role actions.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cstd-mdx-prose cstd-mdx-prose-dark\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"E2E checks more than page availability: login, business and admin routes, user creation, and CSV import are exercised.\\\"}],\\\"$L30\\\"]}]]}]]}]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"27:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"border-b border-[#f4d431]/40 bg-[#f4d431] px-5 py-20 text-[#050709] md:px-10 lg:px-16 lg:py-24\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-[1320px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-8 lg:grid-cols-[0.75fr_1.25fr]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono