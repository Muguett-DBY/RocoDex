:\"3rx089\"}],[\"path\",{\"d\":\"M12 13.5V8\",\"key\":\"1io7kd\"}]],\"className\":\"lucide-boxes h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"CAPABILITY DISTRICTS\"]}],[\"$\",\"div\",null,{\"className\":\"mt-5 border-t border-white/10\",\"children\":[[\"$\",\"div\",\"edge-operations\",{\"className\":\"border-b border-white/10 py-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"EDGE-02\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm font-semibold text-white\",\"children\":\"Edge and operational systems\"}]]}],[\"$\",\"div\",\"product-surfaces\",{\"className\":\"border-b border-white/10 py-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"SURFACE-01\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm font-semibold text-white\",\"children\":\"Product interfaces and user paths\"}]]}],[\"$\",\"div\",\"data-systems\",{\"className\":\"border-b border-white/10 py-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"STREAM-05\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm font-semibold text-white\",\"children\":\"Data flows and computational research\"}]]}]]}]]}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"hidden items-center justify-center border-x border-white/10 text-[#24e0ff] lg:flex\",\"children\":[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]],\"className\":\"lucide-arrow-right h-5 w-5\"}]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 py-7 lg:border-t-0 lg:px-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#78858a]\",\"children\":\"SHIPPED SYSTEM\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 text-2xl font-semibold text-white\",\"children\":\"CFZZS industrial CRM\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm leading-7 text-[#9ca7aa]\",\"children\":\"A lead workbench for an industrial-park team, keeping deduplication, stage changes, spatial inventory, and exports tied to traceable state.\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[11px] font-black text-[#3dff8f]\",\"children\":[\"REV \",2,\" / \",\"VERIFIED\",\" \",\"2026-08-27\"]}]]}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"hidden items-center justify-center border-x border-white/10 text-[#f4d431] lg:flex\",\"children\":[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$25:props:children:props:children:2:props:children:1:props:children:props:iconNode\",\"className\":\"lucide-arrow-right h-5 w-5\"}]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 py-7 lg:border-t-0 lg:pl-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black text-[#78858a]\",\"children\":[\"$L2e\",\" \",\"EVIDENCE AND REPRODUCTION\"]}],\"$L2f\"]}]]}]]}]}]\n26:[\"$\",\"article\",null,{\"className\":\"bg-[#080a0c]\",\"children\":[null,\"\\n\",[[\"$\",\"section\",null,{\"id\":\"workflow\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"01 / Workflow\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"A CRM is only as good as its trustworthy state.\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Leads, contacts, companies, follow-ups, and spatial inventory must cooperate under one permission model. The dashboard is an output; server-side scope is the product skeleton.\"}],[\"$\",\"p\",null,{\"children\":\"At first the project looked like a large table with room for more fields. The team did not really need more inputs; they needed to know who owned a lead, what came next, and whether a change affected somebody else. I mapped the entities and stage transitions first, then decided what deserved to share a screen.\"}],[\"$\",\"p\",null,{\"children\":\"Deduplication and spatial inventory are the same problem in another form. A matching company name is not proof of identity, and a space cannot be trusted because a front-end color says it is free. Keeping those decisions on the server prevents different cached pages from telling different stories.\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"id\":\"concurrency\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"02 / Concurrency\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"Optimistic locking protects stage transitions.\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"When multiple operators edit the same lead, stale updates are rejected and refreshed instead of silently overwriting field intelligence.\"}],[\"$\",\"p\",null,{\"children\":\"The conflict message has to use business language, not only “save failed”. An operator needs to know what changed and whether a fresh confirmation is enough or an owner needs to be involved. The version belongs in the API; the reason belongs in the interface.\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"id\":\"delivery\",\"className\":\"scroll-mt-24 border-b border-white/12 px-5 py-20 md:px-10 lg:px-16 lg:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-[11px] font-black text-[#f4d431]\",\"children\":\"03 / Delivery\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-5 block h-px w-16 bg-[#24e0ff]\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"max-w-4xl text-4xl font-semibold leading-[1.02] text-white md:text-6xl\",\"children\":\"Production acceptance follows real role actions.\"}],[\"$\",\"div\",null,{\"className\":\"cstd-mdx-prose cstd-mdx-prose-dark\",\"children\":[[\"$\",\"p\",null,{\"children\":\"E2E checks more than page availability: login, business and admin routes, user creation, and CSV import are exercised.\"}],\"$L30\"]}]]}]]}]}]]]}]\n27:[\"$\",\"section\",null,{\"className\":\"border-b border-[#f4d431]/40 bg-[#f4d431] px-5 py-20 text-[#050709] md:px-10 lg:px-16 lg:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-8 lg:grid-cols-[0.75fr_1.25fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-[11px] font-black\",\"children\":[[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\",\"key\":\"oel41y\"}],[\"path\",{\"d\":\"m9 12 2 2 4-4\",\"key\":\"dzmm74\"}]],\"className\":\"lucide-shield-check h-5 w-5\",\"aria-hidden\":\"true\"}],\" \",\"PROOF LEDGER / DELIVERY EVIDENCE\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-5 max-w-xl text-4xl font-semibold leading-tight md:text-5xl\",\"children\":\"Not a self-reported skills list, but facts traceable through implementation, tests, and production behavior.\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-black/30\",\"children\":[[\"$\",\"div\",\"Permissions\",{\"className\":\"grid gap-3 border-b border-black/30 py-5 sm:grid-cols-[3rem_10rem_1fr] sm:items-start\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":[\"0\",1]}],[\"$\",\"strong\",null,{\"className\":\"font-mono text-xs\",\"children\":\"Permissions\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-7 text-black/70\",\"children\":\"RBAC and data scope are enforced server-side.\"}]]}],[\"$\",\"div\",\"Integrity\",{\"className\":\"grid gap-3 border-b border-black/30 py-5 sm:grid-cols-[3rem_10rem_1fr] sm:items-start\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":[\"0\",2]}],[\"$\",\"strong\",null,{\"className\":\"font-mono text-xs\",\"children\":\"Integrity\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-7 text-black/70\",\"children\":\"Deduplication, optimistic locking, and approved exports reduce bad data.\"}]]}],[\"$\",\"div\",\"Operations\",{\"className\":\"grid gap-3 border-b border-black/30 py-5 sm:grid-cols-[3rem_10rem_1fr] sm:items-start\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":[\"0\",3]}],[\"$\",\"strong\",null,{\"className\":\"font-mono text-xs\",\"children\":\"Operations\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-7 text-black/70\",\"children\":\"GitHub Actions deploy automatically to Cloudflare Pages.\"}]]}]]}]]}],[\"$\",\"a\",null,{\"href\":\"https