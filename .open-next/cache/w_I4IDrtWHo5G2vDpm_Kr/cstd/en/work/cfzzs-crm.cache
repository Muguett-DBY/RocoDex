 5v14\",\"key\":\"s699le\"}],[\"path\",{\"d\":\"m19 12-7 7-7-7\",\"key\":\"1idqje\"}]],\"className\":\"lucide-arrow-down h-3.5 w-3.5 animate-bounce text-[#f4d431]\"}],\" \",\"SCROLL / CONTINUE TRACE\"]}]\n9:[\"$\",\"section\",null,{\"className\":\"border-b border-white/12 bg-[#f1eee5] text-[#090b0d]\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1540px] gap-10 px-5 py-14 md:px-10 lg:grid-cols-[minmax(18rem,0.75fr)_minmax(0,1.25fr)] lg:px-16 lg:py-20\",\"children\":[[\"$\",\"div\",null,{\"children\":[\"$\",\"$L26\",null,{\"href\":\"/en/work\",\"className\":\"inline-flex items-center gap-2 font-mono text-[11px] font-black text-[#0b5f6d] hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black\",\"children\":[[\"$\",\"$L25\",null,{\"iconNode\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]],\"className\":\"lucide-arrow-left h-4 w-4\",\"aria-hidden\":\"true\"}],\" \",\"All work\"]}]}],[\"$\",\"dl\",null,{\"className\":\"grid gap-6 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"ROLE\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"Requirements, full stack, and production acceptance\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"STATUS\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"Live\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-mono text-[11px] font-black text-black/75\",\"children\":\"TECHNICAL SYSTEM\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-6\",\"children\":\"React 19 · Hono · TanStack Query · D1 · R2 · Playwright\"}]]}]]}]]}]}]\na:[\"$\",\"$L27\",null,{\"caseStudy\":{\"publicationStatus\":\"published\",\"revision\":2,\"publishedAt\":\"2026-01-01\",\"updatedAt\":\"2026-08-27\",\"slug\":\"cfzzs-crm\",\"projectId\":\"crm\",\"year\":\"2026\",\"title\":{\"zh\":\"CFZZS 招商 CRM\",\"en\":\"CFZZS industrial CRM\"},\"kicker\":{\"zh\":\"业务系统 / 权限与并发\",\"en\":\"Operations / permissions and concurrency\"},\"summary\":{\"zh\":\"给产业园区招商团队用的一套线索工作台：从企业查重、阶段推进到空间资源和导出，关键状态都能追溯。\",\"en\":\"A lead workbench for an industrial-park team, keeping deduplication, stage changes, spatial inventory, and exports tied to traceable state.\"},\"film\":{\"durationSeconds\":102,\"logline\":{\"zh\":\"把散落的招商表格变成一条状态可信、多人协作的业务链。\",\"en\":\"Turning scattered business spreadsheets into a trustworthy multi-role operating chain.\"},\"beats\":[{\"id\":\"fragmented-truth\",\"phase\":\"problem\",\"title\":{\"zh\":\"业务真相散落在表格里\",\"en\":\"Business truth was scattered\"},\"detail\":{\"zh\":\"线索、企业、空间与跟进记录彼此脱节，状态无法被团队共同相信。\",\"en\":\"Leads, companies, spaces, and follow-ups were disconnected, so the team could not trust shared state.\"},\"signal\":{\"zh\":\"问题不是缺页面，而是缺一致状态\",\"en\":\"The gap was consistent state, not more screens\"}},{\"id\":\"role-concurrency\",\"phase\":\"constraint\",\"title\":{\"zh\":\"多人同时推进同一条线索\",\"en\":\"Multiple roles, one changing lead\"},\"detail\":{\"zh\":\"销售、招商主管和管理员需要不同权限，也会同时修改阶段与资源。\",\"en\":\"Sales, managers, and administrators need scoped access while changing stages and inventory concurrently.\"},\"signal\":{\"zh\":\"权限与并发必须一起设计\",\"en\":\"Permissions and concurrency are one design problem\"}},{\"id\":\"state-machine\",\"phase\":\"architecture\",\"title\":{\"zh\":\"把流程写成状态机\",\"en\":\"Encode the workflow as state\"},\"detail\":{\"zh\":\"明确阶段转换、查重规则、空间占用与审计事件，让接口与界面共享同一契约。\",\"en\":\"Explicit transitions, deduplication, occupancy, and audit events give APIs and UI one contract.\"},\"signal\":{\"zh\":\"每次流转都可解释\",\"en\":\"Every transition is explainable\"}},{\"id\":\"optimistic-lock\",\"phase\":\"decision\",\"title\":{\"zh\":\"冲突不再静默覆盖\",\"en\":\"Conflicts stop overwriting silently\"},\"detail\":{\"zh\":\"乐观锁在写入前比较版本，冲突回到用户而不是篡改事实。\",\"en\":\"Optimistic locking compares versions before writes and returns conflicts instead of corrupting truth.\"},\"signal\":{\"zh\":\"409 是保护，不是故障\",\"en\":\"A 409 is protection, not failure\"}},{\"id\":\"role-acceptance\",\"phase\":\"evidence\",\"title\":{\"zh\":\"按真实角色验收\",\"en\":\"Acceptance follows real roles\"},\"detail\":{\"zh\":\"浏览器测试覆盖登录、创建、流转、查重、导出和权限边界。\",\"en\":\"Browser tests cover sign-in, creation, transitions, deduplication, exports, and permission boundaries.\"},\"signal\":{\"zh\":\"业务故事完整通过\",\"en\":\"The complete operating story passes\"}}]},\"role\":{\"zh\":\"需求拆解、全栈实现与生产验收\",\"en\":\"Requirements, full stack, and production acceptance\"},\"image\":{\"src\":\"/cstd-projects/crm.png\",\"alt\":{\"zh\":\"CFZZS 招商 CRM 仪表盘\",\"en\":\"CFZZS CRM dashboard\"},\"position\":\"50% 26%\"},\"technologies\":[\"React 19\",\"Hono\",\"TanStack Query\",\"D1\",\"R2\",\"Playwright\"],\"metrics\":[{\"value\":\"5\",\"label\":{\"zh\":\"角色层级\",\"en\":\"role levels\"}},{\"value\":\"RBAC\",\"label\":{\"zh\":\"服务端数据范围\",\"en\":\"server data scopes\"}},{\"value\":\"E2E\",\"label\":{\"zh\":\"关键业务覆盖\",\"en\":\"critical flow coverage\"}}],\"evidence\":[{\"label\":{\"zh\":\"权限\",\"en\":\"Permissions\"},\"detail\":{\"zh\":\"RBAC 与数据范围在服务端执行。\",\"en\":\"RBAC and data scope are enforced server-side.\"}},{\"label\":{\"zh\":\"完整性\",\"en\":\"Integrity\"},\"detail\":{\"zh\":\"企业查重、乐观锁和审批导出减少脏数据。\",\"en\":\"Deduplication, optimistic locking, and approved exports reduce bad data.\"}},{\"label\":{\"zh\":\"运行\",\"en\":\"Operations\"},\"detail\":{\"zh\":\"GitHub Actions 自动部署到 Cloudflare Pages。\",\"en\":\"GitHub Actions deploy automatically to Cloudflare Pages.\"}}],\"capabilityIds\":[\"edge-operations\",\"product-surfaces\",\"data-systems\"],\"relatedNoteSlugs\":[\"optimistic-locking-for-operations\"],\"relatedLabSlugs\":[\"system-trace\"],\"artifacts\":[{\"kind\":\"production\",\"label\":{\"zh\":\"生产系统\",\"en\":\"Production system\"},\"detail\":{\"zh\":\"公开可访问的实际运行界面。\",\"en\":\"The publicly reachable running product.\"},\"href\":{\"zh\":\"https://cfzzs.custard.top\",\"en\":\"https://cfzzs.custard.top\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"note\",\"label\":{\"zh\":\"多人 CRM 里，最后提交不应该自动获胜\",\"en\":\"In a multi-user CRM, last write should not automatically win\"},\"detail\":{\"zh\":\"从该系统实现中沉淀的技术决策记录。\",\"en\":\"An engineering decision record derived from this system.\"},\"href\":{\"zh\":\"/notes/optimistic-locking-for-operations\",\"en\":\"/en/notes/optimistic-locking-for-operations\"},\"verifiedAt\":\"2026-08-09\"},{\"kind\":\"lab\",\"label\":{\"zh\":\"可复现实验 / system-trace\",\"en\":\"Reproducible lab / system-trace\"},\"detail\":{\"zh\":\"在浏览器中重放核心机制。\",\"en\":\"Replay the core mechanism in the browser.\"},\"href\":{\"zh\":\"/lab/system-trace\",\"en\":\"/en/lab/system-trace\"},\"verifiedAt\":\"2026-08-09\"}],\"toc\":[{\"id\":\"workflow\",\"eyebrow\":{\"zh\":\"01 / 工作流\",\"en\":\"01 / Workflow\"},\"title\":{\"zh\":\"CRM 的核心是状态可信，而不是表格数量。\",\"en\":\"A CRM is only as good as its trustworthy state.\"}},{\"id\":\"concurrency\",\"eyebrow\":{\"zh\":\"02 / 并发\",\"en\":\"02 / Concurrency\"},\"title\":{\"zh\":\"阶段流转用乐观锁保护。\",\"en\":\"Optimistic locking protects stage transitions.\"}},{\"id\":\"delivery\",\"eyebrow\":{\"zh\":\"03 / 交付\",\"en\":\"03 / Delivery\"},\"title\":{\"zh\":\"生产验收覆盖真实角色动作。\",\"en\":\"Production acceptance follows real role actions.\"}}],\"status\":{\"zh\":\"线上运行\",\"en\":\"Live\"},\"liveHref\":\"https://cfzzs.custard.top\"},\"locale\":\"en\"}]\nb:[\"$\",\"$L28\",null,{\"dossier\":{\"caseSlug\":\"cfzzs-crm\",\"accent\":\"#f4d431\",\"thesis\":{\"zh\":\"业务系统的可信度来自服务端权限、数据范围和并发冲突都能被明确拒绝。\",\"en\":\"Operational trust comes from explicit server-side rejection of permission, data-scope, and concurrency violations.\"},\"architecture\":[{\"id\":\"identity\",\"type\":\"edge\",\"title\":{\"zh\":\"Request Identity\",\"en\":\"Request Identity\"},\"detail\":{\"zh\":\"每个请求先绑定真实用户和角色上下文。\",\"en\":\"Every request first binds to an authenticated user and role context.\"}},{\"id\":\"rbac\",\"type\":\"contract\",\"title\":{\"zh\":\"RBAC Contract\",\"en\":\"RBAC Contract\"},\"detail\":{\"zh\":\"五级角色权限在服务端校验，不信任隐藏按钮。\",\"en\":\"Five role levels are enforced on the server, never inferred from hidden buttons.\"}},{\"id\":\"scope\",\"type\":\"state\",\"title\":{\"zh\":\"Data Scope\",\"en\":\"Data Scope\"},\"detail\":{\"zh\":\"查询与写入都受组织和角色数据范围约束。\",\"en\":\"Reads and writes are constrained by organizational and role data scope.\"}},{\"id\":\"version\",\"type\":\"state\",\"title\":{\"zh\":\"Optimistic Version\",\"en\":\"Optimistic Version\"},\"detail\":{\"zh\":\"记录版本参与更新条件，旧版本不能静默覆盖新事实。\",\"en\":\"Record versions participate in updates so stale state cannot silently replace newer truth.\"}},{\"id\":\"role-e2e\",\"type\":\"proof\",\"title\":{\"zh\":\"Real-role E2E\",\"en\":\"Real-role E2E\"},\"detail\":{\"zh\":\"真实角色浏览器流程验证权限、范围和 409 冲突。\",\"en\":\"Browser flows with real roles verify authorization, scope, and 409 conflicts.\"}}],\"flows\":[{\"from\":\"identity\",\"to\":\"rbac\",\"label\":{\"zh\":\"解析权限\",\"en\":\"resolve permission\"}},{\"from\":\"rbac\",\"to\":\"scope\",\"label\":{\"zh\":\"约束数据\",\"en\":\"constrain data\"}},{\"from\":\"scope\",\"to\":\"version\",\"label\":{\"zh\":\"条件写入\",\"en\":\"conditional write\"}},{\"from\":\"version\",\"to\":\"role-e2e\",\"label\":{\"zh\":\"验证冲突\",\"en\":\"verify conflict\"}}],\"decisions\":[{\"id\":\"server-rbac\",\"question\":{\"zh\":\"权限由谁负责？\",\"en\":\"Who owns authorization?\"},\"chosen\":{\"zh\":\"服务端 RBAC + 数据范围\",\"en\":\"Server-side RBAC and data scope\"},\"rejected\":{\"zh\":\"前端菜单可见性即权限\",\"en\":\"Treating menu visibility as permission\"},\"rationale\":{\"zh\":\"客户端提示体验，服务端决定事实。\",\"en\":\"The client communicates affordances; the server decides truth.\"},\"proofHref\":{\"zh\":\"/work/cfzzs-crm#architecture\",\"en\":\"/en/work/cfzzs-crm#architecture\"}},{\"id\":\"optimistic-lock\",\"question\":{\"zh\":\"多人编辑如何处理？\",\"en\":\"How should concurrent edits behave?\"},\"chosen\":{\"zh\":\"版本化乐观锁与显式 409\",\"en\":\"Versioned optimistic locking with explicit 409\"},\"rejected\":{\"zh\":\"最后写入者静默获胜\",\"en\":\"Silent last-write-wins\"},\"rationale\":{\"zh\":\"冲突应成为可恢复业务状态，而不是数据损坏。\",\"en\":\"Conflict becomes a recoverable business state instead of data corruption.\"},\"proofHref\":{\"zh\":\"/notes/optimistic-locking-for-operations\",\"en\":\"/en/notes/optimistic-locking-for-operations\"}}],\"failureModes\":[{\"id\":\"stale-edit\",\"trigger\":{\"zh\":\"用户提交过期记录版本\",\"en\":\"A user submits a stale record version\"},\"containment\":{\"zh\":\"条件更新失败并返回 409，保留当前数据库事实。\",\"en\":\"The conditional update fails with 409 and preserves current database truth.\"},\"visibleOutcome\":{\"zh\":\"提示冲突并要求刷新\",\"en\":\"Conflict is surfaced and refresh is required\"},\"proofHref\":{\"zh\":\"/lab/proof-museum\",\"en\":\"/en/lab/proof-museum\"}},{\"id\":\"scope-escape\",\"trigger\":{\"zh\":\"角色请求范围外记录\",\"en\":\"A role requests an out-of-scope record\"},\"containment\":{\"zh\":\"服务端权限与查询范围共同拒绝。\",\"en\":\"Server authorization and query scope reject the request together.\"},\"visibleOutcome\":{\"zh\":\"越权数据不进入响应\",\"en\":\"Unauthorized data never enters the response\"},\"proofHref\":{\"zh\":\"/work/cfzzs-crm#evidence\",\"en\":\"/en/work/cfzzs-crm#evidence\"}}]},\"locale\":\"en\"}]\nc:[\"$\",\"section\",null,{\"className\":\"border-b border-[#24e0ff]/25 bg-[#06080a] px-5 py-16 md:px-10 lg:px-16 lg:py-24\",\"aria-label\":\"Executable technical replay\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px]\",\"children\":[\"$\",\"$L29\",null,{\"replay\":{\"id\":\"crm-lock\",\"caseSlug\":\"cfzzs-crm\",\"title\":{\"zh\":\"业务记录乐观锁\",\"en\":\"Operational optimistic lock\"},\"thesis\":{\"zh\":\"冲突必须显式返回，而不是静默覆盖客服刚刚确认的事实。\",\"en\":\"A conflict must return explicitly instead of silently overwriting a newly confirmed operational fact.\"},\"inputLabel\":{\"zh\":\"并发编辑者\",\"en\":\"Concurrent editors\"},\"inputMin\":2,\"inputMax\":10,\"inputStep\":1,\"inputDefault\":5,\"unit\":{\"zh\":\"人\",\"en\":\" editors\"},\"sourceHref\":{\"zh\":\"/work/cfzzs-crm\",\"en\":\"/en/work/cfzzs-crm\"}},\"locale\":\"en\",\"compact\":true}]}]}]\nd:[\"$\",\"section\",null,{\"data-cstd-proof-mesh\":true,\"data-cstd-proof-mesh-size\":\"case\",\"aria-labelledby\":\"proof-mesh-cfzzs-crm\",\"className\":\"border-y border-white/12 bg-[#050709]/92 px-5 py-10 text-[#f2efe7] backdrop-blur-xl md:px-10 lg:px-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1540px]\",\"children\":[[\"$\",\"header\",null,{\"className\":\"flex flex-wrap items-end justify-between gap-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"flex items-center gap-2 font-mono text-[11px] font-black text-[#3dff8f]\",\"children\":[[\"$\",\"$L25\",null,{\"iconNode\":[[\"path\",{\"d\":\"M4.9 16.1C1 12.2 1 5.8 4.9 1.9\",\"key\":\"s0qx1y\"}],[\"path\",{\"d\":\"M7.8 4.7a6.14 6.14 0 0 0-.8 7.5\",\"key\":\"1idnkw\"}],[\"circle\",{\"cx\":\"12\",\"cy\":\"9\",\"r\":\"2\",\"key\":\"1092wv\"}],[\"path\",{\"d\":\"M16.2 4.8c2 2 2.26 5.11.8 7.47\",\"key\":\"ojru2q\"}],[\"path\",{\"d\":\"M19.1 1.9a9.96 9.96 0 0 1 0 14.1\",\"key\":\"rhi7fg\"}],[\"path\",{\"d\":\"M9.5 18h5\",\"key\":\"mfy3pd\"}],[\"path\",{\"d\":\"m8 22 4-11 4 11\",\"key\":\"25yftu\"}]],\"className\":\"lucide-radio-tower h-4 w-4\",\"aria-hidden\":\"true\"}],\" LIVE PROOF MESH / BUILD-TIME\"]}],[\"$\",\"h2\",null,{\"id\":\"proof-mesh-cfzzs-crm\",\"className\":\"mt-3 text-2xl font-semibold md:text-3xl\",\"children\":\"Not project claims, but a traceable evidence network.\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-5 font-mono text-[11px] font-black text-[#778388]\",\"children\":[[\"$\",\"span\",null,{\"children\":[1,\" NODES\"]}],[\"$\",\"span\",null,{\"children\":[3,\" ARTIFACTS\"]}],[\"$\",\"$L26\",null,{\"href\":\"/en/proof.json\",\"className\":\"inline-flex items-center gap-2 t