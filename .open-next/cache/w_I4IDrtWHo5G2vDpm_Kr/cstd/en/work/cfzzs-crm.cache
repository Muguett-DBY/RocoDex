idth=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-link2 lucide-link-2 h-4 w-4\" aria-hidden=\"true\"><path d=\"M9 17H7A5 5 0 0 1 7 7h2\"></path><path d=\"M15 7h2a5 5 0 1 1 0 10h-2\"></path><line x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"></line></svg></button></div></div></div></div><ol class=\"px-5 py-10 md:px-10 lg:px-12 lg:py-[22svh]\"><li><article data-cstd-film-beat=\"fragmented-truth\" data-cstd-film-beat-index=\"0\" data-cstd-film-beat-active=\"true\" class=\"flex min-h-[42svh] items-center border-t border-white/12 py-10 first:border-t-0 lg:min-h-[48svh]\"><button type=\"button\" aria-pressed=\"true\" class=\"group w-full text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#24e0ff]\"><span class=\"font-mono text-[11px] font-black text-[#87949a]\">01<!-- --> / <!-- -->PROBLEM</span><h3 class=\"mt-4 text-3xl font-semibold leading-tight text-[#a1aaad] transition-colors group-hover:text-white group-aria-pressed:text-white md:text-4xl\">Business truth was scattered</h3><p class=\"mt-5 max-w-xl text-sm leading-7 text-[#7f8b90] md:text-base md:leading-8\">Leads, companies, spaces, and follow-ups were disconnected, so the team could not trust shared state.</p><span class=\"mt-5 block font-mono text-[11px] font-black\" style=\"color:#24e0ff\">SIGNAL / <!-- -->The gap was consistent state, not more screens</span></button></article></li><li><article data-cstd-film-beat=\"role-concurrency\" data-cstd-film-beat-index=\"1\" data-cstd-film-beat-active=\"false\" class=\"flex min-h-[42svh] items-center border-t border-white/12 py-10 first:border-t-0 lg:min-h-[48svh]\"><button type=\"button\" aria-pressed=\"false\" class=\"group w-full text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#24e0ff]\"><span class=\"font-mono text-[11px] font-black text-[#87949a]\">02<!-- --> / <!-- -->CONSTRAINT</span><h3 class=\"mt-4 text-3xl font-semibold leading-tight text-[#a1aaad] transition-colors group-hover:text-white group-aria-pressed:text-white md:text-4xl\">Multiple roles, one changing lead</h3><p class=\"mt-5 max-w-xl text-sm leading-7 text-[#7f8b90] md:text-base md:leading-8\">Sales, managers, and administrators need scoped access while changing stages and inventory concurrently.</p><span class=\"mt-5 block font-mono text-[11px] font-black\" style=\"color:#87949a\">SIGNAL / <!-- -->Permissions and concurrency are one design problem</span></button></article></li><li><article data-cstd-film-beat=\"state-machine\" data-cstd-film-beat-index=\"2\" data-cstd-film-beat-active=\"false\" class=\"flex min-h-[42svh] items-center border-t border-white/12 py-10 first:border-t-0 lg:min-h-[48svh]\"><button type=\"button\" aria-pressed=\"false\" class=\"group w-full text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#24e0ff]\"><span class=\"font-mono text-[11px] font-black text-[#87949a]\">03<!-- --> / <!-- -->ARCHITECTURE</span><h3 class=\"mt-4 text-3xl font-semibold leading-tight text-[#a1aaad] transition-colors group-hover:text-white group-aria-pressed:text-white md:text-4xl\">Encode the workflow as state</h3><p class=\"mt-5 max-w-xl text-sm leading-7 text-[#7f8b90] md:text-base md:leading-8\">Explicit transitions, deduplication, occupancy, and audit events give APIs and UI one contract.</p><span class=\"mt-5 block font-mono text-[11px] font-black\" style=\"color:#87949a\">SIGNAL / <!-- -->Every transition is explainable</span></button></article></li><li><article data-cstd-film-beat=\"optimistic-lock\" data-cstd-film-beat-index=\"3\" data-cstd-film-beat-active=\"false\" class=\"flex min-h-[42svh] items-center border-t border-white/12 py-10 first:border-t-0 lg:min-h-[48svh]\"><button type=\"button\" aria-pressed=\"false\" class=\"group w-full text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#24e0ff]\"><span class=\"font-mono text-[11px] font-black text-[#87949a]\">04<!-- --> / <!-- -->DECISION</span><h3 class=\"mt-4 text-3xl font-semibold leading-tight text-[#a1aaad] transition-colors group-hover:text-white group-aria-pressed:text-white md:text-4xl\">Conflicts stop overwriting silently</h3><p class=\"mt-5 max-w-xl text-sm leading-7 text-[#7f8b90] md:text-base md:leading-8\">Optimistic locking compares versions before writes and returns conflicts instead of corrupting truth.</p><span class=\"mt-5 block font-mono text-[11px] font-black\" style=\"color:#87949a\">SIGNAL / <!-- -->A 409 is protection, not failure</span></button></article></li><li><article data-cstd-film-beat=\"role-acceptance\" data-cstd-film-beat-index=\"4\" data-cstd-film-beat-active=\"false\" class=\"flex min-h-[42svh] items-center border-t border-white/12 py-10 first:border-t-0 lg:min-h-[48svh]\"><button type=\"button\" aria-pressed=\"false\" class=\"group w-full text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#24e0ff]\"><span class=\"font-mono text-[11px] font-black text-[#87949a]\">05<!-- --> / <!-- -->EVIDENCE</span><h3 class=\"mt-4 text-3xl font-semibold leading-tight text-[#a1aaad] transition-colors group-hover:text-white group-aria-pressed:text-white md:text-4xl\">Acceptance follows real roles</h3><p class=\"mt-5 max-w-xl text-sm leading-7 text-[#7f8b90] md:text-base md:leading-8\">Browser tests cover sign-in, creation, transitions, deduplication, exports, and permission boundaries.</p><span class=\"mt-5 block font-mono text-[11px] font-black\" style=\"color:#87949a\">SIGNAL / <!-- -->The complete operating story passes</span></button></article></li></ol></div></section><section id=\"system-dossier\" data-cstd-case-dossier=\"cfzzs-crm\" data-cstd-case-dossier-view=\"architecture\" class=\"relative overflow-hidden border-b border-[#24e0ff]/25 bg-[#050709] px-5 py-20 text-[#f2efe7] md:px-10 lg:px-16 lg:py-28\" aria-labelledby=\"case-dossier-cfzzs-crm\"><img alt=\"An exploded system blueprint split into boundary, state, and proof layers\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-[62%_50%] opacity-45\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/cstd-universe/cstd-case-blueprint-v3.webp\"/><div aria-hidden=\"true\" class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(5,7,9,0.99)_0%,rgba(5,7,9,0.91)_48%,rgba(5,7,9,0.4)_100%)]\"></div><div aria-hidden=\"true\" class=\"absolute inset-0 bg-[linear-gradient(0deg,rgba(5,7,9,0.97),transparent_54%,rgba(5,7,9,0.7))]\"></div><div class=\"relative mx-auto max-w-[1320px]\"><header class=\"grid gap-8 lg:grid-cols-[minmax(0,1fr)_26rem] lg:items-end\"><div><p class=\"font-mono text-[11px] font-black\" style=\"color:#f4d431\">SYSTEM DOSSIER / ENGINEERING RECORD</p><h2 id=\"case-dossier-cfzzs-crm\" class=\"mt-5 max-w-4xl text-4xl font-semibold leading-[0.95] md:text-6xl\">Architecture decisions and failure boundaries, brought to the foreground.</h2></div><p class=\"border-l border-white/20 pl-5 text-base leading-8 text-[#b5bec1]\">Operational trust comes from explicit server-side rejection of permission, data-scope, and concurrency violations.</p></header><div class=\"mt-12 border-y border-white/15 bg-[#050709]/75 backdrop-blur-lg\"><div role=\"tablist\" aria-label=\"System dossier views\" class=\"grid border-b border-white/15 sm:grid-cols-3\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" data-cstd-dossier-tab=\"architecture\" class=\"flex min-h-14 items-center justify-between gap-4 border-b border-white/15 px-4 font-mono text-[11px] font-black text-[#8f9a9e] transition-[background-color,color] last:border-b-0 hover:text-white aria-selected:bg-[#f4d431] aria-selected:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-[#24e0ff] sm:border-b-0 sm:border-r sm:last:border-r-0\"><span>Architecture</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network h-4 w-4\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-cstd-dossier-tab=\"decisions\" class=\"flex min-h-14 items-center justify-between gap-4 border-b border-white/15 px-4 font-mono text-[11px] font-black text-[#8f9a9e] transition-[background-color,color] last:border-b-0 hover:text-white aria-selected:bg-[#f4d431] aria-selected:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-[#24e0ff] sm:border-b-0 sm:border-r sm:last:border-r-0\"><span>Tradeoffs</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-git-compare-arrows h-4 w-4\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"6\" r=\"3\"></circle><path d=\"M12 6h5a2 2 0 0 1 2 2v7\"></path><path d=\"m15 9-3-3 3-3\"></path><circle cx=\"19\" cy=\"18\" r=\"3\"></circle><path d=\"M12 18H7a2 2 0 0 1-2-2V9\"></path><path d=\"m9 15 3 3-3 3\"></path></svg></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-cstd-dossier-tab=\"failures\" class=\"flex min-h-14 items-center justify-between gap-4 border-b border-white/15 px-4 font-mono text-[11px] font-black text-[#8f9a9e] transition-[background-color,color] last:border-b