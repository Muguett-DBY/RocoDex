url\":\"https://custard.top/en/work/cfzzs-crm\",\"image\":\"https://custard.top/cstd-projects/crm.png\",\"programmingLanguage\":[\"React 19\",\"Hono\",\"TanStack Query\",\"D1\",\"R2\",\"Playwright\"],\"runtimePlatform\":\"Live\",\"keywords\":[\"edge-operations\",\"product-surfaces\",\"data-systems\"],\"creator\":{\"@type\":\"Person\",\"name\":\"Custard\"},\"about\":[{\"@type\":\"Thing\",\"name\":\"Request Identity\",\"description\":\"Every request first binds to an authenticated user and role context.\"},{\"@type\":\"Thing\",\"name\":\"RBAC Contract\",\"description\":\"Five role levels are enforced on the server, never inferred from hidden buttons.\"},{\"@type\":\"Thing\",\"name\":\"Data Scope\",\"description\":\"Reads and writes are constrained by organizational and role data scope.\"},{\"@type\":\"Thing\",\"name\":\"Optimistic Version\",\"description\":\"Record versions participate in updates so stale state cannot silently replace newer truth.\"},{\"@type\":\"Thing\",\"name\":\"Real-role E2E\",\"description\":\"Browser flows with real roles verify authorization, scope, and 409 conflicts.\"}]},{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Work\",\"item\":\"https://custard.top/en/work\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"CFZZS industrial CRM\",\"item\":\"https://custard.top/en/work/cfzzs-crm\"}]}]29:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$31\"}}]\n2e:[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M9 17H7A5 5 0 0 1 7 7h2\",\"key\":\"8i5ue5\"}],[\"path\",{\"d\":\"M15 7h2a5 5 0 1 1 0 10h-2\",\"key\":\"1b9ql8\"}],[\"line\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"12\",\"y2\":\"12\",\"key\":\"1jonct\"}]],\"className\":\"lucide-link2 lucide-link-2 h-4 w-4\",\"aria-hidden\":\"true\"}]\n2f:[\"$\",\"div\",null,{\"className\":\"mt-5 border-t border-white/10\",\"children\":[[[\"$\",\"a\"