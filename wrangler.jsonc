{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "custard-web-platform",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "custard.top",
      "custom_domain": true
    },
    {
      "pattern": "www.custard.top",
      "custom_domain": true
    }
  ]
}
